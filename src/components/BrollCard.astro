---
/**
 * B-roll video tile for the USED stock listings page.
 *
 * Sub-line: pass `showPrice` to swap the brand+year for the van's price -
 * used on /stock so the card shows "$price · Stock #" (per Kyle 16 Jul).
 * Without it the tile shows brand + year + last 4 of stock# (the /new tiles).
 * No sound, no text overlay. Tile clicks through to /stock/[slug] spec page.
 *
 * Media priority: brollVideoFile (self-hosted MP4, zero YouTube chrome) wins
 * over brollVideoUrl (YouTube iframe - shows title/logo, and a play button
 * when mobile blocks autoplay). Falls back to mainImage so the tile still
 * renders when neither is set.
 */
import { sanityImage, youtubeId } from '../lib/sanity.js'

const { caravan: c, showPrice = false } = Astro.props
const slugStr = typeof c.slug === 'string' ? c.slug : c.slug?.current
// "Coming soon" placeholder tiles (grid fillers) have no real spec page, so
// they render WITHOUT an href - non-clickable, never a dead /stock/placeholder.
const href = (slugStr && !c._isPlaceholder) ? `/stock/${slugStr}` : undefined

const fileUrl = c.brollVideoFileUrl || null
const vid = youtubeId(c.brollVideoUrl)
const stockNo = c.compliance?.stockNumber || ''
const stockTail = stockNo.slice(-4)
const year = c.specs?.year
const modelLine = [c.brand, year].filter(Boolean).join(' ')
// On /stock the lead line is the price (the thing shoppers scan for); a van
// with no set price shows "POA" rather than a broken "$". Elsewhere (/new)
// the lead line stays brand + year.
const priceNum = Number(c.price)
const priceLabel = Number.isFinite(priceNum) && priceNum > 0
  ? `$${priceNum.toLocaleString('en-AU')}`
  : 'POA'
const leadText = showPrice ? priceLabel : modelLine
---

<a href={href} class="broll-card" data-brand={c.brand || ''}>
  <div class="broll-media">
    {fileUrl ? (
      <video
        src={fileUrl}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
        controlslist="nodownload nofullscreen noremoteplayback"
        tabindex="-1"
      ></video>
    ) : vid ? (
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${vid}?autoplay=1&mute=1&loop=1&playlist=${vid}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0`}
        title={c.title}
        frameborder="0"
        allow="autoplay; encrypted-media"
        allowfullscreen="false"
        tabindex="-1"
        inert
        loading="lazy"
      ></iframe>
    ) : c.mainImage ? (
      <img
        src={sanityImage(c.mainImage, { w: 640 })}
        alt={c.title}
        loading="lazy"
      />
    ) : (
      <div class="broll-noimg">No video yet</div>
    )}
    <div class="broll-block" aria-hidden="true"></div>
  </div>
  <div class="broll-meta">
    <div class="broll-title">{c.title}</div>
    {(leadText || stockTail) && (
      <div class="broll-sub">
        {leadText && <span class={showPrice ? 'broll-lead broll-price' : 'broll-lead'}>{leadText}</span>}
        {leadText && stockTail && <span class="broll-dot">·</span>}
        {stockTail && <span>Stock #{stockTail}</span>}
      </div>
    )}
  </div>
</a>

<style>
  .broll-card {
    display: block;
    background: #fff;
    border: 1px solid var(--tan-border, #DCCBA8);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .broll-card:hover {
    transform: translateY(-3px);
    border-color: var(--rust, #C0341A);
    box-shadow: 0 10px 28px rgba(42,22,8,0.14);
  }
  .broll-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #1a1a1c;
    overflow: hidden;
  }
  .broll-media iframe,
  .broll-media video,
  .broll-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .broll-block {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: transparent;
    pointer-events: auto;
  }
  .broll-noimg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
  }
  .broll-meta {
    padding: 14px 16px 16px;
  }
  .broll-title {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 700;
    color: var(--ink, #2A1608);
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .broll-sub {
    margin-top: 4px;
    color: var(--muted, #8B6A40);
    font-size: 0.85rem;
  }
  /* Price is the key scan-target on /stock - give it ink weight so it reads
     as the headline figure rather than a muted caption. */
  .broll-price {
    color: var(--ink, #2A1608);
    font-weight: 700;
  }
  .broll-dot {
    margin: 0 6px;
    opacity: 0.5;
  }
</style>
