---
/**
 * Stylised 3-peak mountain icon, matching the SEQ logo silhouette.
 *
 * Per Shane: each home page banner gets a mountain in a different colour
 * (yellow / orange / green - the SEQ logo colours).
 *
 * Props:
 *   color   - hex string for the fill (e.g. '#F5B544' yellow)
 *   size    - pixel size (default 64)
 *   accent  - secondary colour for the back peak (defaults to a tinted shade)
 */
const { color = '#4cea89', size = 64, accent = null } = Astro.props
const back = accent || color
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  style="display:block;"
>
  <!-- back peak -->
  <polygon points="6,52 22,22 38,52" fill={back} opacity="0.65" />
  <!-- mid peak (tallest) -->
  <polygon points="14,52 34,12 54,52" fill={color} />
  <!-- front peak -->
  <polygon points="32,52 46,28 60,52" fill={color} opacity="0.85" />
  <!-- snow caps -->
  <polygon points="29,22 34,12 39,22 36,22 34,18 32,22" fill="#fff" opacity="0.85" />
  <polygon points="44,34 46,28 48,34 47,34 46,32 45,34" fill="#fff" opacity="0.7" />
</svg>
