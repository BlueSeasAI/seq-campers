---
/**
 * Reserve Your Slot CTA - the primary call to action across the site.
 *
 * Tesla-style framing. The job of every page is to drive showroom visits.
 * Used in:
 *   - Inline buttons (variant="inline" or "primary")
 *   - Dark band on most pages (variant="band")
 *   - Sticky mobile nav (variant="sticky")
 *
 * Always links to /reserve - the dedicated, low-friction booking page.
 */
const { variant = 'primary', label = 'Reserve your slot' } = Astro.props
---

{variant === 'band' && (
  <section class="reserve-band-v2">
    <div class="container reserve-band-inner">
      <div class="reserve-band-text">
        <h2 class="reserve-band-h2">Come and see one in person on the Sunshine Coast.</h2>
        <p class="reserve-band-sub">Reserve a one-hour slot with Shane or Maud in Marcoola - no payment, no pressure.</p>
      </div>
      <a href="/reserve" class="btn-primary reserve-btn">{label} →</a>
    </div>
  </section>
)}

{variant === 'inline' && (
  <a href="/reserve" class="btn-primary reserve-btn">{label} →</a>
)}

{variant === 'ghost' && (
  <a href="/reserve" class="btn-ghost reserve-btn-ghost">{label}</a>
)}

<style>
  /* Reserve band v2 - rust-coloured CTA strip that sits FLUSH against the
     dark footer beneath it. Per Bart 16 Jun: change the colour + remove
     the slither of white between band and footer. The rust colour makes
     this its own distinct CTA section (not part of the footer) while the
     0 bottom margin means no gap. Visitor sees: cream content -> rust
     CTA strip -> dark footer with NO wasted space between any of them. */
  .reserve-band-v2 {
    background: linear-gradient(135deg, #C0341A 0%, #8B2410 100%);
    padding: 18px 0;
    margin: 56px 0 0;
    border: 0;
  }
  /* Force the next element (footer) flush against this band. */
  :global(.reserve-band-v2 + .site-footer) {
    margin-top: 0 !important;
  }
  .reserve-band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .reserve-band-text { flex: 1; min-width: 260px; }
  .reserve-band-h2 {
    font-family: 'Inter Tight', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .reserve-band-sub {
    color: rgba(255,255,255,0.88);
    font-size: 0.92rem;
    margin: 0;
    line-height: 1.4;
  }
  @media (max-width: 640px) {
    .reserve-band-inner { flex-direction: column; text-align: center; gap: 14px; }
    .reserve-band-text { min-width: 0; }
  }
  /* Button sits on the rust band so we invert it - cream background, rust text. */
  .reserve-btn {
    background: #fff;
    color: var(--rust, #C0341A) !important;
    box-shadow: 0 6px 18px rgba(0,0,0,0.18);
    white-space: nowrap;
    font-weight: 700;
  }
  .reserve-btn:hover {
    background: var(--sand, #F4EDE0);
    transform: translateY(-1px);
  }
</style>
