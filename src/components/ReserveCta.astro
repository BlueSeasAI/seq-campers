---
/**
 * Reserve Your Slot CTA - the primary call to action across the site.
 *
 * Tesla-style framing. The job of every page is to drive showroom visits.
 * Used in:
 *   - Inline buttons (variant="inline" or "primary")
 *   - Dark band on most pages (variant="band")
 *   - Sticky mobile nav (variant="sticky")
 *
 * Always links to /reserve - the dedicated, low-friction booking page.
 */
const { variant = 'primary', label = 'Reserve your slot' } = Astro.props
---

{variant === 'band' && (
  <section class="band-dark reserve-band">
    <div class="container reserve-band-inner">
      <div class="reserve-band-text">
        <h2 class="reserve-band-h2">Come and see one in person on the Sunshine Coast.</h2>
        <p class="reserve-band-sub">Reserve a one-hour slot with Shane or Maud in Marcoola - no payment, no pressure.</p>
      </div>
      <a href="/reserve" class="btn-primary reserve-btn">{label} →</a>
    </div>
  </section>
)}

{variant === 'inline' && (
  <a href="/reserve" class="btn-primary reserve-btn">{label} →</a>
)}

{variant === 'ghost' && (
  <a href="/reserve" class="btn-ghost reserve-btn-ghost">{label}</a>
)}

<style>
  /* Reserve band - much thinner than the default .band-dark per Bart 16 Jun.
     Horizontal layout (text left, button right) on desktop so we don't waste
     vertical space. Stacks on mobile. Top margin to give breathing room
     between the YouTube subscribe bar and this band. */
  :global(.band-dark.reserve-band) {
    padding: 20px 0 !important;
    margin-top: 56px;
  }
  .reserve-band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .reserve-band-text { flex: 1; min-width: 260px; }
  .reserve-band-h2 {
    font-family: 'Inter Tight', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--sand);
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .reserve-band-sub {
    color: var(--gold);
    font-size: 0.92rem;
    margin: 0;
    line-height: 1.4;
  }
  @media (max-width: 640px) {
    .reserve-band-inner { flex-direction: column; text-align: center; gap: 14px; }
    .reserve-band-text { min-width: 0; }
  }
  .reserve-btn {
    background: var(--rust, #C0341A);
    color: #fff;
    box-shadow: 0 6px 18px rgba(192,52,26,0.35);
    white-space: nowrap;
  }
  .reserve-btn:hover {
    background: #A52910;
    transform: translateY(-1px);
  }
</style>
