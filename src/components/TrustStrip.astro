---
const { variant = 'light' } = Astro.props
---

<div class={`trust-strip trust-strip-${variant}`} role="region" aria-label="Dealer credentials">
  <div class="container">
    <div class="trust-strip-inner">
      <!-- AU badge - image is self-contained (already has "Australian Designed
           & Built" text baked in), so no duplicate text label here. -->
      <span class="trust-item trust-item-aus" title="Australian Designed and Built since 1996">
        <img
          class="trust-aus-icon"
          src="/au-built-badge.png"
          alt="Australian Designed and Built, est. 1996"
          width="200"
          height="200"
          loading="lazy"
        />
      </span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        <span class="trust-item-label">Authorised Kimberley Campers Dealer</span>
      </span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        <span class="trust-item-label">Authorised Stockman Products Dealer</span>
      </span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        <span class="trust-item-label">Off-road camping since 2013</span>
      </span>
    </div>
  </div>
</div>
