---
const { variant = 'light' } = Astro.props
---

<div class={`trust-strip trust-strip-${variant}`} role="region" aria-label="Dealer credentials">
  <div class="container">
    <div class="trust-strip-inner">
      <span class="trust-item trust-item-aus">
        <img
          class="trust-aus-icon"
          src="/au-built-badge.png"
          alt="Australian Designed and Built, est. 1996"
          width="200"
          height="200"
          loading="lazy"
        />
        <span class="trust-item-label">Australian Designed & Built</span>
      </span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        <span class="trust-item-label">Authorised Kimberley Kampers Dealer</span>
      </span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        <span class="trust-item-label">Authorised Stockman Dealer</span>
      </span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        <span class="trust-item-label">30 years on the Sunshine Coast</span>
      </span>
    </div>
  </div>
</div>
