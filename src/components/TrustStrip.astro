---
const { variant = 'light' } = Astro.props
---

<div class={`trust-strip trust-strip-${variant}`} role="region" aria-label="Dealer credentials">
  <div class="container">
    <div class="trust-strip-inner">
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        Authorised Kimberley Kampers Dealer
      </span>
      <span class="trust-divider" aria-hidden="true"></span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        Authorised Stockman Dealer
      </span>
      <span class="trust-divider" aria-hidden="true"></span>
      <span class="trust-item trust-item-aus">
        <img
          class="trust-aus-icon"
          src="/au-built-badge.png"
          alt="Australian Designed and Built, est. 1996"
          width="200"
          height="200"
          loading="lazy"
        />
        Australian Designed & Built
      </span>
      <span class="trust-divider" aria-hidden="true"></span>
      <span class="trust-item">
        <span class="trust-tick" aria-hidden="true">✓</span>
        30 years on the Sunshine Coast
      </span>
    </div>
  </div>
</div>
