---
/**
 * YouTube Subscribe CTA - the secondary call to action.
 *
 * Direct link to the @seqcampers9450 channel with sub_confirmation=1 so the
 * subscribe modal opens immediately. Opens in a new tab so the visitor never
 * leaves the SEQ site. (YouTube does not allow in-page subscribe - their
 * frame-ancestors policy blocks iframe embeds of the subscribe flow.)
 */
const channelUrl =
  'https://www.youtube.com/@seqcampers9450?sub_confirmation=1'
const { variant = 'bar', headline, sub } = Astro.props
const defaultHeadline = 'Watch our latest walkthrough'
const defaultSub = 'New off-road video every fortnight. Join 2,000+ subscribers.'
---

{variant === 'bar' && (
  <div class="container" style="margin-top:32px;">
    <div class="youtube-cta-bar">
      <div class="youtube-cta-text">
        <div class="page-eyebrow" style="color:var(--rust); margin-bottom:6px;">YouTube</div>
        <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.3rem; font-weight:600; color:var(--ink); margin-bottom:4px;">
          {headline || defaultHeadline}
        </h2>
        <p style="color:var(--muted); font-size:0.92rem;">
          {sub || defaultSub}
        </p>
      </div>
      <div class="youtube-cta-buttons">
        <a
          href={channelUrl}
          target="_blank"
          rel="noopener"
          class="btn-primary youtube-btn-subscribe"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" style="vertical-align:-3px; margin-right:6px;">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12l-6.272 3.568z"/>
          </svg>
          Subscribe on YouTube
        </a>
        <a
          href="https://www.youtube.com/@seqcampers9450/videos"
          target="_blank"
          rel="noopener"
          class="btn-ghost youtube-btn-watch"
        >
          See all videos →
        </a>
      </div>
    </div>
  </div>
)}

{variant === 'inline' && (
  <a
    href={channelUrl}
    target="_blank"
    rel="noopener"
    class="btn-primary youtube-btn-subscribe youtube-btn-inline"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" style="vertical-align:-3px; margin-right:6px;">
      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12l-6.272 3.568z"/>
    </svg>
    Subscribe on YouTube
  </a>
)}

{variant === 'footer' && (
  <a
    href={channelUrl}
    target="_blank"
    rel="noopener"
    style="display:inline-flex; align-items:center; gap:8px; color:#fff; opacity:0.9; text-decoration:none; font-size:0.95rem; font-weight:500;"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="#FF0000" aria-hidden="true">
      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12l-6.272 3.568z"/>
    </svg>
    Subscribe on YouTube
  </a>
)}
