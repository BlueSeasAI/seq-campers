---
import Site from '../../layouts/Site.astro'
import { getAllCaravanPaths, getCaravan, sanityImage, sanitySrcset, conditionLabel, portableTextToHtml } from '../../lib/sanity.js'

// Phase 1 (Brisbane Show 2026): in-page React configurator removed. The
// "Build your spec" CTA now routes to /quote/{brand} - dedicated brand-aware
// quote enquiry pages that email sales@seqcampers.com.au. The React
// Configurator.jsx component is kept in the codebase for Phase 2 when we
// rebuild a Tesla-style cascading configurator inside the listing page.

export async function getStaticPaths() {
  const caravans = await getAllCaravanPaths()
  return caravans.map((c) => ({ params: { slug: c.slug } }))
}

const { slug } = Astro.params
const caravan = await getCaravan(slug)

if (!caravan) return Astro.redirect('/stock')

const videos = caravan.videos ?? []
const videoCount = Math.min(videos.length, 3)

function youtubeId(url) {
  const m = String(url ?? '').match(/(?:v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([A-Za-z0-9_-]{11})/)
  return m ? m[1] : null
}

function youtubeEmbed(url) {
  // Listing detail page videos: standard YouTube embed with controls so the
  // user can press play and hear the audio. No autoplay - we don't want
  // multiple videos shouting at the visitor when the page loads.
  const id = youtubeId(url)
  if (!id) return null
  const params = new URLSearchParams({
    modestbranding: '1',
    rel: '0',
    iv_load_policy: '3',
    playsinline: '1',
  })
  return `https://www.youtube.com/embed/${id}?${params.toString()}`
}

// Build a meta description from structured data
const specsBits = []
if (caravan.specs?.sleeps) specsBits.push(`sleeps ${caravan.specs.sleeps}`)
if (caravan.specs?.length) specsBits.push(`${caravan.specs.length}m`)
if (caravan.specs?.tareWeight) specsBits.push(`${caravan.specs.tareWeight}kg tare`)
const specsLine = specsBits.length ? ' - ' + specsBits.join(', ') + '.' : '.'
const priceLine = caravan.price ? ` Priced at $${caravan.price.toLocaleString('en-AU')} AUD.` : ''
const brandLine = caravan.brand ? ` ${caravan.brand}.` : ''
const metaDescription = `${caravan.title} for sale at SEQ Campers in Queensland.${brandLine}${specsLine}${priceLine} Inspections welcome - call (07) 5370 7933.`

const ogImage = caravan.photos?.[0] ?? null

// Canonical site base URL used by Schema.org JSON-LD blocks below
const siteBase = (Astro.site ?? new URL('https://seqcampers.com.au')).href.replace(/\/$/, '')

// Description is Portable Text (rich text blocks). Render to clean HTML.
const descriptionHtml = portableTextToHtml(caravan.description)

// FAQs - use per-caravan custom FAQs from Sanity if present, otherwise
// generate a smart default set from the caravan's structured data.
const defaultFaqs = [
  {
    q: `Is the ${caravan.title} suitable for off-road touring?`,
    a: `Yes. The ${caravan.title} is an off-road caravan built for Australian conditions${caravan.brand ? ` by ${caravan.brand}` : ''}. It handles corrugations, river crossings and outback tracks. We test and inspect every caravan on the lot before listing.`,
  },
  {
    q: `Can I inspect the ${caravan.title} before buying?`,
    a: `Absolutely. We strongly encourage on-site inspection at SEQ Campers in Queensland. Call (07) 5370 7933 or email office@seqcampers.com.au to book a time. Shane personally walks every buyer through the van.`,
  },
  {
    q: `Does the listed price include on-road costs and registration?`,
    a: `The listed price is the caravan only. On-road costs (registration transfer, stamp duty, delivery) are confirmed in writing as part of your formal quote. Use the "Build your spec" tool on this page to send through your selections.`,
  },
  ...(caravan.specs?.atm
    ? [{
        q: `What can I tow the ${caravan.title} with?`,
        a: `Check the ATM (maximum loaded weight) against your tow vehicle's tow rating. The ${caravan.title} has an ATM of ${caravan.specs.atm}kg${caravan.specs.tareWeight ? ` and tare of ${caravan.specs.tareWeight}kg` : ''}. A dual-cab ute or 4WD wagon with at least ${Math.ceil(caravan.specs.atm / 1000) * 1000}kg tow rating is typically required.`,
      }]
    : []),
  {
    q: `Does SEQ Campers accept trade-ins?`,
    a: `Yes. SEQ Campers accepts trade-ins on most caravans. Send photos and details of your current van with your enquiry and we will come back with a trade-in valuation as part of the quote.`,
  },
]
const caravanFaqs = caravan.faqs?.length ? caravan.faqs : defaultFaqs
const faqIsCustom = caravan.faqs?.length > 0

// BreadcrumbList schema for AI search hierarchy signal
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Caravans for Sale', item: `${siteBase}/stock` },
    { '@type': 'ListItem', position: 3, name: caravan.title, item: `${siteBase}/stock/${slug}` },
  ],
}

// FAQPage schema (lets AI quote answers verbatim)
const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: caravanFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

// Authorised Dealer mini-badge - only show for Kimberley or Stockman stock
const brandLower = (caravan.brand ?? '').toLowerCase()
const authorisedDealerLabel = brandLower.includes('kimberley')
  ? 'Authorised Kimberley Kampers Dealer'
  : brandLower.includes('stockman')
    ? 'Authorised Stockman Products Dealer'
    : null

// Per-listing enquiry form data. Each listing posts to Netlify Forms via the
// shared "listing-enquiry" form name with the caravan's Sanity-loaded
// details prefilled as hidden fields. NO routing to Maud's brand pages -
// those are for new-build spec configuration; this is for THIS specific
// caravan with its specs already known from Sanity.
const listingPageUrl = `${siteBase}/stock/${slug}`

// Battery type pretty label
const batteryTypeLabel = {
  lithium: 'Lithium (LiFePO4)',
  agm: 'AGM',
  gel: 'Gel',
  'lead-acid': 'Lead Acid',
  mixed: 'Mixed',
}[caravan.power?.batteryType] || null

// Schema.org Product JSON-LD for AEO / AI search visibility (siteBase declared above)
const availabilityMap = {
  'for-sale': 'https://schema.org/InStock',
  'sold': 'https://schema.org/SoldOut',
  'on-hold': 'https://schema.org/LimitedAvailability',
  'coming-soon': 'https://schema.org/PreOrder',
}
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: caravan.title,
  ...(caravan.brand && { brand: { '@type': 'Brand', name: caravan.brand } }),
  ...(caravan.photos?.length && { image: caravan.photos }),
  description: metaDescription,
  category: 'Off-road caravan',
  ...(caravan.price && {
    offers: {
      '@type': 'Offer',
      url: `${siteBase}/stock/${slug}`,
      priceCurrency: 'AUD',
      price: caravan.price,
      availability: availabilityMap[caravan.status] ?? 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/UsedCondition',
      seller: {
        '@type': 'AutoDealer',
        name: 'SEQ Campers',
        telephone: '+61-7-5370-7933',
        areaServed: 'Queensland, Australia',
      },
    },
  }),
  additionalProperty: [
    caravan.specs?.year && { '@type': 'PropertyValue', name: 'Year', value: caravan.specs.year },
    caravan.specs?.sleeps && { '@type': 'PropertyValue', name: 'Sleeps', value: caravan.specs.sleeps },
    caravan.specs?.length && { '@type': 'PropertyValue', name: 'Length (m)', value: caravan.specs.length },
    caravan.specs?.tareWeight && { '@type': 'PropertyValue', name: 'Tare weight (kg)', value: caravan.specs.tareWeight },
    caravan.specs?.atm && { '@type': 'PropertyValue', name: 'ATM (kg)', value: caravan.specs.atm },
    caravan.specs?.payload && { '@type': 'PropertyValue', name: 'Payload (kg)', value: caravan.specs.payload },
    caravan.specs?.ballWeight && { '@type': 'PropertyValue', name: 'Ball weight (kg)', value: caravan.specs.ballWeight },
    caravan.compliance?.registrationState && { '@type': 'PropertyValue', name: 'Registration state', value: caravan.compliance.registrationState },
    batteryTypeLabel && { '@type': 'PropertyValue', name: 'Battery type', value: batteryTypeLabel },
    caravan.power?.batteryCapacityAh && { '@type': 'PropertyValue', name: 'Battery capacity (Ah)', value: caravan.power.batteryCapacityAh },
    caravan.power?.solarWatts && { '@type': 'PropertyValue', name: 'Solar (W)', value: caravan.power.solarWatts },
    caravan.power?.inverterWatts && { '@type': 'PropertyValue', name: 'Inverter (W)', value: caravan.power.inverterWatts },
  ].filter(Boolean),
  ...(caravan.compliance?.vin && { vehicleIdentificationNumber: caravan.compliance.vin }),
}
---

<Site title={caravan.title} description={metaDescription} ogImage={ogImage} ogType="product">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqPageSchema)} />
  <div class="page-header">
    <div class="container">
      {caravan.brand && <div style="font-size:0.8rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:var(--sand); margin-bottom:8px;">{caravan.brand}</div>}
      <h1>{caravan.title}</h1>
    </div>
  </div>

  <div class="container">
    <div class="listing-grid">

      <!-- Left: photos + description + videos -->
      <div>
        {caravan.photos?.length > 0 && (
          <div class="photo-gallery">
            {caravan.photos.slice(0, 5).map((url, i) => (
              <img
                src={sanityImage(url, { w: i === 0 ? 1200 : 600 })}
                srcset={sanitySrcset(url, i === 0 ? [640, 960, 1200, 1600] : [320, 480, 640])}
                sizes={i === 0 ? '(max-width: 1024px) 100vw, 65vw' : '(max-width: 1024px) 50vw, 32vw'}
                alt={`${caravan.title} photo ${i + 1}`}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
          </div>
        )}

        {/* Videos moved up here so they sit alongside photos as the primary visual story */}
        {videoCount > 0 ? (
          <div style="margin-top:24px;">
            <div class="page-eyebrow" style="color:var(--rust); margin-bottom:8px;">Walkaround</div>
            <h2 style="font-size:1.1rem; font-weight:700; margin-bottom:14px;">See it in motion</h2>
            <div class={`video-grid videos-${videoCount}`}>
              {videos.slice(0, 3).map((v) => {
                const embedUrl = youtubeEmbed(v.url)
                return embedUrl ? (
                  <div class="video-embed">
                    <iframe src={embedUrl} title={v.label ?? caravan.title} allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  </div>
                ) : null
              })}
            </div>
          </div>
        ) : (
          <div style="margin-top:24px; background:var(--sand-deep); border:1px dashed var(--tan-border); border-radius:var(--radius); padding:20px 24px; text-align:center;">
            <div class="page-eyebrow" style="color:var(--muted); margin-bottom:6px;">Walkaround video</div>
            <p style="color:var(--muted); font-size:0.92rem; line-height:1.5;">
              Shane is filming a B-roll walkthrough of this caravan - it will appear here as soon as it is ready.
              Want to see it sooner? <a href="/contact" style="color:var(--rust); font-weight:600;">Book a private walkthrough</a>.
            </p>
          </div>
        )}

        {descriptionHtml && (
          <div style="margin-top:32px;">
            <h2 style="font-size:1.1rem; font-weight:700; margin-bottom:12px;">About this caravan</h2>
            <div class="rich-text" set:html={descriptionHtml} />
          </div>
        )}

        {caravan.tripHistory && (
          <div style="margin-top:28px; background:#fff; border:1px solid var(--tan-border); border-radius:var(--radius); padding:22px 26px;">
            <div class="page-eyebrow" style="color:var(--gold); margin-bottom:8px;">Where this van has been</div>
            <p style="color:var(--ink); line-height:1.75; font-style:italic;">{caravan.tripHistory}</p>
          </div>
        )}

        {caravan.features?.length > 0 && (
          <div style="margin-top:32px;">
            <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.3rem; font-weight:700; margin-bottom:6px;">Top features</h2>
            <p style="color:var(--muted); font-size:0.92rem; margin-bottom:18px;">What makes this rig stand out from the lineup.</p>
            <div class="feature-cards">
              {caravan.features.map((f) => {
                // Features can be either a plain string "Lithium upgrade" OR a
                // markdown-ish "Label - Description" pattern. Split if present.
                const dashIdx = typeof f === 'string' ? f.search(/\s[-–—]\s/) : -1
                const label = dashIdx > -1 ? f.slice(0, dashIdx).trim() : f
                const detail = dashIdx > -1 ? f.slice(dashIdx + 3).trim() : null
                return (
                  <div class="feature-card">
                    <div class="feature-card-label">{label}</div>
                    {detail && <div class="feature-card-detail">{detail}</div>}
                  </div>
                )
              })}
            </div>
          </div>
        )}

      </div>

      <!-- Right: price + specs + enquire -->
      <div class="listing-sidebar">
        {caravan.condition && conditionLabel(caravan.condition) && (
          <span class={`condition-badge condition-${caravan.condition}`} style="margin-bottom:14px;">
            {conditionLabel(caravan.condition)} condition
          </span>
        )}
        <div class="listing-price">${caravan.price?.toLocaleString('en-AU')}</div>
        {caravan.brand && <div class="listing-brand">{caravan.brand}</div>}

        {authorisedDealerLabel && (
          <div class="trust-badge-mini">
            <span class="trust-tick" aria-hidden="true">✓</span>
            {authorisedDealerLabel}
          </div>
        )}

        {caravan.specs && (
        <div class="specs-block">
          <div class="specs-block-label">Specs</div>
          <div class="specs-grid">
            {caravan.specs.sleeps && (
              <div class="spec-item">
                <span class="spec-label">Sleeps</span>
                <span class="spec-value">{caravan.specs.sleeps}</span>
              </div>
            )}
            {caravan.specs.length && (
              <div class="spec-item">
                <span class="spec-label">Length</span>
                <span class="spec-value">{caravan.specs.length}ft</span>
              </div>
            )}
            {caravan.specs.tareWeight && (
              <div class="spec-item">
                <span class="spec-label">Tare weight</span>
                <span class="spec-value">{caravan.specs.tareWeight}kg</span>
              </div>
            )}
            {caravan.specs.atm && (
              <div class="spec-item">
                <span class="spec-label">ATM</span>
                <span class="spec-value">{caravan.specs.atm}kg</span>
              </div>
            )}
            {batteryTypeLabel && (
              <div class="spec-item">
                <span class="spec-label">Battery</span>
                <span class="spec-value">{batteryTypeLabel}</span>
              </div>
            )}
            {caravan.power?.batteryCapacityAh && (
              <div class="spec-item">
                <span class="spec-label">Capacity</span>
                <span class="spec-value">{caravan.power.batteryCapacityAh}Ah</span>
              </div>
            )}
            {caravan.power?.solarWatts && (
              <div class="spec-item">
                <span class="spec-label">Solar</span>
                <span class="spec-value">{caravan.power.solarWatts}W</span>
              </div>
            )}
            {caravan.power?.inverterWatts && (
              <div class="spec-item">
                <span class="spec-label">Inverter</span>
                <span class="spec-value">{caravan.power.inverterWatts}W</span>
              </div>
            )}
          </div>
        </div>
        )}

        {(caravan.compliance?.stockNumber || caravan.compliance?.vin || caravan.compliance?.registrationState) && (
          <div style="margin-top:14px; padding:12px 0; border-top:1px solid var(--tan-border); font-size:0.78rem; color:var(--muted);">
            {caravan.compliance.stockNumber && (
              <div style="margin-bottom:4px;">
                <span style="font-weight:600;">Stock #:</span> {caravan.compliance.stockNumber}
              </div>
            )}
            {caravan.compliance.registrationState && (
              <div style="margin-bottom:4px;">
                <span style="font-weight:600;">Reg state:</span> {caravan.compliance.registrationState}
              </div>
            )}
            {caravan.compliance.vin && (
              <div style="font-family:monospace; word-break:break-all;">
                <span style="font-weight:600; font-family:'Inter Tight', sans-serif;">VIN:</span> {caravan.compliance.vin}
              </div>
            )}
          </div>
        )}

        <a href="#listing-enquiry" class="btn-enquire">Enquire about this caravan</a>

        <p style="margin-top:16px; font-size:0.78rem; color:var(--text-muted); text-align:center;">
          Or call us on <a href="tel:0753707933" style="color:var(--rust);">(07) 5370 7933</a>
        </p>
      </div>

    </div>

    <!-- Per-listing enquiry form. Posts via Netlify Forms to office@. The
         caravan's Sanity-loaded title, brand, stock #, price + URL are
         all submitted as hidden fields so the team has full context on
         reply without the customer having to retype anything. -->
    <section id="listing-enquiry" class="listing-enquiry">
      <div class="listing-enquiry-inner">
        <div class="page-eyebrow" style="color:var(--rust);">Enquire about this caravan</div>
        <h2 class="listing-enquiry-title">Let's make sure this van is right for you.</h2>
        <p class="listing-enquiry-sub">
          A few quick details about you and how you'll use it - that's all we need to have a useful chat.
        </p>

        <form
          class="enquiry-form"
          name="listing-enquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/thanks/"
        >
          <input type="hidden" name="form-name" value="listing-enquiry" />
          <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <!-- Caravan context (Sanity-sourced, hidden from the customer) -->
          <input type="hidden" name="caravan_title" value={caravan.title} />
          <input type="hidden" name="caravan_brand" value={caravan.brand || ''} />
          <input type="hidden" name="caravan_price" value={caravan.price || ''} />
          <input type="hidden" name="caravan_stock_number" value={caravan.compliance?.stockNumber || ''} />
          <input type="hidden" name="caravan_status" value={caravan.status || ''} />
          <input type="hidden" name="caravan_url" value={listingPageUrl} />

          <div class="form-row">
            <label>
              Your name
              <input type="text" name="customer_name" required autocomplete="name" />
            </label>
            <label>
              Phone
              <input type="tel" name="customer_phone" required autocomplete="tel" placeholder="04xx xxx xxx" />
            </label>
          </div>

          <div class="form-row">
            <label>
              Email
              <input type="email" name="customer_email" required autocomplete="email" />
            </label>
            <label>
              State you live in
              <select name="customer_state" required>
                <option value="">-- Pick one --</option>
                <option value="QLD">Queensland</option>
                <option value="NSW">New South Wales</option>
                <option value="VIC">Victoria</option>
                <option value="WA">Western Australia</option>
                <option value="SA">South Australia</option>
                <option value="TAS">Tasmania</option>
                <option value="ACT">ACT</option>
                <option value="NT">Northern Territory</option>
              </select>
            </label>
          </div>

          <label>
            What vehicle are you towing with?
            <input type="text" name="tow_vehicle" placeholder="e.g. 200-Series LandCruiser, Ranger, Patrol" />
          </label>

          <label>
            Have you owned a caravan before?
            <select name="experience">
              <option value="">-- Pick one --</option>
              <option value="New to camping">New to camping</option>
              <option value="Camped in tents or swags, first caravan">Camped in tents or swags, first caravan</option>
              <option value="Owned a caravan before">Owned a caravan before</option>
              <option value="Multiple caravans over the years">Multiple caravans over the years</option>
            </select>
          </label>

          <label>
            What video or photo brought you here? (optional)
            <input type="text" name="video_watched" placeholder="e.g. the 2018 Karavan walk-around, or just 'browsing the lot'" />
          </label>

          <label class="qb-checkbox-row" style="display:flex; align-items:center; gap:12px; cursor:pointer; padding:14px 16px; background:var(--sand-deep, #F4EDE0); border:1px solid var(--tan-border, #DCCBA8); border-radius:8px; margin: 6px 0 12px;">
            <input
              type="checkbox"
              name="send_spec_sheet"
              value="yes"
              style="width:22px; height:22px; margin:0; flex-shrink:0; accent-color:var(--rust, #C0341A); cursor:pointer;"
            />
            <span style="font-weight:600; color:var(--ink, #2A1608); line-height:1.4;">Send me the full spec sheet for this van.</span>
          </label>

          <label>
            Anything else? (optional)
            <textarea name="message" placeholder="Want to book a viewing, intended trip, what upgrades can I add to this unit, anything we should know..."></textarea>
          </label>

          <p class="form-policy-note" style="font-size:0.82rem; color:var(--muted, #8B6A40); margin: 6px 0 14px;">
            Heads-up: we don't do trade-ins or finance - we just want this to be the right van for you.
          </p>

          <div class="qb-actions" style="margin-top:18px;">
            <button type="submit" class="qb-submit">Send enquiry</button>
            <button type="button" class="qb-share" data-listing-share-email>
              <span aria-hidden="true">✉</span> Share by email
            </button>
            <button type="button" class="qb-share" data-listing-share>
              <span aria-hidden="true">↗</span> Copy share link
            </button>
          </div>
          <p class="qb-share-help" data-listing-share-help hidden>
            Link copied. Paste it in a text, message or email to share this caravan with your partner or family.
          </p>
        </form>
      </div>
    </section>

    <script is:inline>
      (function () {
        const linkBtn = document.querySelector('[data-listing-share]')
        const emailBtn = document.querySelector('[data-listing-share-email]')
        const help = document.querySelector('[data-listing-share-help]')
        const url = window.location.href.split('#')[0]
        const title = document.title
        const text = `Have a look at this caravan I am thinking about from SEQ Campers.\n\n${title}\n\nOpen the listing: ${url}`

        if (linkBtn) linkBtn.addEventListener('click', async () => {
          if (navigator.share) {
            try { await navigator.share({ title, text, url }); return } catch (e) { /* fallback */ }
          }
          try {
            await navigator.clipboard.writeText(text)
            help.hidden = false
            setTimeout(() => { help.hidden = true }, 6000)
          } catch (e) {
            window.location.href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(text)
          }
        })

        if (emailBtn) emailBtn.addEventListener('click', () => {
          window.location.href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(text)
        })
      })()
    </script>

    <!-- FAQ section (FAQPage schema is in <head>) -->
    <section class="faq-section" aria-label="Frequently asked questions">
      <div class="page-eyebrow" style="color:var(--rust);">Common questions</div>
      <h2 class="faq-title">About this caravan</h2>
      <div class="faq-list">
        {caravanFaqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="faq-answer">{f.a}</div>
          </details>
        ))}
      </div>
      {!faqIsCustom && (
        <p class="faq-note">
          Want more detail? <a href="#listing-enquiry">Send us a quick note</a> and we'll get back to you.
        </p>
      )}
    </section>
  </div>
</Site>


