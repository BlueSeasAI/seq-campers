---
import Site from '../../layouts/Site.astro'
import BrollCard from '../../components/BrollCard.astro'
import ReserveCta from '../../components/ReserveCta.astro'
import YoutubeSubscribeBar from '../../components/YoutubeSubscribeBar.astro'
import { getUsedCaravans } from '../../lib/sanity.js'

let caravans = []
try {
  caravans = await getUsedCaravans()
} catch (err) {
  console.warn('Sanity unreachable for /stock:', err.message)
}

// Every used van is a B-roll video tile. The page shows ONLY real Sanity
// listings, most expensive first.
//
// NOTE (16 Jul): the grid used to be topped up to 15 tiles with synthetic
// "placeholder" cards generated in code (fake stock numbers like #6000 /
// #6011, fake prices, no spec page). Those were the "placeholders that keep
// reappearing" Kyle couldn't find in Sanity - because they were never in
// Sanity; the code invented them whenever real stock dropped below 15. The
// generator has been removed so the page now mirrors the real stock exactly.
let tiles = [...caravans].sort((a, b) => (b.price || 0) - (a.price || 0))

const description = `Used off-road caravans, off-grid hybrids and 4x4 camper vans ready to tow away from SEQ Campers on the Sunshine Coast, Queensland. Hand-picked Kimberley Kampers and Stockman Products stock with walk-around video for every van. Affordable off-road caravan to luxury off-grid options.`
---

<Site title="Off-road vans ready to tow" description={description}>
  <div class="page-header page-header-tight">
    <div class="container">
      <div class="page-eyebrow" style="color:var(--gold);">SEQ and compare</div>
      <h1>Off-road vans ready to tow.</h1>
      <p id="result-count">Used off-road caravans, off-grid hybrids and 4x4 camper vans ready to tow away from the Sunshine Coast. Every one hand-picked, inspected and walked through by Shane and the SEQ team.</p>
    </div>
  </div>

  <div class="container" style="padding-top:24px; padding-bottom:48px;">
    {tiles.length === 0 ? (
      <div class="empty-state">
        <div class="empty-title">Used stock listings loading</div>
        <p>We're rebuilding the used stock library right now. Check back shortly, or call (07) 5370 7933 to ask what's about to land.</p>
      </div>
    ) : (
      <div class="broll-grid" id="stock-grid">
        {tiles.map((c) => <BrollCard caravan={c} showPrice={true} />)}
      </div>
    )}
  </div>


  <style>
    .broll-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
    }
    @media (max-width: 640px) {
      .broll-grid { grid-template-columns: 1fr; gap: 14px; }
    }
    /* .page-header-tight is now defined once in global.css (was duplicated
       per-page, which left most pages on the loose base padding). */
  </style>

  <YoutubeSubscribeBar variant="bar" headline="Watch walk-arounds before you visit" sub="Every used van gets a YouTube walk-around. Subscribe to see new arrivals first." />
  <ReserveCta variant="band" />
</Site>
