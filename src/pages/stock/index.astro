---
import Site from '../../layouts/Site.astro'
import BrollCard from '../../components/BrollCard.astro'
import { getUsedCaravans } from '../../lib/sanity.js'

let caravans = []
try {
  caravans = await getUsedCaravans()
} catch (err) {
  console.warn('Sanity unreachable for /stock:', err.message)
}

// Per Shane: every used van is a B-roll video tile. We top up to 15 tiles
// with placeholder videos when there are fewer real listings, so the page
// shape stays consistent. Real listings fill these slots as Maud adds the
// brollVideoUrl to each van.
const PLACEHOLDER_VIDEOS = [
  'tozC7prVbOg', 'xYf81xUZtNE', 'WwgapQt3xO4',
]
const PLACEHOLDER_BRANDS = [
  { brand: 'Kimberley Campers', model: 'Karavan' },
  { brand: 'Kimberley Campers', model: 'Kube' },
  { brand: 'Kimberley Campers', model: 'Kruiser T' },
  { brand: 'Kimberley Campers', model: 'Kruiser S' },
  { brand: 'Stockman Products', model: 'Trekka' },
  { brand: 'Stockman Products', model: 'Rover' },
  { brand: 'Stockman Products', model: 'Pod' },
]
function makePlaceholder(i) {
  const vidId = PLACEHOLDER_VIDEOS[i % PLACEHOLDER_VIDEOS.length]
  const b = PLACEHOLDER_BRANDS[i % PLACEHOLDER_BRANDS.length]
  const year = 2018 + (i % 8)
  const stockNo = String(6000 + i * 11).padStart(4, '0')
  // Synthetic price so placeholders mix into the descending sort sensibly
  // (descend across the 7 placeholder brands - Karavan most expensive).
  const placeholderPrices = [145000, 95000, 220000, 175000, 65000, 60000, 35000]
  return {
    _id: `placeholder-${i}`,
    title: `${b.brand} ${b.model} ${year}`,
    slug: { current: 'placeholder' },
    brand: b.brand,
    brollVideoUrl: `https://www.youtube.com/watch?v=${vidId}`,
    price: placeholderPrices[i % placeholderPrices.length],
    specs: { year },
    compliance: { stockNumber: stockNo },
    _isPlaceholder: true,
  }
}
const TARGET_TILES = 15
const placeholdersNeeded = Math.max(0, TARGET_TILES - caravans.length)
let tiles = [
  ...caravans,
  ...Array.from({ length: placeholdersNeeded }, (_, i) => makePlaceholder(i)),
]

// Sort tiles by price descending (most expensive first) per Bart 8 Jun.
tiles = tiles.sort((a, b) => (b.price || 0) - (a.price || 0))

const description = `Browse ${caravans.length} hand-picked off-road caravans ready to tow away at SEQ Campers on the Sunshine Coast, Queensland. Walk-around video for every van.`
---

<Site title="Off-road vans ready to tow" description={description}>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>Off-road vans ready to tow.</h1>
      <p id="result-count">{caravans.length} caravan{caravans.length !== 1 ? 's' : ''} ready to tow away.</p>
    </div>
  </div>

  <div class="container" style="padding-top:24px; padding-bottom:48px;">
    {tiles.length === 0 ? (
      <div class="empty-state">
        <div class="empty-title">Used stock listings loading</div>
        <p>We're rebuilding the used stock library right now. Check back shortly, or call (07) 5370 7933 to ask what's about to land.</p>
      </div>
    ) : (
      <div class="broll-grid" id="stock-grid">
        {tiles.map((c) => <BrollCard caravan={c} />)}
      </div>
    )}
  </div>


  <style>
    .broll-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
    }
    @media (max-width: 640px) {
      .broll-grid { grid-template-columns: 1fr; gap: 14px; }
    }
    /* Tighten the brown page-header banner site-wide. Per Bart 8 Jun. */
    :global(.page-header.page-header-tight) {
      padding-top: 32px;
      padding-bottom: 32px;
    }
  </style>
</Site>
