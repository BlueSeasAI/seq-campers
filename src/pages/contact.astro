---
import Site from '../layouts/Site.astro'

const mapQuery = encodeURIComponent('SEQ Campers, 3B/6 Bonanza Court, Marcoola QLD 4564, Australia')
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`
---

<Site
  title="Contact us"
  description="Get in touch with SEQ Campers on the Sunshine Coast. Phone, email, enquiry form, or visit us in person."
>
  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">Contact</div>
      <h1>Talk to us about your next caravan.</h1>
      <p>Phone, email, or drop in. We are easy to find.</p>
    </div>
  </div>

  <section class="section" style="padding-bottom:32px;">
    <div class="container" style="max-width:980px;">

      <!-- Three quick-contact cards (same height so they line up cleanly) -->
      <div class="contact-cards">
        <a href="tel:0753707933" class="contact-card">
          <div class="page-eyebrow" style="color:#C0341A;">Phone</div>
          <div class="contact-card-value">(07) 5370 7933</div>
          <div class="contact-card-foot">Online enquiries 7am - 4:30pm</div>
        </a>

        <a href="mailto:office@seqcampers.com.au" class="contact-card">
          <div class="page-eyebrow" style="color:#C0341A;">Email</div>
          <div class="contact-card-value" style="font-size:1.05rem; word-break:break-word;">office@seqcampers.com.au</div>
          <div class="contact-card-foot">We reply within one business day.</div>
        </a>

        <div class="contact-card contact-card-static">
          <div class="page-eyebrow" style="color:#C0341A;">Showroom</div>
          <div class="contact-card-value" style="font-size:1.05rem; line-height:1.35;">
            3B/6 Bonanza Court<br />Marcoola QLD 4564
          </div>
          <div class="contact-card-foot">Visit by appointment.</div>
        </div>
      </div>

      <!-- Two-column: form + map -->
      <div class="contact-grid">
        <div>
          <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; color:#2A1608; margin-bottom:16px;">Send us a message</h2>
          <p style="color:#8B6A40; margin-bottom:20px;">
            Tell us about the caravan you are after and we will get back to you within one business day.
          </p>

          <!-- Netlify Form -->
          <form
            class="enquiry-form"
            name="enquiry"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/thanks/"
          >
            <input type="hidden" name="form-name" value="enquiry" />
            <p class="hp">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>

            <div class="form-row">
              <label>
                Your name
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label>
                Phone
                <input type="tel" name="phone" autocomplete="tel" placeholder="04xx xxx xxx" />
              </label>
            </div>

            <label>
              Email
              <input type="email" name="email" required autocomplete="email" />
            </label>

            <label>
              Caravan you are interested in
              <input type="text" name="caravan_interest" placeholder="e.g. Kimberley Kamper Kompact, or 'browsing'" />
            </label>

            <label>
              How can we help?
              <textarea name="message" required placeholder="Tell us a bit about what you are looking for - any specific specs, budget, timeline."></textarea>
            </label>

            <button type="submit">Send enquiry</button>
          </form>
        </div>

        <div>
          <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; color:#2A1608; margin-bottom:16px;">Find us</h2>
          <p style="color:#8B6A40; margin-bottom:20px;">
            We are at <strong style="color:var(--ink);">3B/6 Bonanza Court, Marcoola</strong>, ten minutes north of Maroochydore.
          </p>
          <div class="map-embed map-embed-small">
            <iframe
              src={mapSrc}
              title="SEQ Campers location on Google Maps"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <p style="font-size:0.8rem; color:#8B6A40; margin-top:12px; text-align:center;">
            Plenty of parking on site. Trailer space available on request.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-bottom: 40px;
    }
    .contact-card {
      background: #fff;
      border: 1px solid #DCCBA8;
      border-radius: 8px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 150px;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .contact-card:hover:not(.contact-card-static) {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(42,22,8,0.10);
    }
    .contact-card-value {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.4rem;
      font-weight: 600;
      color: #2A1608;
      flex: 1;
    }
    .contact-card-foot {
      color: #8B6A40;
      font-size: 0.9rem;
      margin-top: 12px;
    }
    @media (max-width: 760px) {
      .contact-cards { grid-template-columns: 1fr; gap: 12px; }
      .contact-card { min-height: 0; }
    }
    @media (max-width: 768px) {
      .contact-grid { grid-template-columns: 1fr !important; }
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: start;
    }
  </style>
</Site>
