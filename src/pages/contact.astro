---
import Site from '../layouts/Site.astro'
---

<Site title="Contact us" description="Get in touch with SEQ Campers on the Sunshine Coast. Phone, email, or visit us in person.">
  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">Contact</div>
      <h1>Talk to us about your next caravan.</h1>
      <p>Phone, email, or drop in. We are easy to find.</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:880px;">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:20px; margin-bottom:48px;">

        <div style="background:#fff; border:1px solid #DCCBA8; border-radius:8px; padding:24px;">
          <div class="page-eyebrow" style="color:#C0341A;">Phone</div>
          <a href="tel:0753002344" style="font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; color:#2A1608; text-decoration:none;">(07) 5300 2344</a>
          <div style="margin-top:8px; color:#8B6A40; font-size:0.9rem;">Mon to Sat, 8am to 5pm AEST</div>
        </div>

        <div style="background:#fff; border:1px solid #DCCBA8; border-radius:8px; padding:24px;">
          <div class="page-eyebrow" style="color:#C0341A;">Email</div>
          <a href="mailto:enquiries@seqcampers.com.au" style="font-family:'Inter Tight', sans-serif; font-size:1.05rem; font-weight:600; color:#2A1608; text-decoration:none; word-break:break-word;">enquiries@seqcampers.com.au</a>
          <div style="margin-top:8px; color:#8B6A40; font-size:0.9rem;">We reply within one business day.</div>
        </div>

        <div style="background:#fff; border:1px solid #DCCBA8; border-radius:8px; padding:24px;">
          <div class="page-eyebrow" style="color:#C0341A;">Location</div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:1.05rem; font-weight:600; color:#2A1608;">Sunshine Coast, QLD</div>
          <div style="margin-top:8px; color:#8B6A40; font-size:0.9rem;">Visit by appointment recommended.</div>
        </div>

      </div>

      <div style="background:#2A1608; color:#F4EDE0; border-radius:8px; padding:32px; text-align:center;">
        <div class="page-eyebrow" style="color:#D4943A;">Coming soon</div>
        <div style="font-family:'Inter Tight', sans-serif; font-size:1.3rem; font-weight:600; color:#F4EDE0; margin:8px 0 12px;">Online enquiry form</div>
        <p style="color:#D4943A; max-width:520px; margin:0 auto;">
          For now, give us a call or send an email. A proper enquiry form with photos
          and caravan-specific questions is coming with the next phase of the site.
        </p>
      </div>
    </div>
  </section>
</Site>
