---
import Site from '../layouts/Site.astro'

const mapQuery = encodeURIComponent('SEQ Campers, 6 Bonanza Ct, Marcoola QLD 4564, Australia')
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`

const showroomHours = [
  { day: 'Monday', hours: '7:30am - 3pm' },
  { day: 'Tuesday', hours: '7:30am - 3pm' },
  { day: 'Wednesday', hours: '7:30am - 3pm' },
  { day: 'Thursday', hours: '8:30am - 3pm' },
  { day: 'Friday', hours: '8:30am - 3pm' },
  { day: 'Saturday', hours: '8:30am - 12:30pm' },
  { day: 'Sunday', hours: 'Closed', closed: true },
]
---

<Site
  title="Contact us"
  description="Get in touch with SEQ Campers on the Sunshine Coast. Phone, email, enquiry form, or visit us in person."
>
  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">Contact</div>
      <h1>Talk to us about your next caravan.</h1>
      <p>Phone, email, or drop in. We are easy to find.</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:980px;">

      <!-- Three quick-contact cards -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:18px; margin-bottom:48px;">

        <a href="tel:0753707933" style="text-decoration:none; color:inherit;">
          <div style="background:#fff; border:1px solid #DCCBA8; border-radius:8px; padding:24px; transition:transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 18px rgba(42,22,8,0.10)';" onmouseout="this.style.transform='';this.style.boxShadow='';">
            <div class="page-eyebrow" style="color:#C0341A;">Phone</div>
            <div style="font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; color:#2A1608;">(07) 5370 7933</div>
            <div style="margin-top:8px; color:#8B6A40; font-size:0.9rem;">Online enquiries 7am - 4:30pm</div>
          </div>
        </a>

        <a href="mailto:office@seqcampers.com.au" style="text-decoration:none; color:inherit;">
          <div style="background:#fff; border:1px solid #DCCBA8; border-radius:8px; padding:24px; transition:transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 18px rgba(42,22,8,0.10)';" onmouseout="this.style.transform='';this.style.boxShadow='';">
            <div class="page-eyebrow" style="color:#C0341A;">Email</div>
            <div style="font-family:'Inter Tight', sans-serif; font-size:1.05rem; font-weight:600; color:#2A1608; word-break:break-word;">office@seqcampers.com.au</div>
            <div style="margin-top:8px; color:#8B6A40; font-size:0.9rem;">We reply within one business day.</div>
          </div>
        </a>

        <div style="background:#fff; border:1px solid #DCCBA8; border-radius:8px; padding:24px;">
          <div class="page-eyebrow" style="color:#C0341A;">Showroom</div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:1.05rem; font-weight:600; color:#2A1608; line-height:1.35;">
            6 Bonanza Ct<br />Marcoola QLD 4564
          </div>
          <div style="margin-top:8px; color:#8B6A40; font-size:0.9rem;">Visit by appointment recommended.</div>
        </div>
      </div>

      <!-- Showroom hours block -->
      <div class="hours-block" style="margin-bottom:48px;">
        <h3>Showroom & workshop hours</h3>
        <table class="hours-table">
          <tbody>
            {showroomHours.map((row) => (
              <tr>
                <td>{row.day}</td>
                <td class={row.closed ? 'is-closed' : ''}>{row.hours}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p style="margin-top:14px; font-size:0.82rem; color:var(--muted); line-height:1.5;">
          Online enquiries are answered 7am - 4:30pm every day. Out of hours messages
          get a reply first thing the next business day.
        </p>
      </div>

      <!-- Two-column: form + map -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px; align-items:start;" class="contact-grid">
        <div>
          <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; color:#2A1608; margin-bottom:16px;">Send us a message</h2>
          <p style="color:#8B6A40; margin-bottom:20px;">
            Tell us about the caravan you are after and we will get back to you within one business day.
          </p>

          <!-- Netlify Form -->
          <form
            class="enquiry-form"
            name="enquiry"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/thanks/"
          >
            <input type="hidden" name="form-name" value="enquiry" />
            <p class="hp">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>

            <div class="form-row">
              <label>
                Your name
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label>
                Phone
                <input type="tel" name="phone" autocomplete="tel" placeholder="04xx xxx xxx" />
              </label>
            </div>

            <label>
              Email
              <input type="email" name="email" required autocomplete="email" />
            </label>

            <label>
              Caravan you are interested in
              <input type="text" name="caravan_interest" placeholder="e.g. Kimberley Kamper Kompact, or 'browsing'" />
            </label>

            <label>
              How can we help?
              <textarea name="message" required placeholder="Tell us a bit about what you are looking for - any specific specs, budget, timeline."></textarea>
            </label>

            <button type="submit">Send enquiry</button>

            <p style="font-size:0.78rem; color:#8B6A40; margin-top:4px; text-align:center;">
              We will only use your details to reply to your enquiry. No marketing lists.
            </p>
          </form>
        </div>

        <div>
          <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; color:#2A1608; margin-bottom:16px;">Find us</h2>
          <p style="color:#8B6A40; margin-bottom:20px;">
            We are at <strong style="color:var(--ink);">6 Bonanza Ct, Marcoola</strong>, ten minutes north of Maroochydore on the Sunshine Coast.
            Visits by appointment so we can give you our full attention.
          </p>
          <div class="map-embed">
            <iframe
              src={mapSrc}
              title="SEQ Campers location on Google Maps"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <p style="font-size:0.8rem; color:#8B6A40; margin-top:12px; text-align:center;">
            Plenty of parking on site. Trailer space available on request.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .contact-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</Site>
