---
import Site from '../../layouts/Site.astro'
import { client as sanityClient, youtubeId } from '../../lib/sanity.js'

// UNLISTED handover pages - one per brand family. Shared by direct URL
// only (printed in the handover letter, follow-up email). Not in the
// site navigation. noindex meta tag prevents indexing.
//
// Data lives in Sanity as 'handoverPage' documents. Each has one or
// more model sections; each section has a list of videos.

export async function getStaticPaths() {
  let docs = []
  try {
    docs = await sanityClient.fetch(`*[_type == "handoverPage" && defined(slug.current)] { "slug": slug.current }`) || []
  } catch (err) {
    console.warn('Sanity unreachable for handover paths:', err.message)
  }
  // Always include kimberley + stockman so the URLs exist even before
  // Maud publishes the documents.
  const slugs = new Set(docs.map((d) => d.slug))
  slugs.add('kimberley')
  slugs.add('stockman')
  return Array.from(slugs).map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params

let page = null
try {
  page = await sanityClient.fetch(
    `*[_type == "handoverPage" && slug.current == $slug][0] {
      title,
      congratulationsHeading,
      introBody,
      sections[] {
        modelName,
        introHeading,
        videos[] { title, youtubeUrl, description }
      }
    }`,
    { slug }
  )
} catch (err) {
  console.warn('Sanity unreachable for handover page:', err.message)
}

// Placeholder fallback per brand so the URL renders something useful
// even before Maud publishes the document. Video IDs lifted from the
// existing seqcampers.com.au /30th-edition-owners + kruiswagen +
// rover-02 handover pages so the same content shows on the new site.
const PLACEHOLDERS = {
  kimberley: {
    title: 'Kimberley Kampers',
    congratulationsHeading: 'Congratulations on your new Kimberley Kampers',
    introBody: 'Welcome to the Kimberley Kampers family. Below are the walk-through videos to watch before your handover - one section per model. Any questions, give us a call on (07) 5370 7933.',
    sections: [
      {
        modelName: 'Kimberley Karavan',
        introHeading: 'Please watch these videos before your Kimberley Karavan handover',
        videos: [
          { title: 'Outside walkaround - Kimberley Karavan 30th Edition', youtubeUrl: 'https://youtu.be/Q2njuxF3oIA' },
          { title: 'Karavan handover - part 1', youtubeUrl: 'https://youtu.be/2EbM4qhK-S0' },
          { title: 'Karavan handover - part 2', youtubeUrl: 'https://youtu.be/er39QCC1zKE' },
          { title: 'Karavan handover - part 3', youtubeUrl: 'https://youtu.be/07p_jkwgcXs' },
          { title: 'Karavan handover - part 4', youtubeUrl: 'https://youtu.be/ZbakrsjKKAM' },
          { title: 'Karavan handover - part 5', youtubeUrl: 'https://youtu.be/7gVrex9paUM' },
          { title: 'Karavan handover - part 6', youtubeUrl: 'https://youtu.be/Y2MfN6KoXK4' },
          { title: 'Karavan handover - part 7', youtubeUrl: 'https://youtu.be/HpcdiM6aCxI' },
          { title: 'Karavan handover - part 8', youtubeUrl: 'https://youtu.be/uT6Z4a8S9B0' },
          { title: 'Karavan handover - part 9', youtubeUrl: 'https://youtu.be/8kiKoB3pREE' },
          { title: 'Karavan handover - part 10', youtubeUrl: 'https://youtu.be/axhVL9vT8U0' },
          { title: 'Karavan handover - part 11', youtubeUrl: 'https://youtu.be/qZh6Aoa9UCU' },
          { title: 'Karavan handover - part 12', youtubeUrl: 'https://youtu.be/wtH3CINOFqk' },
          { title: 'Karavan handover - part 13', youtubeUrl: 'https://youtu.be/Pz0bS8JgkxA' },
          { title: 'Karavan handover - part 14', youtubeUrl: 'https://youtu.be/8ktpSK8Yz1o' },
          { title: 'Karavan handover - part 15', youtubeUrl: 'https://youtu.be/WbXUVWCi7Ik' },
          { title: 'Karavan handover - part 16', youtubeUrl: 'https://youtu.be/sdmlX7Va4h0' },
        ],
      },
      {
        modelName: 'Kimberley Kruiswagen',
        introHeading: 'Please watch these videos before your Kimberley Kruiswagen handover',
        videos: [
          { title: 'Kruiswagen handover - part 1', youtubeUrl: 'https://youtu.be/6PLLt3U1i90' },
          { title: 'Kruiswagen handover - part 2', youtubeUrl: 'https://youtu.be/M2jZkQ9rvh4' },
          { title: 'Kruiswagen handover - part 3', youtubeUrl: 'https://youtu.be/TnAZDd_bYxU' },
          { title: 'Kruiswagen handover - part 4', youtubeUrl: 'https://youtu.be/UXpJUD7lySE' },
          { title: 'Kruiswagen handover - part 5', youtubeUrl: 'https://youtu.be/_Id9ZHeGVkI' },
          { title: 'Kruiswagen handover - part 6', youtubeUrl: 'https://youtu.be/atuhWKyaQoo' },
          { title: 'Kruiswagen handover - part 7', youtubeUrl: 'https://youtu.be/aucc8jy8lj0' },
          { title: 'Kruiswagen handover - part 8', youtubeUrl: 'https://youtu.be/hhac2d_qdPs' },
          { title: 'Kruiswagen handover - part 9', youtubeUrl: 'https://youtu.be/iZzIbETP4Dg' },
          { title: 'Kruiswagen handover - part 10', youtubeUrl: 'https://youtu.be/rnDy3mSZg0w' },
        ],
      },
    ],
  },
  stockman: {
    title: 'Stockman Products',
    congratulationsHeading: 'Congratulations on your new Stockman Products',
    introBody: 'Welcome to the Stockman Products family. Below are the walk-through videos to watch before your handover. Any questions, give us a call on (07) 5370 7933.',
    sections: [
      {
        modelName: 'Stockman Rover 02',
        introHeading: 'Please watch these videos before your Stockman Rover 02 handover',
        videos: [
          { title: 'Rover 02 handover - part 1', youtubeUrl: 'https://youtu.be/6PLLt3U1i90' },
          { title: 'Rover 02 handover - part 2', youtubeUrl: 'https://youtu.be/M2jZkQ9rvh4' },
          { title: 'Rover 02 handover - part 3', youtubeUrl: 'https://youtu.be/TnAZDd_bYxU' },
          { title: 'Rover 02 handover - part 4', youtubeUrl: 'https://youtu.be/UXpJUD7lySE' },
          { title: 'Rover 02 handover - part 5', youtubeUrl: 'https://youtu.be/_Id9ZHeGVkI' },
          { title: 'Rover 02 handover - part 6', youtubeUrl: 'https://youtu.be/atuhWKyaQoo' },
          { title: 'Rover 02 handover - part 7', youtubeUrl: 'https://youtu.be/aucc8jy8lj0' },
          { title: 'Rover 02 handover - part 8', youtubeUrl: 'https://youtu.be/hn1RcE04BaU' },
          { title: 'Rover 02 handover - part 9', youtubeUrl: 'https://youtu.be/iZzIbETP4Dg' },
          { title: 'Rover 02 handover - part 10', youtubeUrl: 'https://youtu.be/rnDy3mSZg0w' },
        ],
      },
    ],
  },
}

const data = page || PLACEHOLDERS[slug] || null

if (!data) return Astro.redirect('/')

const isPlaceholder = !page
---

<Site
  title={`${data.title} - new owner handover videos`}
  description={`${data.congratulationsHeading}. Walk-through videos to watch before your handover.`}
  noindex={true}
>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>{data.congratulationsHeading}</h1>
      {data.introBody && <p>{data.introBody}</p>}
    </div>
  </div>

  {(data.sections || []).map((section) => (
    <section class="section handover-section">
      <div class="container" style="max-width:1100px;">
        <div class="section-header" style="text-align:center; flex-direction:column; gap:4px; margin-bottom:24px;">
          <div class="page-eyebrow" style="color:var(--rust);">{section.modelName}</div>
          {section.introHeading && <h2 class="section-title">{section.introHeading}</h2>}
        </div>

        <div class="handover-video-grid">
          {(section.videos || []).map((v) => {
            const vid = youtubeId(v.youtubeUrl)
            return vid ? (
              <div class="handover-video-tile">
                <div class="handover-video-media">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${vid}?modestbranding=1&rel=0&iv_load_policy=3&playsinline=1`}
                    title={v.title}
                    frameborder="0"
                    allow="encrypted-media; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                </div>
                <div class="handover-video-meta">
                  <h3 class="handover-video-title">{v.title}</h3>
                  {v.description && <p class="handover-video-desc">{v.description}</p>}
                </div>
              </div>
            ) : null
          })}
        </div>
      </div>
    </section>
  ))}

  <section class="section" style="background:var(--sand-deep); padding-top:32px; padding-bottom:32px;">
    <div class="container" style="text-align:center; max-width:640px;">
      <h2 style="margin-bottom:10px;">Need a hand?</h2>
      <p style="color:var(--muted); margin-bottom:18px;">
        Anything you're not sure about - give us a call. We are at the workshop most days and happy to walk you through anything.
      </p>
      <p style="font-family:'Inter Tight',sans-serif; font-weight:700; font-size:1.1rem;">
        <a href="tel:0753707933" style="color:var(--rust);">(07) 5370 7933</a>
        &nbsp;·&nbsp;
        <a href="mailto:office@seqcampers.com.au" style="color:var(--rust);">office@seqcampers.com.au</a>
      </p>
    </div>
  </section>

  <style>
    .handover-section { padding-top: 40px; padding-bottom: 40px; }
    .handover-section:nth-of-type(even) { background: var(--sand-deep, #EBE0CD); }
    .handover-video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 24px;
    }
    .handover-video-tile {
      background: #fff;
      border: 1px solid var(--tan-border, #DCCBA8);
      border-radius: 12px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .handover-video-tile:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(42,22,8,0.12);
    }
    .handover-video-media {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #1a1a1c;
    }
    .handover-video-media iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .handover-video-meta { padding: 14px 16px 16px; }
    .handover-video-title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 1rem;
      color: var(--ink, #2A1608);
      margin: 0 0 4px;
      line-height: 1.3;
    }
    .handover-video-desc {
      color: var(--muted, #8B6A40);
      font-size: 0.88rem;
      line-height: 1.5;
      margin: 0;
    }
  </style>
</Site>
