---
import Site from '../layouts/Site.astro'

// Brisbane Caravan, Camping & Touring Supershow 2026
const showDates = '3 - 7 June 2026'
const showDays = 'Wed - Sun, 5 days'
const venue = 'Brisbane Showgrounds, Bowen Hills'
const standNumber = '#2693'
const standArea = 'Main Oval'
const podiumNumber = '0422 624 920'

// Caravans we're bringing to the show floor (Shane confirmed)
const showStock = [
  { name: 'Kimberley Kruiswagen', detail: 'Mercedes 4x4 motorhome' },
  { name: 'Kimberley Karavan Eco Suite', detail: 'with media release' },
  { name: 'Kimberley Kruiser T Class', detail: 'luxury off-road tourer' },
  { name: 'Kimberley Kruiser S Class', detail: 'flagship apartment-grade' },
  { name: 'Stockman Trekka', detail: 'serious off-road camper trailer' },
  { name: 'Stockman Rover', detail: 'all-rounder family off-grid' },
  { name: 'Stockman POD All-Roader', detail: 'demo unit - 20% off, rooftop tent included' },
]

// Grand Slam show-offer value stack (Hormozi pattern, merged onto this page
// per Bart - one URL, no separate /show-offer page).
// TBC items - Shane to confirm via the checklist in the SEQ folder.
const SHOW_EXPIRY_ISO = '2026-06-07T23:00:00+10:00'
const VANS_REMAINING = 14
const HOLD_AMOUNT = 500
const inclusions = [
  { label: 'Full annual service voucher', value: 1450, note: 'Bearings, brakes, gas, electrics. Pre-trip ready.' },
  { label: 'Premium hitch upgrade', value: 1290, note: 'Off-road coupling, full articulation.' },
  { label: '12 months roadside cover', value: 580, note: 'Australia-wide breakdown assistance.' },
  { label: 'Stockman Rover accessory pack', value: 2500, note: '$2,500 of off-grid accessories - lithium, solar, awning, your pick.' },
  { label: 'Stockman Trekka accessory pack', value: 5000, note: '$5,000 of trail-ready accessories. Show-only inclusion.' },
  { label: 'Stockman POD accessory pack', value: 500, note: '$500 of POD accessories to kit your trailer out.' },
  { label: '$3,000 accessory credit (Kimberley)', value: 3000, note: 'Solar, lithium, or whatever upgrade matters most.' },
  { label: 'Stone deflector + rock tamer kit', value: 880, note: 'Save your windows on corrugations.' },
  { label: 'Show floor handover pack', value: 540, note: 'Levellers, sand pegs, hose, mat. Ready to camp.' },
  { label: 'Locked-in 2026 pricing', value: 5000, note: 'Pre-July factory price rises do not apply to show buyers.' },
]
// Per Shane: show each special individually, no summed total line.

// Quote builder pages now live on our own domain at /quote/{brand}.
// (Mirrored from Maud's rainbow-babka.netlify.app pages with Netlify Forms
// + per-variant pricing + share-quote button.)
const QUOTE_BASE = (Astro.site ?? new URL('https://seqcampers.com.au')).href.replace(/\/$/, '')

// 7 brands to feature with QR codes + quote builders at the show.
// QR codes are displayed on desktop only (no point scanning a QR on your own
// phone). Mobile visitors get a direct tap-through to the same quote page.
const brandQuotes = [
  {
    name: 'Stockman Rover',
    brand: 'Stockman',
    slug: 'rover',
    tagline: 'The all-rounder. Off-grid ready, family friendly, 90 second setup.',
    showSpecial: '$2,500 of free accessories included - show only',
  },
  {
    name: 'Stockman Trekka',
    brand: 'Stockman',
    slug: 'trekka',
    tagline: 'The serious off-road camper trailer. Tough, light, made for tracks.',
    showSpecial: '$5,000 of free accessories included - show only',
  },
  {
    name: 'Kimberley Karavan',
    brand: 'Kimberley',
    slug: 'karavan',
    tagline: 'The iconic Australian-made off-road caravan. 30 years of refinement.',
    showSpecial: '$3,000 accessory credit (Kimberley factory promotion)',
  },
  {
    name: 'Kimberley Kube',
    brand: 'Kimberley',
    slug: 'kube',
    tagline: 'Compact, capable, premium off-grid living. Couples and small families.',
    showSpecial: 'Show package - lock in 2026 pricing before July rises',
  },
  {
    name: 'Kimberley Kruiswagen',
    brand: 'Kimberley',
    slug: 'kruiswagen',
    tagline: 'The expedition motorhome. Self-contained, anywhere, any track.',
    showSpecial: 'Show special - ask Shane on the stand',
  },
  {
    name: 'Kimberley Kruiser T Class',
    brand: 'Kimberley',
    slug: 'kruiser-t',
    tagline: 'The luxury off-road caravan. Touring with everything you need.',
    showSpecial: 'Show package - lock in 2026 pricing before July rises',
  },
  {
    name: 'Kimberley Kruiser S Class',
    brand: 'Kimberley',
    slug: 'kruiser-s',
    tagline: 'The flagship. Apartment-grade interior in a true off-road shell.',
    showSpecial: 'Show package - lock in 2026 pricing before July rises',
  },
]

// Build QR code image URLs via qrserver.com (free public API, no auth, very
// reliable). PNG, 240x240 with high error correction so it still scans if
// the page is photographed at an angle. Phase 2: replace with build-time
// generated SVGs to remove the third-party dependency.
function qrUrl(targetUrl) {
  const encoded = encodeURIComponent(targetUrl)
  return `https://api.qrserver.com/v1/create-qr-code/?data=${encoded}&size=240x240&ecc=H&margin=0`
}

const faqs = [
  {
    q: 'Where will SEQ Campers be at the Brisbane Show?',
    a: `${venue}, Main Oval, stand ${standNumber}. Doors open Wednesday 3 June and we're on the floor through to Sunday 7 June. Free trains for ticket holders straight to the showgrounds.`,
  },
  {
    q: 'Can I scan a QR code on this page to start building my quote before the show?',
    a: 'Yes - on a desktop or laptop. Each caravan above has a QR code you can scan with your phone to jump straight into the spec builder. On mobile, tap the "Build your spec" button instead.',
  },
  {
    q: 'Which caravans are you bringing to the show?',
    a: 'Kimberley Kruiswagen (Mercedes 4x4 motorhome), Kimberley Karavan Eco Suite (with media release), Kimberley Kruiser T Class and S Class, plus Stockman Trekka and Stockman Rover. A full lineup across the Kimberley and Stockman ranges.',
  },
  {
    q: 'Can I book a private chat at the show?',
    a: 'Yes - and we recommend it. Show floors get busy. If you would like a focused 20-minute walk-through of any caravan in our stock, send through the contact form and we will lock in a time during the show.',
  },
  {
    q: 'Will there be show pricing?',
    a: 'Yes. Each brand on this page has a show special listed. We hold these back for visitors who come and see us in person - they are not listed elsewhere online.',
  },
  {
    q: 'I cannot make it to Brisbane. Can I still get show pricing?',
    a: 'Get in touch before or during the show and we will see what we can do. Show specials are easier to honour for buyers who can visit our Sunshine Coast showroom during the show week.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'SEQ Campers at the Brisbane Caravan, Camping & Touring Supershow 2026',
  startDate: '2026-06-03',
  endDate: '2026-06-07',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: 'Brisbane Showgrounds',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '600 Gregory Terrace',
      addressLocality: 'Bowen Hills',
      addressRegion: 'QLD',
      postalCode: '4006',
      addressCountry: 'AU',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'SEQ Campers',
    url: 'https://seqcampers.com.au',
  },
}
---

<Site
  title="Brisbane Caravan Show 2026"
  description="SEQ Campers at the Brisbane Caravan, Camping & Touring Supershow, 3-7 June 2026. Stand #2693 in the Main Oval. Build your spec for Kimberley Kampers and Stockman caravans, scan the QR codes, and lock in show-only pricing."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(eventSchema)} />

  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">Brisbane Show 2026</div>
      <h1>See us at the Brisbane Caravan Show.</h1>
      <p>{showDates} · {venue}</p>
    </div>
  </div>

  <!-- When / Where / Stand -->
  <section class="section" style="padding-bottom:24px;">
    <div class="container" style="max-width:980px;">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:18px;">
        <div style="background:#fff; border:1px solid var(--tan-border); border-radius:var(--radius); padding:22px;">
          <div class="page-eyebrow" style="color:var(--rust);">When</div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:1.15rem; font-weight:600; color:var(--ink);">{showDates}</div>
          <div style="margin-top:6px; color:var(--muted); font-size:0.88rem;">{showDays}</div>
        </div>
        <div style="background:#fff; border:1px solid var(--tan-border); border-radius:var(--radius); padding:22px;">
          <div class="page-eyebrow" style="color:var(--rust);">Where</div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:1.15rem; font-weight:600; color:var(--ink);">{venue}</div>
          <div style="margin-top:6px; color:var(--muted); font-size:0.88rem;">600 Gregory Tce, Bowen Hills · free trains for ticket holders</div>
        </div>
        <div style="background:#fff; border:1px solid var(--tan-border); border-radius:var(--radius); padding:22px;">
          <div class="page-eyebrow" style="color:var(--rust);">Find us</div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:1.6rem; font-weight:800; color:var(--ink); letter-spacing:-0.01em;">{standNumber}</div>
          <div style="margin-top:6px; color:var(--muted); font-size:0.88rem;">{standArea} · look for the SEQ Campers banner</div>
        </div>
      </div>

      <div style="margin-top:18px; background:#E8F5EC; border:1px solid #6BB893; border-left:4px solid #2BA85F; border-radius:8px; padding:14px 18px; color:#133D24; font-size:0.95rem; line-height:1.55;">
        <strong>Tip - free trains to the show:</strong> your Brisbane Caravan Supershow ticket also covers free Queensland Rail travel to Bowen Hills station (right at the Showgrounds gate). Save the parking fee, skip the traffic.
      </div>

      <div style="margin-top:12px; background:#FFF5EC; border:1px solid #F0CDA8; border-left:4px solid var(--rust); border-radius:8px; padding:14px 18px; color:#5A3818; font-size:0.92rem; line-height:1.55;">
        <strong>Showroom closed Saturday 6 June:</strong> the whole SEQ team is at the show floor. Drop in to the stand to see us, or call <a href={`tel:${podiumNumber.replace(/\s/g, '')}`} style="color:var(--rust); font-weight:600; text-decoration:none;">{podiumNumber}</a> for a text reply during show hours.
      </div>

      <div style="margin-top:12px; background:linear-gradient(135deg, #FFF1CC 0%, #FFE08A 100%); border:1px solid #E5B53C; border-left:5px solid #C0341A; border-radius:10px; padding:18px 22px; color:#3D2A05; line-height:1.55;">
        <div style="display:inline-block; background:#C0341A; color:#fff; font-size:0.72rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; padding:4px 10px; border-radius:4px; margin-bottom:8px;">Show floor exclusive</div>
        <div style="font-family:'Inter Tight', sans-serif; font-size:1.15rem; font-weight:700; color:#2A1608; margin-bottom:4px;">Stockman demo POD All-Roader - 20% off</div>
        <div style="font-size:0.94rem;">Our demo POD All-Roader is on the show floor with the rooftop tent already fitted - and it's <strong>20% off the standard price</strong> for any show-week buyer. One unit only. First in, best dressed.</div>
      </div>
    </div>
  </section>

  <!-- What we're bringing to the show -->
  <section class="section" style="padding-top:8px; padding-bottom:24px;">
    <div class="container" style="max-width:980px;">
      <div class="page-eyebrow" style="color:var(--rust); margin-bottom:8px;">On the stand</div>
      <h2 class="section-title" style="margin-bottom:18px;">Caravans we're bringing to Brisbane.</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:12px;">
        {showStock.map((c) => (
          <div style="background:#fff; border:1px solid var(--tan-border); border-radius:8px; padding:14px 16px;">
            <div style="font-family:'Inter Tight', sans-serif; font-weight:600; color:var(--ink); font-size:1.02rem;">{c.name}</div>
            <div style="color:var(--muted); font-size:0.85rem; margin-top:2px;">{c.detail}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Grand Slam show offer: value stack + countdown + scarcity + hold.
       Lives between the "when/where" cards and the brand QR grid so it
       lands before visitors start picking specific caravans. -->
  <section class="section" style="padding-top:24px; padding-bottom:24px;">
    <div class="container" style="max-width:980px;">
      <div style="margin-bottom:18px;">
        <div class="page-eyebrow" style="color:var(--rust);">Show inclusions</div>
        <h2 class="section-title" style="margin-top:6px;">What you get if you buy at the show.</h2>
        <p style="color:var(--muted); margin-top:10px; line-height:1.6;">
          Each item below is yours when you order a new caravan during the show. Offer also honoured for one week after the show closes (Sunday 14 June at 11pm) if you can't make it to Brisbane but can get to our Sunshine Coast showroom.
        </p>
      </div>

      <div class="show-offer-stats" style="margin-bottom:22px;">
        <div class="show-offer-stat show-offer-stat-countdown">
          <div class="show-offer-stat-label">Offer closes in</div>
          <div class="show-offer-stat-value" data-countdown={SHOW_EXPIRY_ISO}>--d --h --m --s</div>
        </div>
        <div class="show-offer-stat show-offer-stat-scarcity">
          <div class="show-offer-stat-label">Show vans available</div>
          <div class="show-offer-stat-value">{VANS_REMAINING} <span class="show-offer-stat-suffix">remaining</span></div>
        </div>
        <div class="show-offer-stat">
          <div class="show-offer-stat-label">Reserve with</div>
          <div class="show-offer-stat-value">${HOLD_AMOUNT} <span class="show-offer-stat-suffix">fully refundable</span></div>
        </div>
      </div>

      <div class="value-stack">
        {inclusions.map((item) => (
          <div class="value-stack-row">
            <div class="value-stack-tick" aria-hidden="true">✓</div>
            <div class="value-stack-body">
              <div class="value-stack-label">{item.label}</div>
              <div class="value-stack-note">{item.note}</div>
            </div>
            <div class="value-stack-price">${item.value.toLocaleString('en-AU')}</div>
          </div>
        ))}
      </div>

      <p style="text-align:center; margin-top:14px; font-size:0.86rem; color:var(--muted);">
        ${HOLD_AMOUNT} hold locks in show pricing and inclusions. Fully refundable if you change your mind by Friday 14 June 2026.
      </p>
    </div>
  </section>

  <!-- Hero quote-builder section: the centrepiece for the show -->
  <section class="section" style="background:var(--sand-deep); padding-top:48px;">
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:8px;">
        <div class="page-eyebrow" style="color:var(--rust);">Get show-ready</div>
        <h2 class="section-title">Build your spec before you arrive at the show.</h2>
      </div>
      <p style="text-align:center; max-width:680px; margin:0 auto 36px; color:var(--muted); line-height:1.65;">
        Pick a model below and lock in what you actually want before you walk onto the stand.
        <strong style="color:var(--ink);">On desktop:</strong> scan the QR code with your phone to keep building on the go.
        <strong style="color:var(--ink);">On mobile:</strong> tap the button to start.
      </p>

      <div class="qr-grid">
        {brandQuotes.map((b) => {
          const quoteUrl = `${QUOTE_BASE}/quote/${b.slug}`
          return (
            <div class="qr-card">
              <div class="qr-card-meta">
                <div class="qr-card-brand">{b.brand}</div>
                <h3 class="qr-card-name">{b.name}</h3>
                <p class="qr-card-tag">{b.tagline}</p>
                <div class="qr-card-special">
                  <span class="page-eyebrow" style="color:var(--gold); margin:0; display:block; margin-bottom:4px;">Show special</span>
                  {b.showSpecial}
                </div>
                <a href={`/quote/${b.slug}`} class="btn-primary qr-card-cta">Build your {b.brand} spec</a>
              </div>
              <div class="qr-card-qr" aria-hidden="false">
                <img
                  src={qrUrl(quoteUrl)}
                  alt={`QR code to build your ${b.name} spec on your phone`}
                  width="160"
                  height="160"
                  loading="lazy"
                />
                <div class="qr-card-qr-label">Scan with your phone</div>
              </div>
            </div>
          )
        })}
      </div>
    </div>
  </section>

  <!-- Why come / personal walkthrough -->
  <section class="section">
    <div class="container" style="max-width:840px;">
      <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.5rem; font-weight:600; color:var(--ink); margin-bottom:14px;">
        Why come and see us in person.
      </h2>
      <p style="color:var(--muted); line-height:1.75; margin-bottom:14px;">
        Online videos and a spec builder are a great way to start. But there is no substitute for opening every cupboard, running your hand
        along the joinery, and asking the awkward questions face-to-face. The Brisbane Show is the easiest way to do all of that in one place.
      </p>
      <p style="color:var(--muted); line-height:1.75; margin-bottom:32px;">
        Shane and the SEQ team will be on the stand for all five days, with a curated lineup of Kimberley Kampers and Stockman stock - including
        options set up for serious off-grid touring.
      </p>

      <div style="background:var(--ink); color:var(--sand); border-radius:var(--radius); padding:28px 32px; margin-bottom:32px;">
        <div class="page-eyebrow" style="color:var(--gold);">Skip the queue</div>
        <h3 style="color:var(--sand); font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; margin:8px 0 10px;">
          Reserve a private 20-minute show slot.
        </h3>
        <p style="color:var(--gold); margin-bottom:18px; line-height:1.6;">
          Show floors get busy. Lock in focused time with Shane to walk through a specific caravan and we will confirm a slot during the show.
          <strong style="display:block; margin-top:8px; color:#FFD699;">Heads-up: we won't be checking email at the show floor - send your slot request before Wednesday morning, or text {podiumNumber} during show hours.</strong>
        </p>
        <a href="/contact" class="btn-primary">Reserve a show slot</a>
      </div>

      <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.5rem; font-weight:600; color:var(--ink); margin-bottom:14px;">
        Can't make it to Brisbane?
      </h2>
      <p style="color:var(--muted); line-height:1.75; margin-bottom:14px;">
        No problem. Our Sunshine Coast showroom is open by appointment year-round - drive an hour north and you will get our
        undivided attention, no show-floor chaos required.
      </p>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:20px;">
        <a href="/stock" class="btn-primary">View current stock</a>
        <a href="/contact" class="btn-ghost" style="background:rgba(42,22,8,0.06); color:var(--ink); border-color:var(--tan-border);">Book a Sunshine Coast visit</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:var(--sand-deep); padding-top:40px;">
    <div class="container" style="max-width:840px;">
      <section class="faq-section" aria-label="Brisbane Show frequently asked questions" style="margin:0;">
        <div class="page-eyebrow" style="color:var(--rust);">Brisbane Show FAQ</div>
        <h2 class="faq-title">Common questions about the show</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-answer">{f.a}</div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </section>

  <!-- Countdown ticker for the show offer (above) -->
  <script is:inline define:vars={{ expiry: SHOW_EXPIRY_ISO }}>
    (function () {
      const el = document.querySelector('[data-countdown]')
      if (!el) return
      const target = new Date(expiry).getTime()
      function tick() {
        const diff = target - Date.now()
        if (diff <= 0) { el.textContent = 'Show offer closed'; return }
        const d = Math.floor(diff / (1000 * 60 * 60 * 24))
        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))
        const s = Math.floor((diff % (1000 * 60)) / 1000)
        el.textContent = d + 'd ' + h + 'h ' + m + 'm ' + s + 's'
      }
      tick()
      setInterval(tick, 1000)
    })()
  </script>
</Site>
