    }
    .qb-lock-form label {
      display: block;
      margin-bottom: 12px;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      color: var(--ink, #2A1608);
      font-size: 0.9rem;
    }
    .qb-lock-form input,
    .qb-lock-form select {
      display: block;
      width: 100%;
      margin-top: 6px;
      padding: 11px 13px;
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      border: 1px solid var(--tan-border, #DCCBA8);
      border-radius: 8px;
      background: var(--sand, #F4EDE0);
      color: var(--ink, #2A1608);
    }
    .qb-lock-form .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    @media (max-width: 460px) { .qb-lock-form .form-row { grid-template-columns: 1fr; } }
    .qb-lock-submit {
      width: 100%;
      padding: 14px 24px;
      font-size: 1.02rem;
      font-weight: 700;
      margin-top: 4px;
    }
    .qb-lock-fineprint {
      margin-top: 12px;
      text-align: center;
      color: var(--muted, #8B6A40);
      font-size: 0.82rem;
    }
  </style>
</Site>
