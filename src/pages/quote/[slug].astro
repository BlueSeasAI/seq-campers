---
import Site from '../../layouts/Site.astro'
import { quoteBrands, getQuoteBrand } from '../../data/quote-brands.js'

export async function getStaticPaths() {
  return quoteBrands.map((b) => ({ params: { slug: b.slug } }))
}

const { slug } = Astro.params
const brand = getQuoteBrand(slug)

if (!brand) return Astro.redirect('/stock')

const siteBase = (Astro.site ?? new URL('https://seqcampers.com.au')).href.replace(/\/$/, '')
const pageUrl = `${siteBase}/quote/${brand.slug}`
---

<Site
  title={`Build your ${brand.name} spec`}
  description={`Tell SEQ Campers what you want in your ${brand.name}. ${brand.showSpecial} Quick 60-second enquiry form - we will reply with a written quote within one business day.`}
>
  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">{brand.brandFamily} · Build your spec</div>
      <h1>{brand.name}</h1>
      <p>{brand.headline}</p>
    </div>
  </div>

  <section class="section" style="padding-top:48px; padding-bottom:24px;">
    <div class="container" style="max-width:760px;">

      <p style="color:var(--muted); font-size:1.05rem; line-height:1.75; margin-bottom:18px;">
        {brand.intro}
      </p>

      <div style="background:#fff; border:1px solid var(--tan-border); border-left:4px solid var(--gold); border-radius:var(--radius); padding:18px 22px; margin:24px 0 8px;">
        <div class="page-eyebrow" style="color:var(--gold); margin-bottom:6px;">Show special</div>
        <p style="color:var(--ink); font-weight:500; line-height:1.55; margin:0;">{brand.showSpecial}</p>
      </div>

      <p style="color:var(--muted); font-size:0.92rem; margin-top:14px;">
        Indicative pricing: <strong style="color:var(--ink);">{brand.indicativePrice}</strong>. Final quote includes
        any additional configuration we agree on - we will send the written quote within one business day.
      </p>

    </div>
  </section>

  <!-- Quote enquiry form (Netlify Forms - posts to sales@seqcampers.com.au)
       Reliable across all devices including iOS without configured mail clients.
       Single form-name "quote-enquiry" with hidden brand fields so we can
       configure ONE email notification in Netlify and route everywhere. -->
  <section class="section" style="padding-top:24px;">
    <div class="container" style="max-width:760px;">
      <div style="background:#fff; border:1px solid var(--tan-border); border-radius:var(--radius); padding:32px 36px; box-shadow:var(--shadow-sm);">
        <div class="page-eyebrow" style="color:var(--rust);">Send us your spec</div>
        <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.4rem; font-weight:600; color:var(--ink); margin:6px 0 8px;">
          Your spec, your way
        </h2>
        <p style="color:var(--muted); font-size:0.95rem; line-height:1.6; margin-bottom:24px;">
          Reply within one business day. Direct from Shane or the team - no call centre.
        </p>

        <form
          class="quote-form enquiry-form"
          name="quote-enquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/thanks/"
        >
          <!-- Required by Netlify Forms for static deploys -->
          <input type="hidden" name="form-name" value="quote-enquiry" />
          <p class="hp" style="display:none;">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <!-- Brand context (for routing + reply) -->
          <input type="hidden" name="brand_name" value={brand.name} />
          <input type="hidden" name="brand_slug" value={brand.slug} />
          <input type="hidden" name="page_url" value={pageUrl} />

          <div class="quote-fieldset">
            <div class="quote-fieldset-title">About you</div>

            <div class="quote-row">
              <label class="quote-field">
                <span>Your name</span>
                <input type="text" name="customer_name" required autocomplete="name" />
              </label>
              <label class="quote-field">
                <span>Phone</span>
                <input type="tel" name="customer_phone" required autocomplete="tel" placeholder="04xx xxx xxx" />
              </label>
            </div>
            <label class="quote-field">
              <span>Email</span>
              <input type="email" name="customer_email" required autocomplete="email" />
            </label>
          </div>

          <div class="quote-fieldset">
            <div class="quote-fieldset-title">Your build preferences (tick the closest)</div>

            {brand.keyChoices.map((q) => (
              <fieldset class="quote-choice">
                <legend>{q.label}</legend>
                <div class="quote-choice-options">
                  {q.options.map((opt) => (
                    <label class="quote-choice-option">
                      <input type="radio" name={`choice_${q.id}`} value={opt} />
                      <span>{opt}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}

            <label class="quote-field" style="margin-top:18px;">
              <span>Anything else we should know? (optional)</span>
              <textarea name="extra_notes" rows="3" placeholder="Tow vehicle details, timing, special requirements, trade-in van, anything we should factor in..."></textarea>
            </label>
          </div>

          <button type="submit" class="btn-primary quote-submit">
            Send my spec to SEQ Campers
          </button>

          <p style="font-size:0.78rem; color:var(--muted); margin-top:14px; text-align:center; line-height:1.5;">
            Submissions go directly to the SEQ Campers team. We reply within one business day.
          </p>
        </form>
      </div>

      <p style="text-align:center; margin-top:28px; color:var(--muted); font-size:0.92rem;">
        Prefer to chat? <a href="tel:0753707933" style="color:var(--rust); font-weight:600;">Call (07) 5370 7933</a> or
        <a href="/contact" style="color:var(--rust); font-weight:600;">book a Sunshine Coast visit</a>.
      </p>
    </div>
  </section>
</Site>
