---
import Site from '../../layouts/Site.astro'
import { quoteBuilders, getQuoteBuilder } from '../../data/quote-builders.js'
import { getSiteSettings, youtubeId, getQuoteBuilder as getSanityQuoteBuilder } from '../../lib/sanity.js'

export async function getStaticPaths() {
  return quoteBuilders.map((b) => ({ params: { slug: b.slug } }))
}

const { slug } = Astro.params

// Prices are editable in Sanity (Studio -> Configurator / quote prices). When a
// record exists we use it; otherwise we fall back to the code source of truth in
// quote-builders.js. getSanityQuoteBuilder reconstructs the EXACT same object
// shape, so the template + running-total calculator below are unchanged either
// way - the ONLY thing that swaps is where the numbers come from.
let brand = await getSanityQuoteBuilder(slug)
if (!brand) brand = getQuoteBuilder(slug)

if (!brand) return Astro.redirect('/stock')

const siteBase = (Astro.site ?? new URL('https://seqcampers.com.au')).href.replace(/\/$/, '')
const pageUrl = `${siteBase}/quote/${brand.slug}`
const firstVariantId = brand.variants[0]?.id

// Ex-factory location depends on the brand family. Kimberley Kampers
// builds in Ballina NSW. Stockman Products builds in Melbourne. Per
// Bart 8 Jun - "/quote/rover is ex-Melbourne, not Ballina".
const exFactoryLocation = brand.brandFamily === 'Stockman' ? 'Melbourne' : 'Ballina NSW'

// Per-model intro video. Always rendered - Sanity URL wins when set,
// otherwise we fall back to a sensible per-model default (same YouTube IDs
// used as the tile defaults on /new). Bart 16 Jun: "video placeholder
// must come BEFORE they choose their model on every build page".
const VIDEO_DEFAULTS = {
  'kruiswagen': { id: 'tozC7prVbOg', caption: null },
  'kruiser':    { id: 'xYf81xUZtNE', caption: null },
  'karavan':    { id: 'WwgapQt3xO4', caption: null },
  'kube':       { id: 'tozC7prVbOg', caption: null },
  'trekka':     { id: 'xYf81xUZtNE', caption: null },
  'rover':      { id: 'WwgapQt3xO4', caption: null },
  'pod':        { id: 'tozC7prVbOg', caption: null },
}

let introVideo = VIDEO_DEFAULTS[brand.slug] || { id: 'tozC7prVbOg', caption: null }
try {
  const settings = await getSiteSettings() || {}
  const slotKey = `quoteVideo_${brand.slug.replace(/-/g, '_')}`
  const slot = settings[slotKey]
  if (slot?.youtubeUrl) {
    const vid = youtubeId(slot.youtubeUrl)
    if (vid) introVideo = { id: vid, caption: slot.caption || null }
  }
} catch (err) {
  console.warn('Sanity unreachable for quote video:', err.message)
}
---

<Site
  title={`Build your ${brand.name}`}
  description={`Configure your ${brand.name} on the Sunshine Coast. Tell us who you are, build your spec, and we reply within one business day.`}
>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>{brand.name}</h1>
      <p>{brand.intro}</p>
    </div>
  </div>

  {brand.placeholderNote && (
    <section style="background:#FFF7EC; border-bottom:1px solid #E8D5A8; padding:14px 0;">
      <div class="container">
        <p style="margin:0; color:#7A4F1A; font-size:0.92rem; line-height:1.5;">{brand.placeholderNote}</p>
      </div>
    </section>
  )}

  <!-- Intro video block - always rendered (Sanity URL when set, sensible
       per-model default otherwise). Shown above the configurator per
       Bart 16 Jun: "video placeholder must come first, before they choose
       their model". Template applies to every model on /quote/{slug}. -->
  <section class="section" style="padding-top:32px; padding-bottom:8px;">
    <div class="container" style="max-width:920px;">
      <div class="quote-intro-video">
        <div class="quote-intro-media">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${introVideo.id}?autoplay=1&mute=1&loop=1&playlist=${introVideo.id}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0`}
            title={`${brand.name} walk-around`}
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen="false"
            tabindex="-1"
            inert
            loading="lazy"
          ></iframe>
        </div>
        {introVideo.caption && (
          <p class="quote-intro-caption">{introVideo.caption}</p>
        )}
      </div>
    </div>
  </section>

  <!-- Configurator wrapper - gets blurred until the lead-capture overlay
       is dismissed. data-locked starts as "true" and is flipped to "false"
       by the overlay submit handler in the inline script below. -->
  <div class="qb-wrap" data-qb-wrap data-locked="true">

    <!-- Step 1: choose model -->
    <section class="section" style="padding-top:32px; padding-bottom:24px;">
      <div class="container" style="max-width:1100px;">
        <div class="qb-step-eyebrow">Step 1 of 2</div>
        <h2 class="qb-step-title">Choose your model</h2>
        <div class="qb-variants" data-variants>
          {brand.variants.map((v, i) => (
            <label class={`qb-variant ${i === 0 ? 'qb-variant-selected' : ''}`} data-variant-id={v.id}>
              <input type="radio" name="variant" value={v.id} checked={i === 0} class="qb-variant-radio" />
              <div class="qb-variant-head">
                <h3 class="qb-variant-name">{v.name}</h3>
                <div class="qb-variant-price">${v.basePrice.toLocaleString('en-AU')}</div>
              </div>
              <p class="qb-variant-subtext">Ex-factory {exFactoryLocation}, incl. GST. Excludes dealer delivery + on-road costs.</p>
              <ul class="qb-variant-included">
                {v.included.map((feature) => <li>{feature}</li>)}
              </ul>
            </label>
          ))}
        </div>
      </div>
    </section>

    <!-- Step 2: options + running total -->
    <section class="section" style="background:var(--sand-deep); padding-top:32px; padding-bottom:32px;">
      <div class="container" style="max-width:1100px;">
        <div class="qb-step-eyebrow">Step 2 of 2</div>
        <h2 class="qb-step-title">Add options & accessories</h2>
        <p style="color:var(--muted); margin-bottom:18px; max-width:680px;">
          Tick what you want. Open each section to expand. Items marked "Included" come with the variant you chose; "POA" means we'll confirm pricing on request.
        </p>

        <div class="qb-options-grid">
          <div class="qb-options" data-options-root>
            {brand.categories.map((cat) => (
              <details class="qb-cat" open>
                <summary class="qb-cat-summary">
                  <span>{cat.title}</span>
                  <span class="qb-cat-icon" aria-hidden="true">+</span>
                </summary>
                <div class="qb-cat-body">
                  {cat.options.map((opt) => {
                    const pricePerVariant = brand.variants.reduce((acc, v) => {
                      const p = opt.priceByVariant ? opt.priceByVariant[v.id] : opt.price
                      acc[v.id] = p
                      return acc
                    }, {})
                    return (
                      <label class="qb-opt" data-opt-id={opt.id} data-price-by-variant={JSON.stringify(pricePerVariant)}>
                        <input type="checkbox" class="qb-opt-check" />
                        <div class="qb-opt-body">
                          <div class="qb-opt-label">{opt.label}</div>
                          {opt.note && <div class="qb-opt-note">{opt.note}</div>}
                        </div>
                        <div class="qb-opt-price" data-opt-price-display></div>
                      </label>
                    )
                  })}
                </div>
              </details>
            ))}
          </div>

          <aside class="qb-summary" data-summary>
            <div class="qb-summary-inner">
              <div class="qb-summary-eyebrow">Your quote so far</div>
              <div class="qb-summary-variant" data-summary-variant>Pick a model</div>
              <div class="qb-summary-base">
                <span>Base</span>
                <strong data-summary-base>$0</strong>
              </div>
              <div class="qb-summary-options-line">
                <span>Options (<span data-summary-count>0</span>)</span>
                <strong data-summary-options>+$0</strong>
              </div>
              {!brand.onRoad && (
                <div class="qb-summary-options-line" data-flat-delivery>
                  <span>Dealer delivery <small style="color:var(--muted); font-size:0.78rem;">(subj. to fuel surcharge)</small></span>
                  <strong data-summary-delivery>+$3,500</strong>
                </div>
              )}
              <!-- On-road costs as ONE combined line (Kruiswagen motorhome):
                   stamp duty + rego/CTP + dealer delivery rolled into a single
                   figure so the customer sees one price, not three. The small
                   note explains why the number is large (it's all-in). -->
              {brand.onRoad && (
                <div class="qb-summary-options-line">
                  <span>Dealer delivery &amp; on-road <small style="color:var(--muted); font-size:0.78rem;">(incl. stamp duty + rego)</small></span>
                  <strong data-onroad-total>+$0</strong>
                </div>
              )}
              <div class="qb-summary-total">
                <span>Indicative driveaway</span>
                <strong data-summary-total>$0</strong>
              </div>
              <!-- Weight & payload panel - only shown for models that carry a
                   weight{} config + per-variant tare (the Kruiswagen). -->
              <div class="qb-weight" data-weight-block hidden>
                <div class="qb-weight-title">Weight &amp; payload</div>
                <div class="qb-weight-row">
                  <span>Est. TARE (dry, fitted)</span>
                  <strong data-weight-tare>&mdash;</strong>
                </div>
                <div class="qb-weight-row">
                  <span>GVM limit</span>
                  <strong data-weight-gvm>&mdash;</strong>
                </div>
                <div class="qb-weight-row">
                  <span>Gross payload</span>
                  <strong data-weight-gross>&mdash;</strong>
                </div>
                <div class="qb-weight-deductions" data-weight-deductions></div>
                <div class="qb-weight-row qb-weight-payload-row">
                  <span>Ready-to-travel payload</span>
                  <strong data-weight-payload>&mdash;</strong>
                </div>
                <div class="qb-weight-status" data-weight-status></div>
                <p class="qb-weight-note">Weights are indicative only &mdash; confirm with your dealer.</p>
              </div>
              <p class="qb-summary-fineprint" data-fineprint>
                Indicative only. Final quote confirmed by SEQ Campers within one business day. Ex-factory {exFactoryLocation}, incl. GST.
              </p>
              <a href="#qb-finish" class="btn-primary qb-summary-cta">Finish + send to me ↓</a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Final commit step - no details form; we already have them from
         the overlay. This step is just the submit action + share buttons. -->
    <section id="qb-finish" class="section" style="padding-top:32px; padding-bottom:48px;">
      <div class="container" style="max-width:780px;">
        <div class="qb-step-eyebrow">Send it through</div>
        <h2 class="qb-step-title">Lock in your spec</h2>
        <p style="color:var(--muted); margin-bottom:24px; max-width:600px;">
          We'll send the indicative quote to your email and Shane or the team will follow up within one business day. No call centre.
        </p>

        <form
          class="enquiry-form"
          name="build-page-quote-request"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/thanks/"
          data-qb-form
          data-ajax-skip
        >
          <input type="hidden" name="form-name" value="build-page-quote-request" />
          <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <!-- All lead + spec context (populated by JS at submit time) -->
          <input type="hidden" name="brand_name" value={brand.name} />
          <input type="hidden" name="brand_slug" value={brand.slug} />
          <input type="hidden" name="page_url" value={pageUrl} />
          <input type="hidden" name="lead_first_name" data-hidden-first-name />
          <input type="hidden" name="lead_last_name" data-hidden-last-name />
          <input type="hidden" name="lead_email" data-hidden-email />
          <input type="hidden" name="lead_phone" data-hidden-phone />
          <input type="hidden" name="lead_intent" data-hidden-intent />
          <input type="hidden" name="variant_name" data-hidden-variant-name />
          <input type="hidden" name="variant_base_price" data-hidden-variant-base />
          <input type="hidden" name="selected_options" data-hidden-options />
          <input type="hidden" name="total_indicative_price" data-hidden-total />
          <!-- Deep link back into this exact spec (?v=&o=&shared=1). Goes in
               the customer's quote email so they can reopen and change it. -->
          <input type="hidden" name="spec_url" data-hidden-spec-url />

          <label>
            Anything else you'd like us to know? (optional)
            <textarea name="message" rows="3" placeholder="Timing, trade-in van, finance questions, anything else..."></textarea>
          </label>

          <div class="qb-actions">
            <button type="submit" class="btn-primary qb-submit">Email me my quote →</button>
            <button type="button" class="qb-share" data-qb-share-email>
              <span aria-hidden="true">✉</span> Share by email
            </button>
            <button type="button" class="qb-share" data-qb-share>
              <span aria-hidden="true">↗</span> Copy share link
            </button>
          </div>

          <p class="qb-share-help" data-share-help hidden>
            Share link copied to your clipboard. Paste it in a text, message or email to send this exact spec to your partner or family.
          </p>
        </form>
      </div>
    </section>

  </div>
  <!-- /qb-wrap -->

  <!-- LEAD-CAPTURE OVERLAY (Tell us who you are first) -->
  <div class="qb-lock" data-qb-lock>
    <div class="qb-lock-scrim" aria-hidden="true"></div>
    <div class="qb-lock-card" role="dialog" aria-modal="true" aria-labelledby="qb-lock-title">
      <div class="qb-lock-eyebrow">First things first</div>
      <h2 id="qb-lock-title" class="qb-lock-title">Hey - who are we building this for?</h2>
      <p class="qb-lock-sub">
        We'll save your build to your email so you can come back to it any time. Quick three-question hello so we can serve you properly when you arrive at our Sunshine Coast showroom.
      </p>

      <form
        class="qb-lock-form"
        name="build-page-lead-capture"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
        data-qb-lock-form
        data-ajax-skip
      >
        <input type="hidden" name="form-name" value="build-page-lead-capture" />
        <input type="hidden" name="brand_name" value={brand.name} />
        <input type="hidden" name="brand_slug" value={brand.slug} />
        <input type="hidden" name="page_url" value={pageUrl} />
        <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <label>
            First name
            <input type="text" name="first_name" required autocomplete="given-name" placeholder="First" />
          </label>
          <label>
            Last name
            <input type="text" name="last_name" required autocomplete="family-name" placeholder="Last" />
          </label>
        </div>

        <div class="form-row">
          <label>
            Email
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </label>
          <label>
            Mobile
            <input type="tel" name="phone" required autocomplete="tel" placeholder="04xx xxx xxx" />
          </label>
        </div>

        <label>
          Where are you at?
          <select name="intent" required>
            <option value="">-- Pick one --</option>
            <option value="just-browsing">Just browsing for now</option>
            <option value="researching">Researching - 1 to 3 months out</option>
            <option value="serious">Serious - looking to buy soon</option>
            <option value="ready">Ready to lock something in</option>
          </select>
        </label>

        <button type="submit" class="btn-primary qb-lock-submit">Start building →</button>

        <p class="qb-lock-fineprint">
          We'll never spam you. Your build is saved to your email so you can pick up where you left off.
        </p>
      </form>
    </div>
  </div>

  <!-- Configurator JS - lock overlay state, variant/option price updates,
       share & submit serialisation, hidden-field population. -->
  <script is:inline define:vars={{ brandData: brand, firstVariantId, pageUrl }}>
    (function () {
      const variantData = {}
      brandData.variants.forEach((v) => { variantData[v.id] = v })

      // Option metadata (requires / blockedBy / notes) keyed by option id.
      // Only the Rover defines these; other models leave them undefined and
      // fall straight through to the original availability logic below.
      const optMeta = {}
      brandData.categories.forEach((c) => c.options.forEach((o) => { optMeta[o.id] = o }))

      let currentVariant = firstVariantId
      const selected = new Set()
      const lead = { first_name: '', last_name: '', email: '', phone: '', intent: '' }

      const $ = (sel) => document.querySelector(sel)
      const $$ = (sel) => Array.from(document.querySelectorAll(sel))

      const fmt = (n) => '$' + Math.abs(n).toLocaleString('en-AU')
      const fmtSigned = (n) => (n < 0 ? '-' : '+') + fmt(n)

      // ─── LOCK OVERLAY ─────────────────────────────────────────────
      // Per Shane (16 Jun) - the configurator is blurred until the
      // visitor identifies themselves. Once submitted we cache the lead
      // in sessionStorage so they don't get gated again this session.
      // Bypass paths: ?shared=1 or ?v= in URL (someone shared a spec).
      const STORE_KEY = 'seq_lead_unlocked_v1'
      const wrap = document.querySelector('[data-qb-wrap]')
      const lock = document.querySelector('[data-qb-lock]')
      const lockForm = document.querySelector('[data-qb-lock-form]')

      const urlParams = new URLSearchParams(window.location.search)
      const sharedView = urlParams.get('shared') === '1' || !!urlParams.get('v')
      let unlocked = false

      try {
        const cached = JSON.parse(sessionStorage.getItem(STORE_KEY) || 'null')
        if (cached && cached.email) {
          Object.assign(lead, cached)
          unlocked = true
        }
      } catch (err) { /* ignore */ }

      function applyLockState() {
        if (unlocked || sharedView) {
          wrap.dataset.locked = 'false'
          lock.style.display = 'none'
        } else {
          wrap.dataset.locked = 'true'
          lock.style.display = 'flex'
        }
      }
      applyLockState()

      // Intercept the lock form submit - POST to Netlify, then unlock
      // without navigating away. We submit the form via fetch so the
      // visitor stays on the page and the build flow continues.
      if (lockForm) {
        lockForm.addEventListener('submit', async (e) => {
          e.preventDefault()
          const fd = new FormData(lockForm)
          lead.first_name = fd.get('first_name') || ''
          lead.last_name = fd.get('last_name') || ''
          lead.email = fd.get('email') || ''
          lead.phone = fd.get('phone') || ''
          lead.intent = fd.get('intent') || ''

          // Cache for the rest of the session so they don't get gated again
          try { sessionStorage.setItem(STORE_KEY, JSON.stringify(lead)) } catch (err) { /* ignore */ }

          // Submit to Netlify Forms in the background. Convert FormData
          // to URLSearchParams to match Netlify's expected encoding.
          try {
            // This form carries data-ajax-skip, so the layout's submit-time
            // force-set of the page-tracking fields does not run for it. Set
            // them here or Maud loses the "which page did this come from"
            // column in the Netlify dashboard.
            fd.set('source_page_url', window.location.href)
            fd.set('source_page_title', document.title || '')
            const body = new URLSearchParams()
            for (const [k, v] of fd.entries()) body.set(k, v)
            await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body })
          } catch (err) {
            console.warn('Lead submit failed:', err)
          }

          unlocked = true
          applyLockState()
        })
      }

      // ─── QUOTE SUBMIT ─────────────────────────────────────────────
      // Two things have to happen on submit and they are not equal in
      // importance:
      //   1. The Netlify Forms post. This is the system of record and the
      //      thing that notifies sales@. It must never be put at risk.
      //   2. The customer's own copy of the quote, via /api/quote-email.
      //      Additive. If it fails the lead is still captured.
      //
      // So: post to Netlify first and only continue once that has landed.
      // If THAT fails we fall straight back to a native form submit, which
      // is exactly the behaviour the page had before this handler existed.
      // The customer email is then fired on its own, and a failure there is
      // logged and swallowed rather than shown to the visitor, because from
      // their side the enquiry did go through.
      const quoteForm = document.querySelector('[data-qb-form]')
      if (quoteForm) {
        let submitting = false

        quoteForm.addEventListener('submit', async (e) => {
          if (submitting) return
          e.preventDefault()
          submitting = true

          const btn = quoteForm.querySelector('.qb-submit')
          const btnLabel = btn ? btn.textContent : ''
          if (btn) {
            btn.disabled = true
            btn.textContent = 'Sending your quote...'
          }

          const fd = new FormData(quoteForm)
          // data-ajax-skip means the layout no longer force-sets these at
          // submit time, so do it here, before the payload is built.
          fd.set('source_page_url', window.location.href)
          fd.set('source_page_title', document.title || '')
          const payload = {}
          for (const [k, v] of fd.entries()) payload[k] = v

          // 1. Netlify Forms. Non-negotiable.
          let recorded = false
          try {
            const body = new URLSearchParams()
            for (const [k, v] of fd.entries()) body.set(k, v)
            const res = await fetch('/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body,
            })
            recorded = res.ok
          } catch (err) {
            console.warn('Quote submit failed, falling back to native post:', err)
          }

          if (!recorded) {
            // Let the browser do it the old way. Do not re-enter this handler.
            if (btn) { btn.disabled = false; btn.textContent = btnLabel }
            quoteForm.submit()
            return
          }

          // 2. The customer's copy. Best effort, and capped at 6s so a slow
          //    or unhappy mail provider cannot leave someone sitting on a
          //    disabled button. The request keeps running past the cap; we
          //    just stop waiting on it before moving them along.
          try {
            const send = fetch('/api/quote-email', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            }).catch((err) => { console.warn('Quote email request failed:', err) })
            await Promise.race([send, new Promise((r) => setTimeout(r, 6000))])
          } catch (err) {
            console.warn('Quote email request failed:', err)
          }

          window.location.href = '/thanks/?sent=quote'
        })
      }

      // ─── PRICE LOGIC ──────────────────────────────────────────────
      function getOptionPrice(optEl, variantId) {
        const map = JSON.parse(optEl.dataset.priceByVariant || '{}')
        return map[variantId]
      }

      // An option's prerequisite counts as "present" if it is included on the
      // current variant (price 0) or the visitor has it ticked.
      function isPresent(optId) {
        const el = document.querySelector('.qb-opt[data-opt-id="' + optId + '"]')
        if (!el) return false
        return getOptionPrice(el, currentVariant) === 0 || selected.has(optId)
      }

      function renderOptionPrices() {
        $$('.qb-opt').forEach((optEl) => {
          const optId = optEl.dataset.optId
          const meta = optMeta[optId] || {}
          const display = optEl.querySelector('[data-opt-price-display]')
          const check = optEl.querySelector('.qb-opt-check')
          const p = getOptionPrice(optEl, currentVariant)

          const apply = (unavail, text, disabled) => {
            optEl.classList.toggle('qb-opt-unavailable', unavail)
            display.textContent = text
            check.disabled = disabled
            if (disabled) { check.checked = false; selected.delete(optId) }
          }

          if (p === null || p === undefined) { apply(true, meta.naNote || 'N/A', true); return }
          if (p === 0) { apply(false, 'Included', false); return }

          // Priced option - apply dynamic dependency rules (Rover only).
          const blocked = (meta.blockedBy || []).some((dep) => isPresent(dep))
          if (blocked) { apply(true, meta.blockedNote || 'N/A', true); return }
          const missing = (meta.requires || []).some((dep) => !isPresent(dep))
          if (missing) { apply(true, meta.depNote || 'Locked', true); return }

          if (p === 'POA') apply(false, 'POA', false)
          else if (p < 0) apply(false, fmtSigned(p) + ' credit', false)
          else apply(false, fmtSigned(p), false)
        })
      }

      // ─── DELIVERY / ON-ROAD COSTS ─────────────────────────────────
      // Most models carry a flat dealer-delivery number (variant.delivery,
      // then brand.delivery, then $3,500). The Kruiswagen is a registered
      // motor vehicle, so it instead carries an onRoad{} config and the
      // delivery line becomes a sliding stamp-duty + rego + delivery total
      // that moves with the build price. See quote-builders.js.
      const DEFAULT_DELIVERY = 3500
      const onRoad = brandData.onRoad || null
      const weightCfg = brandData.weight || null

      function flatDeliveryFor(variantId) {
        const v = variantData[variantId]
        if (v && typeof v.delivery === 'number') return v.delivery
        if (typeof brandData.delivery === 'number') return brandData.delivery
        return DEFAULT_DELIVERY
      }

      // Returns { stamp, rego, delivery, total } for onRoad models.
      function onRoadFor(unitTotal) {
        const stamp = Math.round((onRoad.stampDutyRate || 0) * unitTotal)
        const rego = onRoad.registration || 0
        const delivery = onRoad.dealerDelivery || 0
        return { stamp, rego, delivery, total: stamp + rego + delivery }
      }

      // One-time visibility setup (Kruiswagen only) - swap the flat delivery
      // line for the itemised on-road block, reveal the weight panel, and
      // correct the fineprint (this model INCLUDES stamp duty + rego).
      if (onRoad) {
        // The flat delivery line and the single on-road line are both
        // server-rendered conditionally, so there is nothing to show/hide
        // here. Just correct the fineprint - this model rolls stamp duty +
        // rego + delivery into the one driveaway figure.
        const fineprint = $('[data-fineprint]')
        if (fineprint) fineprint.textContent =
          'Indicative driveaway - includes 5% stamp duty, registration/CTP & fees, and dealer delivery & handover. Final quote confirmed by SEQ Campers within one business day. Incl. GST.'
      }
      if (weightCfg) {
        const wb = $('[data-weight-block]')
        if (wb) wb.hidden = false
      }

      // ─── WEIGHT / GVM PAYLOAD (weight{} models only) ──────────────
      function renderWeight(v) {
        const w = weightCfg
        const baseTare = typeof v.tare === 'number' ? v.tare : 0

        // Hardware weight: add an option's kg only when it is a genuine paid
        // add for this variant (price > 0). Included items (price 0) are
        // already inside baseTare, so they never double-count.
        let added = 0
        $$('.qb-opt').forEach((optEl) => {
          const id = optEl.dataset.optId
          if (!selected.has(id)) return
          const p = getOptionPrice(optEl, currentVariant)
          if (typeof p === 'number' && p > 0) added += (w.weights[id] || 0)
        })
        const estTare = Math.round(baseTare + added)

        const hasGvmKit = isPresent(w.gvmOptionId)
        const gvm = hasGvmKit ? w.upgradedGvm : w.baseGvm
        const grossPayload = gvm - estTare

        // Consumables: count when the tank is PRESENT (Included or ticked) -
        // TARE is dry, so full tanks add on top.
        let fuel = w.fuelBase
        ;(w.fuelExtra || []).forEach((f) => { if (isPresent(f.optId)) fuel += f.kg })
        let water = w.waterBase
        ;(w.waterExtra || []).forEach((wt) => { if (isPresent(wt.optId)) water += wt.kg })
        const travelLoad = w.passengers + fuel + water
        const readyPayload = Math.round(grossPayload - travelLoad)

        const kg = (n) => Math.round(n).toLocaleString('en-AU') + 'kg'
        $('[data-weight-tare]').textContent = kg(estTare)
        $('[data-weight-gvm]').textContent = kg(gvm) + (hasGvmKit ? ' (upgraded)' : '')
        $('[data-weight-gross]').textContent = (grossPayload < 0 ? '-' : '') + kg(Math.abs(grossPayload))
        $('[data-weight-deductions]').textContent =
          'less 2 passengers (' + Math.round(w.passengers) + 'kg), full fuel (' + Math.round(fuel) + 'kg), full water (' + Math.round(water) + 'kg)'
        $('[data-weight-payload]').textContent = (readyPayload < 0 ? '-' : '') + kg(Math.abs(readyPayload))

        const statusEl = $('[data-weight-status]')
        const block = $('[data-weight-block]')
        block.classList.remove('qb-weight-ok', 'qb-weight-warn', 'qb-weight-over')
        if (readyPayload >= 0) {
          block.classList.add('qb-weight-ok')
          statusEl.textContent = 'Within GVM - ' + kg(readyPayload) + ' of payload to spare for your gear.'
        } else if (!hasGvmKit) {
          block.classList.add('qb-weight-warn')
          statusEl.textContent = 'Over GVM by ' + kg(Math.abs(readyPayload)) + '. Add the GVM Upgrade Kit (needs the KK Alloy Off-Road Wheels first) to lift your legal limit to 4,430kg.'
        } else {
          block.classList.add('qb-weight-over')
          statusEl.textContent = 'Over GVM by ' + kg(Math.abs(readyPayload)) + ' even with the upgrade. Remove some heavy options or reduce your load.'
        }
      }

      function renderSummary() {
        const v = variantData[currentVariant]
        $('[data-summary-variant]').textContent = v.name
        $('[data-summary-base]').textContent = fmt(v.basePrice)

        let optionsTotal = 0
        let count = 0
        $$('.qb-opt').forEach((optEl) => {
          if (selected.has(optEl.dataset.optId)) {
            const p = getOptionPrice(optEl, currentVariant)
            if (typeof p === 'number') optionsTotal += p
            count++
          }
        })
        $('[data-summary-count]').textContent = count
        $('[data-summary-options]').textContent = fmtSigned(optionsTotal)

        // Delivery / on-road line(s)
        const unitTotal = v.basePrice + optionsTotal
        let delivery
        if (onRoad) {
          const r = onRoadFor(unitTotal)
          delivery = r.total
          $('[data-onroad-total]').textContent = fmtSigned(r.total)
        } else {
          delivery = flatDeliveryFor(currentVariant)
          $('[data-summary-delivery]').textContent = fmtSigned(delivery)
        }
        const grandTotal = unitTotal + delivery
        $('[data-summary-total]').textContent = fmt(grandTotal)

        if (weightCfg) renderWeight(v)

        // Sync hidden fields on the final commit form
        $('[data-hidden-variant-name]').value = v.name
        $('[data-hidden-variant-base]').value = v.basePrice
        $('[data-hidden-total]').value = grandTotal
        $('[data-hidden-first-name]').value = lead.first_name
        $('[data-hidden-last-name]').value = lead.last_name
        $('[data-hidden-email]').value = lead.email
        $('[data-hidden-phone]').value = lead.phone
        $('[data-hidden-intent]').value = lead.intent
        const selectedOptList = $$('.qb-opt')
          .filter((el) => selected.has(el.dataset.optId))
          .map((el) => {
            const label = el.querySelector('.qb-opt-label').textContent.trim()
            const price = getOptionPrice(el, currentVariant)
            const priceStr = price === 'POA' ? 'POA' : (typeof price === 'number' ? '$' + price : '?')
            return `${label} (${priceStr})`
          })
        $('[data-hidden-options]').value = selectedOptList.join(' | ')

        // Deep link back into this exact spec. Same shape the share buttons
        // produce, so the quote email reopens the configurator pre-filled and
        // past the lock overlay.
        const specParams = new URLSearchParams()
        specParams.set('v', currentVariant)
        if (selected.size) specParams.set('o', Array.from(selected).join(','))
        specParams.set('shared', '1')
        $('[data-hidden-spec-url]').value = pageUrl + '?' + specParams.toString()
      }

      // Variant change
      $$('.qb-variant').forEach((vEl) => {
        vEl.addEventListener('click', (e) => {
          if (e.target.tagName === 'A') return
          const newVariant = vEl.dataset.variantId
          if (newVariant === currentVariant) return
          currentVariant = newVariant
          $$('.qb-variant').forEach((el) => el.classList.toggle('qb-variant-selected', el.dataset.variantId === newVariant))
          vEl.querySelector('input[type=radio]').checked = true
          renderOptionPrices()
          renderSummary()
        })
      })

      // Option toggle
      $$('.qb-opt-check').forEach((cb) => {
        cb.addEventListener('change', () => {
          const optEl = cb.closest('.qb-opt')
          if (cb.checked) selected.add(optEl.dataset.optId)
          else selected.delete(optEl.dataset.optId)
          renderOptionPrices()
          renderSummary()
        })
      })

      // Share helpers
      function buildShare() {
        const params = new URLSearchParams()
        params.set('v', currentVariant)
        if (selected.size) params.set('o', Array.from(selected).join(','))
        params.set('shared', '1')
        const shareUrl = pageUrl + '?' + params.toString()
        const v = variantData[currentVariant]
        const total = $('[data-summary-total]').textContent
        const lines = []
        lines.push(`Have a look at this ${v.name} spec I am thinking about from SEQ Campers.`)
        lines.push('')
        lines.push(`Indicative total: ${total}`)
        if (selected.size) {
          lines.push('')
          lines.push('Options I have ticked:')
          $$('.qb-opt').forEach((el) => {
            if (selected.has(el.dataset.optId)) {
              lines.push('- ' + el.querySelector('.qb-opt-label').textContent.trim())
            }
          })
        }
        lines.push('')
        lines.push(`Open the live spec (you can tweak it): ${shareUrl}`)
        return { shareUrl, shareText: lines.join('\n'), brandName: brandData.name, variantName: v.name }
      }

      $('[data-qb-share]').addEventListener('click', async () => {
        const { shareUrl, shareText, brandName } = buildShare()
        if (navigator.share) {
          try {
            await navigator.share({ title: `${brandName} spec - SEQ Campers`, text: shareText, url: shareUrl })
            return
          } catch (err) { /* user cancelled, fall through */ }
        }
        try {
          await navigator.clipboard.writeText(shareText)
          $('[data-share-help]').hidden = false
          setTimeout(() => { $('[data-share-help]').hidden = true }, 6000)
        } catch (err) {
          window.location.href = 'mailto:?subject=' + encodeURIComponent(`${brandName} spec - SEQ Campers`) + '&body=' + encodeURIComponent(shareText)
        }
      })

      $('[data-qb-share-email]').addEventListener('click', () => {
        const { shareText, variantName } = buildShare()
        const subject = `${variantName} spec - SEQ Campers`
        const mailto = 'mailto:?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(shareText)
        window.location.href = mailto
      })

      // Parse URL params (shared-spec view)
      const urlVariant = urlParams.get('v')
      if (urlVariant && variantData[urlVariant]) {
        currentVariant = urlVariant
        $$('.qb-variant').forEach((el) => {
          el.classList.toggle('qb-variant-selected', el.dataset.variantId === urlVariant)
          el.querySelector('input[type=radio]').checked = (el.dataset.variantId === urlVariant)
        })
      }
      const urlOptions = urlParams.get('o')
      if (urlOptions) {
        urlOptions.split(',').forEach((optId) => {
          const optEl = document.querySelector(`.qb-opt[data-opt-id="${optId}"]`)
          if (optEl) {
            const cb = optEl.querySelector('.qb-opt-check')
            if (!cb.disabled) { cb.checked = true; selected.add(optId) }
          }
        })
      }

      renderOptionPrices()
      renderSummary()
    })()
  </script>

