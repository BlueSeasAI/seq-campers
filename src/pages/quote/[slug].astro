      border: 1px solid var(--tan-border, #DCCBA8);
    }
    .quote-intro-media iframe {
      position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
    }
    .quote-intro-caption {
      margin-top: 10px;
      text-align: center;
      color: var(--muted, #8B6A40);
