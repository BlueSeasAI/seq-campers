---
import Site from '../layouts/Site.astro'
import CaravanCard from '../components/CaravanCard.astro'
import VideoCard from '../components/VideoCard.astro'
import { getFeaturedCaravans, getFeaturedVideos, getSiteSettings, sanityImage, conditionLabel } from '../lib/sanity.js'

let featured = []
let featuredVideos = []
let settings = null
try {
  ;[featured, featuredVideos, settings] = await Promise.all([
    getFeaturedCaravans(),
    getFeaturedVideos(3),
    getSiteSettings(),
  ])
} catch (err) {
  console.warn('Sanity unreachable on build:', err.message)
}

// Placeholder videos for home grid until Maud marks any video as Featured
const PLACEHOLDER_VIDEO = 'https://www.youtube.com/watch?v=dQw4w9WcXgQ'
if (!featuredVideos || featuredVideos.length === 0) {
  featuredVideos = [
    { _id: 'p1', title: 'The New 2026 Stockman Rover 02 is Here!', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Every upgrade, every improvement - Shane walks you through it all.', category: 'deep-dive' },
    { _id: 'p2', title: 'Can a Mercedes Van Handle Deep Mud?', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Testing the Kimberley Kruiswagen where it\'s supposed to go.', category: 'on-the-road' },
    { _id: 'p3', title: 'Touring the Sleek "Night Storm" Interior', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Luxury finishes, Corian benchtops, and dimmable lighting.', category: 'deep-dive' },
  ]
}

// Shane's Pick - resolve from siteSettings, fall back to first featured caravan
const shanesPick = settings?.shanesPick?.caravan
  ? {
      caravan: settings.shanesPick.caravan,
      originalPrice: settings.shanesPick.originalPrice,
      quote: settings.shanesPick.shanesQuote,
      isPlaceholder: false,
    }
  : (featured[0]
      ? {
          caravan: featured[0],
          originalPrice: null,
          quote: 'One of the best examples we\'ve had through the lot. Full service history, immaculate condition - the kind of caravan I\'d happily hand the keys to a family member on.',
          isPlaceholder: true,
        }
      : null)

const upcomingNews = [
  { date: '10 May', type: 'New Arrival', title: 'New Stockman Rover 02 arrival', body: 'The 2026 model is in the showroom. Come see the upgrades in person.' },
  { date: '17 May', type: 'Handover', title: 'Mitchell family handover', body: 'Another family heading out on their first big trip. Safe travels!' },
  { date: '07 Jun', type: 'Event', title: 'Suncoast Outdoor Adventure Expo', body: 'Live walkthroughs and exclusive show pricing.' },
]

// LocalBusiness schema - tells Google/AI "we are an Australian caravan dealer"
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': 'https://seqcampers.com.au/#business',
  name: 'SEQ Campers',
  description: "Premium off-road caravan dealer on the Sunshine Coast, Queensland. Hand-picked Kimberley Kampers and Stockman stock. Thirty years in the industry.",
  url: 'https://seqcampers.com.au',
  telephone: '+61-7-5370-7933',
  email: 'office@seqcampers.com.au',
  areaServed: { '@type': 'State', name: 'Queensland, Australia' },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'QLD',
    addressCountry: 'AU',
  },
  openingHours: 'Mo-Sa 08:00-17:00',
  priceRange: '$$$',
  knowsAbout: ['Kimberley Kampers', 'Stockman Caravans', 'Off-road caravans', 'Caravan inspections', 'Sunshine Coast caravan dealer'],
  sameAs: ['https://www.youtube.com/channel/UCOeiI-wxOLUCX1UzMiE6XVg'],
}

// FAQ schema - direct answers AI search engines can quote
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What brands of caravan does SEQ Campers stock?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers specialises in premium off-road caravans from Kimberley Kampers and Stockman Caravans. Every van on the lot is hand-picked, inspected, and prepared by Shane and the SEQ team before it goes on sale.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is SEQ Campers located?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers operates from the Sunshine Coast in Queensland, Australia. Visits are by appointment. Call (07) 5370 7933 to book a time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are SEQ Campers caravans inspected before sale?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Shane personally inspects every caravan that comes through SEQ Campers. We have on-site mechanics, roadworthy inspections, and full pre-delivery preparation as part of the sale process.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long has SEQ Campers been operating?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "SEQ Campers has been on the Sunshine Coast for over thirty years. We also run a YouTube channel with more than 2,000 subscribers where Shane walks through every caravan in detail.",
      },
    },
    {
      '@type': 'Question',
      name: 'Can SEQ Campers help with caravan handover and delivery?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Handover happens on the SEQ premises. We walk you through the van, run you through the systems, and have mechanics on site if anything needs adjusting before you tow it home.',
      },
    },
  ],
}
---

<Site
  title="Premium Off-Road Caravans"
  description="SEQ Campers - Queensland's home for premium off-road caravans. Hand-picked Kimberley Kampers and Stockman stock, hand-inspected by Shane. Thirty years on the Sunshine Coast."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusiness)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero -->
  <section class="hero hero-landscape">
    <!-- Sunset / outback landscape SVG (matches Maud's signoff mockup) -->
    <svg class="hero-svg" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3B1A2A" />
          <stop offset="12%" stop-color="#6B2D38" />
          <stop offset="26%" stop-color="#A84828" />
          <stop offset="42%" stop-color="#C87040" />
          <stop offset="58%" stop-color="#D4883A" />
          <stop offset="72%" stop-color="#B85A28" />
          <stop offset="86%" stop-color="#7A2E12" />
          <stop offset="100%" stop-color="#2A1208" />
        </linearGradient>
        <linearGradient id="leftfade" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#1A0A04" stop-opacity="0.9" />
          <stop offset="40%" stop-color="#1A0A04" stop-opacity="0.55" />
          <stop offset="70%" stop-color="#1A0A04" stop-opacity="0.1" />
          <stop offset="100%" stop-color="#1A0A04" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="groundfade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2A1208" stop-opacity="0" />
          <stop offset="100%" stop-color="#2A1208" stop-opacity="0.85" />
        </linearGradient>
        <radialGradient id="sunhalo" cx="68%" cy="28%" r="38%">
          <stop offset="0%" stop-color="#E8901A" stop-opacity="0.32" />
          <stop offset="100%" stop-color="#E8901A" stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect width="1440" height="600" fill="url(#sky)" />

      <!-- horizontal cloud bands -->
      <rect y="80" width="1440" height="22" fill="#C87850" opacity="0.18" />
      <rect y="120" width="1440" height="14" fill="#D48840" opacity="0.14" />
      <rect y="160" width="1440" height="18" fill="#B86030" opacity="0.16" />
      <ellipse cx="1090" cy="105" rx="280" ry="22" fill="#D49058" opacity="0.20" />
      <ellipse cx="930" cy="135" rx="220" ry="14" fill="#C87848" opacity="0.16" />
      <ellipse cx="1200" cy="165" rx="190" ry="12" fill="#B86030" opacity="0.14" />

      <!-- sun halo -->
      <rect width="1440" height="600" fill="url(#sunhalo)" />

      <!-- Uluru-style mesa -->
      <path d="M830,420 Q855,260 950,240 Q1055,220 1145,250 Q1240,278 1310,310 Q1370,335 1440,370 L1440,600 L818,600 Z" fill="#7A2E14" opacity="0.55" />
      <path d="M880,420 Q900,265 990,245 Q1080,228 1180,258 Q1265,283 1345,318 L1440,600 L860,600 Z" fill="#A03820" opacity="0.35" />
      <path d="M905,415 Q925,267 1010,250 Q1095,232 1185,260 Q1270,287 1345,322" fill="none" stroke="#D4943A" stroke-width="2" opacity="0.22" />

      <!-- mid-distance hills -->
      <polygon points="600,600 800,345 920,415 1040,355 1170,425 1310,365 1440,425 1440,600" fill="#3A4818" opacity="0.30" />
      <polygon points="640,600 830,360 955,425 1075,370 1200,440 1440,600" fill="#566030" opacity="0.18" />

      <!-- foreground earth -->
      <rect y="520" width="1440" height="80" fill="#1e0c06" opacity="0.78" />
      <rect y="505" width="1440" height="12" fill="#7A4018" opacity="0.22" />
      <rect y="492" width="1440" height="8" fill="#906028" opacity="0.15" />

      <!-- layered mountain silhouettes -->
      <polygon points="0,600 200,430 410,600" fill="#2e3a14" opacity="0.22" />
      <polygon points="370,600 620,390 870,600" fill="#3a4a1a" opacity="0.18" />
      <polygon points="0,600 240,400 500,600" fill="#6B7A3A" opacity="0.32" />
      <polygon points="410,600 670,370 935,600" fill="#566030" opacity="0.22" />
      <polygon points="935,600 1160,420 1390,600" fill="#C8861A" opacity="0.28" />
      <polygon points="1040,600 1245,448 1440,600" fill="#D4943A" opacity="0.18" />

      <!-- hero red centre peak -->
      <polygon points="475,600 805,340 1135,600" fill="#7B2E16" opacity="0.5" />
      <polygon points="520,600 840,358 1160,600" fill="#C0341A" opacity="0.28" />

      <!-- ground strip -->
      <rect y="585" width="1440" height="15" fill="#1e0c06" opacity="0.65" />

      <!-- left fade for text legibility -->
      <rect width="1440" height="600" fill="url(#leftfade)" />
      <!-- bottom ground fade -->
      <rect y="460" width="1440" height="140" fill="url(#groundfade)" />
    </svg>

    <div class="container">
      <div class="hero-content">
        <div class="page-eyebrow">SEQ Campers · Sunshine Coast, Queensland</div>
        <h1>Off-road caravans built for the long way home.</h1>
        <p>
          Kimberley Kampers and Stockman caravans, hand-picked and inspected
          by the SEQ team. Thirty years on the Sunshine Coast and
          still going further than most.
        </p>
        <div class="hero-btns">
          <a href="/stock" class="btn-primary">View current stock</a>
          <a href="/contact" class="btn-ghost">Talk to the team</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why SEQ + intro pitch -->
  <section class="section" style="padding-bottom:32px;">
    <div class="container" style="max-width:840px; text-align:center;">
      <div class="page-eyebrow" style="color:var(--rust); margin-bottom:12px;">Why SEQ Campers</div>
      <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.8rem; font-weight:600; color:var(--ink); letter-spacing:-0.01em; margin-bottom:18px;">
        Buying a caravan is a big decision.
      </h2>
      <p style="color:var(--muted); font-size:1.05rem; line-height:1.75; margin-bottom:18px;">
        You're looking at spending $50,000 to $200,000+ on something your family will use for the next 20 years.
        You want to see it, touch it, hear from someone who's actually used it - not just read specs on a page.
      </p>
      <p style="color:var(--muted); font-size:1.05rem; line-height:1.75;">
        That's why we put everything on video. Every model, every feature, setup and pack-down. So by the time you walk into our showroom,
        you already know what you're looking at - and you can spend your time asking the questions that actually matter to you.
      </p>
    </div>
  </section>

  <!-- 3 steps -->
  <section class="section" style="padding-top:24px;">
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:4px;">
        <div class="page-eyebrow" style="color:var(--rust);">How it works</div>
        <h2 class="section-title">Three steps to your next adventure</h2>
      </div>
      <div class="three-steps">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Watch</h3>
          <p>Browse our video library. See every model inside and out. Get a feel for what suits your travel style before you visit.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Visit</h3>
          <p>Book a walkthrough at our Sunshine Coast showroom. No pressure, no rush. Shane and Maud will match you to the right caravan.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Adventure</h3>
          <p>Hit the road knowing you've made the right call. And when it's time for a service, we're right here on the Sunshine Coast.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest from YouTube -->
  <section class="section" style="background:var(--sand-deep); padding-top:48px; padding-bottom:48px;">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="page-eyebrow" style="color:var(--rust);">Watch before you visit</div>
          <h2 class="section-title">Latest from our YouTube channel</h2>
        </div>
        <a href="/videos" class="section-link">All videos →</a>
      </div>
      <div class="video-grid">
        {featuredVideos.map((v) => <VideoCard video={v} />)}
      </div>
      <p style="text-align:center; color:var(--muted); margin-top:24px; font-size:0.95rem;">
        Join <strong style="color:var(--ink);">2,000+ off-road enthusiasts</strong> on our YouTube channel -
        <a href="https://www.youtube.com/channel/UCOeiI-wxOLUCX1UzMiE6XVg" target="_blank" rel="noopener" style="color:var(--rust); font-weight:600;">subscribe here</a>
      </p>
    </div>
  </section>

  <!-- Shane's Pick / Sale of the Week -->
  {shanesPick && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <div class="page-eyebrow" style="color:var(--rust);">Sale of the week</div>
            <h2 class="section-title">Shane's Pick</h2>
          </div>
          <a href={`/stock/${shanesPick.caravan.slug?.current}`} class="section-link">View this listing →</a>
        </div>

        <div class="shanes-pick">
          <div class="shanes-pick-photo">
            {shanesPick.caravan.mainImage ? (
              <img src={sanityImage(shanesPick.caravan.mainImage, { w: 800 })} alt={shanesPick.caravan.title} />
            ) : (
              <div class="caravan-card-noimg">No photo yet</div>
            )}
            <span class="shanes-pick-badge">Shane's Pick</span>
          </div>
          <div class="shanes-pick-body">
            {shanesPick.caravan.condition && conditionLabel(shanesPick.caravan.condition) && (
              <span class={`condition-badge condition-${shanesPick.caravan.condition}`}>{conditionLabel(shanesPick.caravan.condition)}</span>
            )}
            {shanesPick.caravan.brand && <div class="card-brand" style="margin-top:8px;">{shanesPick.caravan.brand}</div>}
            <h3 class="shanes-pick-title">{shanesPick.caravan.title}</h3>
            <div class="shanes-pick-prices">
              {shanesPick.originalPrice && (
                <span class="shanes-pick-original">${shanesPick.originalPrice.toLocaleString('en-AU')}</span>
              )}
              <span class="shanes-pick-price">${shanesPick.caravan.price?.toLocaleString('en-AU')}</span>
            </div>
            {shanesPick.quote && (
              <blockquote class="shanes-pick-quote">
                "{shanesPick.quote}"
                <cite>— SEQ team</cite>
              </blockquote>
            )}
            {shanesPick.caravan.specs && (
              <div class="shanes-pick-specs">
                {shanesPick.caravan.specs.sleeps && <div><span>Sleeps</span><strong>{shanesPick.caravan.specs.sleeps}</strong></div>}
                {shanesPick.caravan.specs.length && <div><span>Length</span><strong>{shanesPick.caravan.specs.length}m</strong></div>}
                {shanesPick.caravan.specs.tareWeight && <div><span>Tare</span><strong>{shanesPick.caravan.specs.tareWeight}kg</strong></div>}
              </div>
            )}
            <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:18px;">
              <a href={`/stock/${shanesPick.caravan.slug?.current}`} class="btn-primary">View this listing</a>
              <a href="/stock" class="btn-ghost" style="background:rgba(42,22,8,0.06); color:var(--ink); border-color:var(--tan-border);">See all stock</a>
            </div>
            {shanesPick.isPlaceholder && (
              <p style="font-size:0.75rem; color:var(--muted); margin-top:14px; font-style:italic;">
                Auto-picked from your featured stock. Set a specific Shane's Pick in Sanity Studio → Site Settings.
              </p>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Featured caravans -->
  <section class="section" style="background:var(--sand-deep);">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">More featured stock</h2>
        <a href="/stock" class="section-link">See all caravans →</a>
      </div>

      {featured.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">Featured listings coming soon</div>
          <p>We are loading our caravan inventory into the new site. Check back shortly, or browse the full stock list.</p>
          <p style="margin-top:16px;"><a href="/stock" class="section-link">Browse all stock →</a></p>
        </div>
      ) : (
        <div class="stock-grid">
          {featured.map((c) => <CaravanCard caravan={c} />)}
        </div>
      )}
    </div>
  </section>

  <!-- What's Happening teaser -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="page-eyebrow" style="color:var(--rust);">From the showroom floor</div>
          <h2 class="section-title">What's happening</h2>
        </div>
        <a href="/whats-happening" class="section-link">All news →</a>
      </div>
      <div class="news-teaser-grid">
        {upcomingNews.map((n) => (
          <div class="news-teaser-card">
            <div class="news-teaser-date">{n.date}</div>
            <span class="news-type news-type-rust">{n.type}</span>
            <h3>{n.title}</h3>
            <p>{n.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service teaser -->
  <section class="band-dark">
    <div class="container" style="text-align:center; max-width:780px; margin:0 auto;">
      <div class="page-eyebrow" style="color:var(--gold); margin-bottom:12px;">Workshop</div>
      <h2 style="color:var(--sand); font-size:1.8rem; margin-bottom:16px;">
        We don't just sell them. We service them.
      </h2>
      <p style="color:var(--gold); margin-bottom:28px; line-height:1.7;">
        Our workshop handles everything from annual servicing to custom modifications.
        You bought it here - we'll look after it for life.
      </p>
      <a href="/service" class="btn-primary">See workshop services</a>
    </div>
  </section>

</Site>
