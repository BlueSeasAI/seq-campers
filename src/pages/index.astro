---
import Site from '../layouts/Site.astro'
import CaravanCard from '../components/CaravanCard.astro'
import VideoCard from '../components/VideoCard.astro'
import TrustStrip from '../components/TrustStrip.astro'
import MountainIcon from '../components/MountainIcon.astro'
import { getFeaturedCaravans, getFeaturedVideos, getSiteSettings, sanityImage, conditionLabel } from '../lib/sanity.js'

let featured = []
let featuredVideos = []
let settings = null
try {
  ;[featured, featuredVideos, settings] = await Promise.all([
    getFeaturedCaravans(),
    getFeaturedVideos(3),
    getSiteSettings(),
  ])
} catch (err) {
  console.warn('Sanity unreachable on build:', err.message)
}

// Fallback videos pulled from the real SEQ Campers YouTube channel. Used until
// Maud marks any video as Featured in Sanity Studio.
if (!featuredVideos || featuredVideos.length === 0) {
  featuredVideos = [
    {
      _id: 'p1',
      title: 'The REAL Difference in Premium Caravans',
      youtubeUrl: 'https://www.youtube.com/watch?v=tozC7prVbOg',
      description: 'Shane unpacks what actually separates a premium off-road caravan from the rest - and why it matters once you hit the corrugations.',
      category: 'deep-dive',
    },
    {
      _id: 'p2',
      title: 'Caravan Setup Guide - Camp Ready in Minutes',
      youtubeUrl: 'https://www.youtube.com/watch?v=xYf81xUZtNE',
      description: 'A simple, repeatable walkthrough so your first night on the road is spent with the kettle on, not the manual out.',
      category: 'setup',
    },
    {
      _id: 'p3',
      title: 'The #1 Cause of Caravan Electrical Failures',
      youtubeUrl: 'https://www.youtube.com/shorts/WwgapQt3xO4',
      description: 'Quick one - the single most common electrical issue we see in the workshop, and how to avoid it.',
      category: 'deep-dive',
    },
  ]
}

// Shane's Pick - resolve from siteSettings, then fall back to first featured
// caravan, then to a static placeholder so the section always renders. Maud
// can override anytime in Sanity Studio > Site Settings > Shane's Pick.
const PLACEHOLDER_SHANES_PICK_CARAVAN = {
  _id: 'placeholder-shanes-pick',
  title: 'Kimberley Karavan 2024',
  slug: { current: 'stock' },
  brand: 'Kimberley Kampers',
  price: 145000,
  condition: 'excellent',
  mainImage: null,
  specs: { sleeps: 4, length: 5.8, tareWeight: 2680 },
}
const shanesPick = settings?.shanesPick?.caravan
  ? {
      caravan: settings.shanesPick.caravan,
      originalPrice: settings.shanesPick.originalPrice,
      quote: settings.shanesPick.shanesQuote,
      isPlaceholder: false,
    }
  : (featured[0]
      ? {
          caravan: featured[0],
          originalPrice: null,
          quote: 'One of the best examples we\'ve had through the lot. Full service history, immaculate condition - the kind of caravan I\'d happily hand the keys to a family member on.',
          isPlaceholder: true,
        }
      : {
          caravan: PLACEHOLDER_SHANES_PICK_CARAVAN,
          originalPrice: null,
          quote: 'Shane has not picked a featured caravan yet. Browse the full stock list to see what is currently available, or call us on (07) 5370 7933.',
          isPlaceholder: true,
        })

// Placeholder testimonials - Maud to replace with real customer quotes.
// Format intentionally specific (full name + suburb + caravan + star rating)
// because the audit found Kimberley + Stockman both lack this trust signal.
// Real Google reviews - verbatim, names + attribution preserved.
const testimonials = [
  {
    quote: "A huge shout out to SEQ Campers. While traveling we found one of our guide rollers kept coming off the track, after inspecting them discovered the others were in bad shape. A phone call to SEQ campers and a conversation with Shane had us diverting to their workshop, where Grant took control and sorted our van out - he and the crew gave it a thorough check over. The service was something we didn't expect at such short notice, but was very much appreciated as it saved us the hassle of doing that fiddly job while on the road. Thanks fellas!",
    name: "Willie & Cathy",
    source: "Catherine Fabris · Google review",
    rating: 5,
  },
  {
    quote: "Great customer service. We brought a karavan under consignment from Shane and Maud, which was a great experience. After using the van, we noticed some issues with it and contacted the SEQ campers team. They were very helpful and carried out the repairs required under warranty. Upon picking the van up, workshop manager Grant was very kind and spent the time to explain the repairs they had carried out. This was appreciated, and I wouldn't hesitate to recommend any of my friends or family to this business.",
    name: "David Poole",
    source: "Google review",
    rating: 5,
  },
  {
    quote: "We purchased a second hand KK to do WA while waiting for a new build. The knowledge and after-sales support was fantastic. The handover and after-sale support was great - it shortened the learning curve significantly. When we sold the van 6 months later they had potential buyers before I could deliver the van. We received the new van and there were some issues but Maud and the team handled everything necessary to rectify everything. Recently they added a bbq table custom made for my Weber - it is fantastic, one less table to carry on the road. I can only say positive things about the relationship I have with the team at SEQ Campers.",
    name: "T Ireland",
    source: "Google Local Guide review",
    rating: 5,
  },
]

const upcomingNews = [
  { date: '10 May', type: 'New Arrival', title: 'New Stockman Rover 02 arrival', body: 'The 2026 model is in the showroom. Come see the upgrades in person.' },
  { date: '17 May', type: 'Handover', title: 'Mitchell family handover', body: 'Another family heading out on their first big trip. Safe travels!' },
  { date: '03 Jun', type: 'Event', title: 'Brisbane Caravan, Camping & Touring Supershow', body: 'Three days at the Brisbane Showgrounds. Come and find us at the show - or book a chat before we go.', href: '/brisbane-show-2026' },
]

// LocalBusiness schema - tells Google/AI "we are an Australian caravan dealer"
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': 'https://seqcampers.com.au/#business',
  name: 'SEQ Campers',
  description: "Premium off-road caravan dealer on the Sunshine Coast, Queensland. Hand-picked Kimberley Kampers and Stockman stock. Off-road camping experts since 2013.",
  url: 'https://seqcampers.com.au',
  telephone: '+61-7-5370-7933',
  email: 'office@seqcampers.com.au',
  areaServed: { '@type': 'State', name: 'Queensland, Australia' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3B/6 Bonanza Court',
    addressLocality: 'Marcoola',
    addressRegion: 'QLD',
    postalCode: '4564',
    addressCountry: 'AU',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday'], opens: '07:30', closes: '15:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday'], opens: '08:30', closes: '15:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:30', closes: '12:30' },
  ],
  priceRange: '$$$',
  knowsAbout: ['Kimberley Kampers', 'Stockman Caravans', 'Off-road caravans', 'Caravan inspections', 'Sunshine Coast caravan dealer'],
  sameAs: ['https://www.youtube.com/channel/UCOeiI-wxOLUCX1UzMiE6XVg'],
}

// FAQ schema - direct answers AI search engines can quote
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What brands of caravan does SEQ Campers stock?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers specialises in premium off-road caravans from Kimberley Kampers and Stockman Caravans. Every van on the lot is hand-picked, inspected, and prepared by Shane and the SEQ team before it goes on sale.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is SEQ Campers located?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers operates from the Sunshine Coast in Queensland, Australia. Visits are by appointment. Call (07) 5370 7933 to book a time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are SEQ Campers caravans inspected before sale?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Shane personally inspects every caravan that comes through SEQ Campers. We have on-site mechanics, roadworthy inspections, and full pre-delivery preparation as part of the sale process.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long has SEQ Campers been operating?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "SEQ Campers has been the Sunshine Coast home of premium off-road caravans since 2013, building on Kimberley Kampers' 30-year Australian heritage. We also run a YouTube channel with more than 2,000 subscribers where Shane walks through every caravan in detail.",
      },
    },
    {
      '@type': 'Question',
      name: 'Can SEQ Campers help with caravan handover and delivery?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Handover happens on the SEQ premises. We walk you through the van, run you through the systems, and have mechanics on site if anything needs adjusting before you tow it home.',
      },
    },
  ],
}
---

<Site
  title="Premium Off-Road Caravans"
  description="SEQ Campers - Queensland's home for premium off-road caravans. Hand-picked Kimberley Kampers and Stockman stock, hand-inspected by Shane. Off-road camping on the Sunshine Coast since 2013."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusiness)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero - silent looping video. No text overlay - the brand reads through
       the header logo + the video itself. A transparent click-blocker layer
       sits over the iframe so user mouseover never triggers YouTube's chrome
       (the controls that occasionally flicker in). -->
  <section class="hero hero-video hero-video-clean">
    <div class="hero-video-bg" aria-hidden="true">
      <iframe
        src="https://www.youtube-nocookie.com/embed/tozC7prVbOg?autoplay=1&mute=1&loop=1&playlist=tozC7prVbOg&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&cc_load_policy=0&showinfo=0&enablejsapi=0"
        title="SEQ Campers"
        frameborder="0"
        allow="autoplay; encrypted-media"
        allowfullscreen="false"
        tabindex="-1"
        inert
      ></iframe>
      <!-- Bulletproof click-blocker: covers the whole iframe at high z-index,
           swallows ALL pointer events + touch + selection so YouTube can
           never show its hover/tap controls overlay. Video keeps playing
           underneath because the iframe is also `inert` so it receives no
           focus / pointer / keyboard input at all. -->
      <div class="hero-video-block" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Three Mountain Banners (Watch / Visit / Adventure) - Shane's preferred
       home page architecture. Each banner is a full-viewport section with a
       mountain icon in one of the SEQ logo colours. Clicking jumps to the
       relevant page where the "tree" lives (videos, used stock, service). -->
  <section class="mountain-banner mountain-watch" id="watch">
    <a href="/videos" class="mountain-banner-link">
      <div class="mountain-banner-bg">
        <iframe
          src="https://www.youtube-nocookie.com/embed/tozC7prVbOg?autoplay=1&mute=1&loop=1&playlist=tozC7prVbOg&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0"
          title="Watch our video library"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen="false"
          tabindex="-1"
          inert
        ></iframe>
        <div class="mountain-banner-block" aria-hidden="true"></div>
        <div class="mountain-banner-overlay" aria-hidden="true"></div>
      </div>
      <div class="mountain-banner-inner">
        <MountainIcon color="#F5B544" accent="#D89425" size={88} />
        <div class="mountain-banner-eyebrow">1. Watch</div>
        <h2 class="mountain-banner-title">Browse our video library.</h2>
        <p class="mountain-banner-desc">See every model inside and out - Kimberley and Stockman. Get a feel for what suits your travel style before you visit.</p>
        <span class="mountain-banner-cta">See all models →</span>
      </div>
    </a>
  </section>

  <section class="mountain-banner mountain-visit" id="visit">
    <a href="/stock" class="mountain-banner-link">
      <div class="mountain-banner-bg">
        <iframe
          src="https://www.youtube-nocookie.com/embed/xYf81xUZtNE?autoplay=1&mute=1&loop=1&playlist=xYf81xUZtNE&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0"
          title="Visit our stock"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen="false"
          tabindex="-1"
          inert
        ></iframe>
        <div class="mountain-banner-block" aria-hidden="true"></div>
        <div class="mountain-banner-overlay" aria-hidden="true"></div>
      </div>
      <div class="mountain-banner-inner">
        <MountainIcon color="#E97B3C" accent="#C0341A" size={88} />
        <div class="mountain-banner-eyebrow">2. Visit</div>
        <h2 class="mountain-banner-title">Available now for sale.</h2>
        <p class="mountain-banner-desc">Every used caravan on the lot, with a walk-around video. Book a showroom visit or call us to lock one in.</p>
        <span class="mountain-banner-cta">See in-stock caravans →</span>
      </div>
    </a>
  </section>

  <section class="mountain-banner mountain-adventure" id="adventure">
    <a href="/service" class="mountain-banner-link">
      <div class="mountain-banner-bg">
        <iframe
          src="https://www.youtube-nocookie.com/embed/WwgapQt3xO4?autoplay=1&mute=1&loop=1&playlist=WwgapQt3xO4&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0"
          title="Adventure - handover and service"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen="false"
          tabindex="-1"
          inert
        ></iframe>
        <div class="mountain-banner-block" aria-hidden="true"></div>
        <div class="mountain-banner-overlay" aria-hidden="true"></div>
      </div>
      <div class="mountain-banner-inner">
        <MountainIcon color="#4cea89" accent="#2BA85F" size={88} />
        <div class="mountain-banner-eyebrow">3. Adventure</div>
        <h2 class="mountain-banner-title">From our driveway to yours.</h2>
        <p class="mountain-banner-desc">Handover, upgrades, annual service, repairs - whatever the road throws at it, we're here.</p>
        <span class="mountain-banner-cta">Camping support →</span>
      </div>
    </a>
  </section>

  <TrustStrip />

  <!-- Google reviews social proof - display only, no exit link. Per Bart:
       keep visitors on site. Clicking the bar smooth-scrolls to the
       testimonials section lower on the page. -->
  <div class="reviews-bar">
    <div class="container">
      <a href="#testimonials" class="reviews-bar-inner">
        <span class="reviews-stars" aria-hidden="true">★★★★★</span>
        <span class="reviews-text"><strong>35+ five-star reviews</strong> from SEQ owners</span>
        <span class="reviews-link">See what they say</span>
      </a>
    </div>
  </div>

  <!-- Shane's Pick / Sale of the Week - replaces the YouTube grid per Bart.
       Higher conversion than a 3-card browse grid: single focal point,
       Shane's personal endorsement, urgency narrative, one clear CTA. -->
  {shanesPick && (
    <section class="section" style="background:var(--sand-deep); padding-top:48px; padding-bottom:48px;">
      <div class="container">
        <div class="section-header">
          <div>
            <div class="page-eyebrow" style="color:var(--rust);">Sale of the week</div>
            <h2 class="section-title">Shane's Pick</h2>
          </div>
          <a href={`/stock/${shanesPick.caravan.slug?.current}`} class="section-link">View this listing →</a>
        </div>

        <div class="shanes-pick">
          <div class="shanes-pick-photo">
            {shanesPick.caravan.mainImage ? (
              <img src={sanityImage(shanesPick.caravan.mainImage, { w: 800 })} alt={shanesPick.caravan.title} />
            ) : (
              <div class="caravan-card-noimg">No photo yet</div>
            )}
            <span class="shanes-pick-badge">Shane's Pick</span>
          </div>
          <div class="shanes-pick-body">
            {shanesPick.caravan.condition && conditionLabel(shanesPick.caravan.condition) && (
              <span class={`condition-badge condition-${shanesPick.caravan.condition}`}>{conditionLabel(shanesPick.caravan.condition)}</span>
            )}
            {shanesPick.caravan.brand && <div class="card-brand" style="margin-top:8px;">{shanesPick.caravan.brand}</div>}
            <h3 class="shanes-pick-title">{shanesPick.caravan.title}</h3>
            <div class="shanes-pick-prices">
              {shanesPick.originalPrice && (
                <span class="shanes-pick-original">${shanesPick.originalPrice.toLocaleString('en-AU')}</span>
              )}
              <span class="shanes-pick-price">${shanesPick.caravan.price?.toLocaleString('en-AU')}</span>
            </div>
            {shanesPick.quote && (
              <blockquote class="shanes-pick-quote">
                "{shanesPick.quote}"
                <cite>- SEQ team</cite>
              </blockquote>
            )}
            {shanesPick.caravan.specs && (
              <div class="shanes-pick-specs">
                {shanesPick.caravan.specs.sleeps && <div><span>Sleeps</span><strong>{shanesPick.caravan.specs.sleeps}</strong></div>}
                {shanesPick.caravan.specs.length && <div><span>Length</span><strong>{shanesPick.caravan.specs.length}m</strong></div>}
                {shanesPick.caravan.specs.tareWeight && <div><span>Tare</span><strong>{shanesPick.caravan.specs.tareWeight}kg</strong></div>}
              </div>
            )}
            <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:18px;">
              <a href={`/stock/${shanesPick.caravan.slug?.current}`} class="btn-primary">View this listing</a>
              <a href="/stock" class="btn-ghost" style="background:rgba(42,22,8,0.06); color:var(--ink); border-color:var(--tan-border);">See all stock</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <style>
    /* Three Mountain Banners - SkyRV-style full viewport sections.
       Per Shane's brief: seamless, video-led, each banner is a full
       screen height with a mountain icon and minimal text overlay. */
    .mountain-banner {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 560px;
      overflow: hidden;
      background: #1a1a1c;
    }
    .mountain-banner-link {
      display: block;
      position: relative;
      width: 100%;
      height: 100%;
      text-decoration: none;
      color: inherit;
    }
    .mountain-banner-bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .mountain-banner-bg iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.78vh;
      height: 100vh;
      min-width: 100%;
      min-height: 56.25vw;
      transform: translate(-50%, -50%);
      border: 0;
      pointer-events: none;
    }
    .mountain-banner-block {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: auto;
    }
    .mountain-banner-overlay {
      position: absolute;
      inset: 0;
      z-index: 3;
      background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.45) 60%, rgba(0,0,0,0.65) 100%);
      pointer-events: none;
    }
    .mountain-banner-inner {
      position: relative;
      z-index: 4;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      height: 100%;
      padding: 40px 24px;
      color: #fff;
      pointer-events: none;
    }
    .mountain-banner-inner > * { pointer-events: auto; }
    .mountain-banner-eyebrow {
      margin-top: 18px;
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
    }
    .mountain-banner-title {
      margin: 10px 0 14px;
      font-family: 'Inter Tight', sans-serif;
      font-size: clamp(2rem, 5vw, 3.4rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: #fff;
      text-shadow: 0 2px 24px rgba(0,0,0,0.35);
      max-width: 820px;
    }
    .mountain-banner-desc {
      max-width: 640px;
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(255,255,255,0.9);
      margin: 0 0 22px;
      text-shadow: 0 1px 12px rgba(0,0,0,0.35);
    }
    .mountain-banner-cta {
      display: inline-block;
      padding: 14px 28px;
      background: #fff;
      color: var(--ink, #2A1608);
      border-radius: 999px;
      font-weight: 700;
      font-family: 'Inter Tight', sans-serif;
      letter-spacing: 0.02em;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .mountain-banner-link:hover .mountain-banner-cta {
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(0,0,0,0.35);
    }
    @media (max-width: 768px) {
      .mountain-banner { height: 80vh; min-height: 480px; }
      .mountain-banner-desc { font-size: 0.95rem; }
    }
  </style>

  <!-- Testimonials - lives below Shane's Pick. Reviews bar above scrolls
       here. Real Google reviews. No external link out - keeps visitors
       on the site. -->
  <section id="testimonials" class="section">
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:4px; margin-bottom:8px;">
        <div class="page-eyebrow" style="color:var(--rust);">In their own words</div>
        <h2 class="section-title">Real owners, real trips, real stories</h2>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((t) => (
          <figure class="testimonial-card">
            <div class="testimonial-stars" aria-label={`${t.rating} out of 5 stars`}>
              {Array.from({ length: t.rating }).map(() => <span aria-hidden="true">★</span>)}
            </div>
            <blockquote class="testimonial-quote">"{t.quote}"</blockquote>
            <figcaption class="testimonial-meta">
              <div class="testimonial-name">{t.name}</div>
              <div class="testimonial-sub">{t.source}</div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Site>
