---
import Site from '../layouts/Site.astro'
import { getFeaturedCaravans, sanityImage, sanitySrcset, conditionLabel } from '../lib/sanity.js'

let featured = []
try {
  featured = await getFeaturedCaravans()
} catch (err) {
  console.warn('Sanity unreachable on build - featured caravans empty:', err.message)
}

// LocalBusiness schema - tells Google/AI "we are an Australian caravan dealer"
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': 'https://seqcampers.com.au/#business',
  name: 'SEQ Campers',
  description: "Premium off-road caravan dealer on the Sunshine Coast, Queensland. Hand-picked Kimberley Kampers and Stockman stock. Thirty years in the industry.",
  url: 'https://seqcampers.com.au',
  telephone: '+61-7-5300-2344',
  email: 'enquiries@seqcampers.com.au',
  areaServed: { '@type': 'State', name: 'Queensland, Australia' },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'QLD',
    addressCountry: 'AU',
  },
  openingHours: 'Mo-Sa 08:00-17:00',
  priceRange: '$$$',
  knowsAbout: ['Kimberley Kampers', 'Stockman Caravans', 'Off-road caravans', 'Caravan inspections', 'Sunshine Coast caravan dealer'],
  sameAs: ['https://www.youtube.com/@seqcampers'],
}

// FAQ schema - direct answers AI search engines can quote
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What brands of caravan does SEQ Campers stock?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers specialises in premium off-road caravans from Kimberley Kampers and Stockman Caravans. Every van on the lot is hand-picked, inspected, and prepared by Shane and the SEQ team before it goes on sale.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is SEQ Campers located?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers operates from the Sunshine Coast in Queensland, Australia. Visits are by appointment. Call (07) 5300 2344 to book a time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are SEQ Campers caravans inspected before sale?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Shane personally inspects every caravan that comes through SEQ Campers. We have on-site mechanics, roadworthy inspections, and full pre-delivery preparation as part of the sale process.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long has SEQ Campers been operating?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "SEQ Campers has been on the Sunshine Coast for over thirty years. We also run a YouTube channel with more than 2,000 subscribers where Shane walks through every caravan in detail.",
      },
    },
    {
      '@type': 'Question',
      name: 'Can SEQ Campers help with caravan handover and delivery?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Handover happens on the SEQ premises. We walk you through the van, run you through the systems, and have mechanics on site if anything needs adjusting before you tow it home.',
      },
    },
  ],
}
---

<Site
  title="Premium Off-Road Caravans"
  description="SEQ Campers - Queensland's home for premium off-road caravans. Hand-picked Kimberley Kampers and Stockman stock, hand-inspected by Shane. Thirty years on the Sunshine Coast."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusiness)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero -->
  <section class="hero hero-landscape">
    <!-- Sunset / outback landscape SVG (matches Maud's signoff mockup) -->
    <svg class="hero-svg" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3B1A2A" />
          <stop offset="12%" stop-color="#6B2D38" />
          <stop offset="26%" stop-color="#A84828" />
          <stop offset="42%" stop-color="#C87040" />
          <stop offset="58%" stop-color="#D4883A" />
          <stop offset="72%" stop-color="#B85A28" />
          <stop offset="86%" stop-color="#7A2E12" />
          <stop offset="100%" stop-color="#2A1208" />
        </linearGradient>
        <linearGradient id="leftfade" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#1A0A04" stop-opacity="0.9" />
          <stop offset="40%" stop-color="#1A0A04" stop-opacity="0.55" />
          <stop offset="70%" stop-color="#1A0A04" stop-opacity="0.1" />
          <stop offset="100%" stop-color="#1A0A04" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="groundfade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2A1208" stop-opacity="0" />
          <stop offset="100%" stop-color="#2A1208" stop-opacity="0.85" />
        </linearGradient>
        <radialGradient id="sunhalo" cx="68%" cy="28%" r="38%">
          <stop offset="0%" stop-color="#E8901A" stop-opacity="0.32" />
          <stop offset="100%" stop-color="#E8901A" stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect width="1440" height="600" fill="url(#sky)" />

      <!-- horizontal cloud bands -->
      <rect y="80" width="1440" height="22" fill="#C87850" opacity="0.18" />
      <rect y="120" width="1440" height="14" fill="#D48840" opacity="0.14" />
      <rect y="160" width="1440" height="18" fill="#B86030" opacity="0.16" />
      <ellipse cx="1090" cy="105" rx="280" ry="22" fill="#D49058" opacity="0.20" />
      <ellipse cx="930" cy="135" rx="220" ry="14" fill="#C87848" opacity="0.16" />
      <ellipse cx="1200" cy="165" rx="190" ry="12" fill="#B86030" opacity="0.14" />

      <!-- sun halo -->
      <rect width="1440" height="600" fill="url(#sunhalo)" />

      <!-- Uluru-style mesa -->
      <path d="M830,420 Q855,260 950,240 Q1055,220 1145,250 Q1240,278 1310,310 Q1370,335 1440,370 L1440,600 L818,600 Z" fill="#7A2E14" opacity="0.55" />
      <path d="M880,420 Q900,265 990,245 Q1080,228 1180,258 Q1265,283 1345,318 L1440,600 L860,600 Z" fill="#A03820" opacity="0.35" />
      <path d="M905,415 Q925,267 1010,250 Q1095,232 1185,260 Q1270,287 1345,322" fill="none" stroke="#D4943A" stroke-width="2" opacity="0.22" />

      <!-- mid-distance hills -->
      <polygon points="600,600 800,345 920,415 1040,355 1170,425 1310,365 1440,425 1440,600" fill="#3A4818" opacity="0.30" />
      <polygon points="640,600 830,360 955,425 1075,370 1200,440 1440,600" fill="#566030" opacity="0.18" />

      <!-- foreground earth -->
      <rect y="520" width="1440" height="80" fill="#1e0c06" opacity="0.78" />
      <rect y="505" width="1440" height="12" fill="#7A4018" opacity="0.22" />
      <rect y="492" width="1440" height="8" fill="#906028" opacity="0.15" />

      <!-- layered mountain silhouettes -->
      <polygon points="0,600 200,430 410,600" fill="#2e3a14" opacity="0.22" />
      <polygon points="370,600 620,390 870,600" fill="#3a4a1a" opacity="0.18" />
      <polygon points="0,600 240,400 500,600" fill="#6B7A3A" opacity="0.32" />
      <polygon points="410,600 670,370 935,600" fill="#566030" opacity="0.22" />
      <polygon points="935,600 1160,420 1390,600" fill="#C8861A" opacity="0.28" />
      <polygon points="1040,600 1245,448 1440,600" fill="#D4943A" opacity="0.18" />

      <!-- hero red centre peak -->
      <polygon points="475,600 805,340 1135,600" fill="#7B2E16" opacity="0.5" />
      <polygon points="520,600 840,358 1160,600" fill="#C0341A" opacity="0.28" />

      <!-- ground strip -->
      <rect y="585" width="1440" height="15" fill="#1e0c06" opacity="0.65" />

      <!-- left fade for text legibility -->
      <rect width="1440" height="600" fill="url(#leftfade)" />
      <!-- bottom ground fade -->
      <rect y="460" width="1440" height="140" fill="url(#groundfade)" />
    </svg>

    <div class="container">
      <div class="hero-content">
        <div class="page-eyebrow">SEQ Campers · Sunshine Coast, Queensland</div>
        <h1>Off-road caravans built for the long way home.</h1>
        <p>
          Kimberley Kampers and Stockman caravans, hand-picked and inspected
          by Shane and the SEQ team. Thirty years on the Sunshine Coast and
          still going further than most.
        </p>
        <div class="hero-btns">
          <a href="/stock" class="btn-primary">View current stock</a>
          <a href="/contact" class="btn-ghost">Talk to Shane</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured caravans -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Featured stock</h2>
        <a href="/stock" class="section-link">See all caravans →</a>
      </div>

      {featured.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">Featured listings coming soon</div>
          <p>We are loading our caravan inventory into the new site. Check back shortly, or browse the full stock list.</p>
          <p style="margin-top:16px;"><a href="/stock" class="section-link">Browse all stock →</a></p>
        </div>
      ) : (
        <div class="stock-grid">
          {featured.map((c) => (
            <a href={`/stock/${c.slug.current}`} class="caravan-card">
              {c.mainImage ? (
                <img
                  src={sanityImage(c.mainImage, { w: 640 })}
                  srcset={sanitySrcset(c.mainImage, [320, 480, 640, 960])}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  alt={c.title}
                  loading="lazy"
                />
              ) : (
                <div style="aspect-ratio:16/10; background:#E8E0D0; display:flex; align-items:center; justify-content:center; color:#8B6A40; font-size:0.85rem;">No photo yet</div>
              )}
              <div class="card-body">
                {c.condition && conditionLabel(c.condition) && (
                  <span class={`condition-badge condition-${c.condition}`}>{conditionLabel(c.condition)}</span>
                )}
                {c.brand && <div class="card-brand">{c.brand}</div>}
                <div class="card-title">{c.title}</div>
                <div class="card-price">${c.price?.toLocaleString('en-AU')}</div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Why SEQ band -->
  <section class="band-dark">
    <div class="container">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:32px; text-align:center;">
        <div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:2rem; font-weight:700; color:#F4EDE0;">30+</div>
          <div style="color:#D4943A; font-size:0.85rem; margin-top:6px;">Years in the industry</div>
        </div>
        <div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:2rem; font-weight:700; color:#F4EDE0;">2,000+</div>
          <div style="color:#D4943A; font-size:0.85rem; margin-top:6px;">YouTube subscribers</div>
        </div>
        <div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:2rem; font-weight:700; color:#F4EDE0;">QLD</div>
          <div style="color:#D4943A; font-size:0.85rem; margin-top:6px;">Sunshine Coast dealer</div>
        </div>
        <div>
          <div style="font-family:'Inter Tight', sans-serif; font-size:2rem; font-weight:700; color:#F4EDE0;">2</div>
          <div style="color:#D4943A; font-size:0.85rem; margin-top:6px;">Premier brands stocked</div>
        </div>
      </div>
    </div>
  </section>
</Site>
