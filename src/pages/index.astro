---
import Site from '../layouts/Site.astro'
import CaravanCard from '../components/CaravanCard.astro'
import VideoCard from '../components/VideoCard.astro'
import TrustStrip from '../components/TrustStrip.astro'
import ReserveCta from '../components/ReserveCta.astro'
import YoutubeSubscribeBar from '../components/YoutubeSubscribeBar.astro'
import { getSiteSettings, getBusinessDetails, sanityImage, conditionLabel, youtubeId, getHappeningsFeed, shortDate } from '../lib/sanity.js'

let settings = null
try {
  settings = await getSiteSettings()
} catch (err) {
  console.warn('Sanity unreachable on build:', err.message)
}

// Business details for the LocalBusiness / AutoDealer JSON-LD below. Each value
// keeps the current hardcoded literal as a fallback so the structured data is
// unchanged until Maud creates the record and never breaks if Sanity is down.
const biz = await getBusinessDetails()
const ldTelephone = biz?.phoneHref || '+61-7-5370-7933'
const ldEmail = biz?.emailOffice || 'sales@seqcampers.com.au'
const ldStreet = biz?.addressStreet || '3B/6 Bonanza Court'
const ldLocality = biz?.addressSuburb || 'Marcoola'
const ldRegion = biz?.addressState || 'QLD'
const ldPostcode = biz?.addressPostcode || '4564'

// Hero video resolution: Sanity siteSettings.heroVideo.youtubeUrl wins when
// set. Falls back to the self-hosted /hero-video.mp4 so the page still works
// if the field is empty or Sanity is unreachable.
// Per Bart 16 Jun: Kyle was pasting YouTube URLs into the field and they
// were ignored because the hero used to be hardcoded MP4. This wires them
// up properly.
const heroYouTubeId = settings?.heroVideo?.youtubeUrl
  ? youtubeId(settings.heroVideo.youtubeUrl)
  : null

// Pathway tile defaults - used when Maud hasn't filled a slot in Site
// Settings → Home page videos (Watch / Visit / Adventure).
const PATHWAY_DEFAULTS = [
  { videoId: 'tozC7prVbOg', sub: 'Our video library - every model, Kimberley Kampers and Stockman Products.' },
  { videoId: 'xYf81xUZtNE', sub: 'Pre-loved and new display vans available now.' },
  { videoId: 'WwgapQt3xO4', sub: 'From our driveway to your driveway. Camping support.' },
]

function resolvePathway(idx) {
  const slot = settings?.[`homepageVideo${idx + 1}`]
  const fallback = PATHWAY_DEFAULTS[idx]
  const videoId = (slot?.youtubeUrl && youtubeId(slot.youtubeUrl)) || fallback.videoId
  const sub = (slot?.description && slot.description.trim()) || fallback.sub
  return { videoId, sub }
}

const pathwayWatch = resolvePathway(0)
const pathwayVisit = resolvePathway(1)
const pathwayAdventure = resolvePathway(2)

// Shane's Pick - resolve from siteSettings, fall back to a static placeholder
// so the section always renders. Maud sets this anytime in
// Sanity Studio > Site Settings > Shane's Pick.
const PLACEHOLDER_SHANES_PICK_CARAVAN = {
  _id: 'placeholder-shanes-pick',
  title: 'Kimberley Karavan 2024',
  slug: { current: 'stock' },
  brand: 'Kimberley Kampers',
  price: 145000,
  condition: 'excellent',
  mainImage: null,
  specs: { sleeps: 4, length: 5.8, tareWeight: 2680 },
}
const shanesPick = settings?.shanesPick?.caravan
  ? {
      caravan: settings.shanesPick.caravan,
      originalPrice: settings.shanesPick.originalPrice,
      quote: settings.shanesPick.shanesQuote,
      status: settings.shanesPick.status || 'hidden',
      isPlaceholder: false,
    }
  : {
      caravan: PLACEHOLDER_SHANES_PICK_CARAVAN,
      originalPrice: null,
      quote: 'Shane has not picked a caravan yet. Browse the full stock list to see what is currently available, or call us on (07) 5370 7933.',
      status: 'hidden',
      isPlaceholder: true,
    }

// Placeholder testimonials - Maud to replace with real customer quotes.
// Format intentionally specific (full name + suburb + caravan + star rating)
// because the audit found Kimberley + Stockman both lack this trust signal.
// Real Google reviews - verbatim, names + attribution preserved.
// Editable in Studio (Home page -> Testimonials); the array below is the
// fallback used until that field is filled in / if Sanity is unreachable.
const TESTIMONIALS_FALLBACK = [
  {
    quote: "A huge shout out to SEQ Campers. While traveling we found one of our guide rollers kept coming off the track, after inspecting them discovered the others were in bad shape. A phone call to SEQ campers and a conversation with Shane had us diverting to their workshop, where Grant took control and sorted our van out - he and the crew gave it a thorough check over. The service was something we didn't expect at such short notice, but was very much appreciated as it saved us the hassle of doing that fiddly job while on the road. Thanks fellas!",
    name: "Willie & Cathy",
    source: "Catherine Fabris · Google review",
    rating: 5,
  },
  {
    quote: "Great customer service. We brought a karavan under consignment from Shane and Maud, which was a great experience. After using the van, we noticed some issues with it and contacted the SEQ campers team. They were very helpful and carried out the repairs required under warranty. Upon picking the van up, workshop manager Grant was very kind and spent the time to explain the repairs they had carried out. This was appreciated, and I wouldn't hesitate to recommend any of my friends or family to this business.",
    name: "David Poole",
    source: "Google review",
    rating: 5,
  },
  {
    quote: "We purchased a second hand KK to do WA while waiting for a new build. The knowledge and after-sales support was fantastic. The handover and after-sale support was great - it shortened the learning curve significantly. When we sold the van 6 months later they had potential buyers before I could deliver the van. We received the new van and there were some issues but Maud and the team handled everything necessary to rectify everything. Recently they added a bbq table custom made for my Weber - it is fantastic, one less table to carry on the road. I can only say positive things about the relationship I have with the team at SEQ Campers.",
    name: "T Ireland",
    source: "Google Local Guide review",
    rating: 5,
  },
]

// Testimonials: use the Sanity-managed list when it has entries, otherwise the
// verbatim Google-review fallback above. Keeps the live site identical until
// Maud adds testimonials in Studio.
const testimonials = settings?.testimonials?.length ? settings.testimonials : TESTIMONIALS_FALLBACK

// Section copy - read from Sanity with the current literals as fallbacks so
// nothing changes on the live site until each field is filled in.
const reviewsCounter = settings?.reviewsCounter || '35+ five-star reviews from SEQ owners'
const pathwayEyebrow = settings?.pathwayEyebrow || 'How it works'
const pathwayHeading = settings?.pathwayHeading || 'Three steps to your next off-road adventure.'
const pathwayIntro = settings?.pathwayIntro || 'From browsing off-road caravans and off-grid hybrids to driving away from our Marcoola showroom on the Sunshine Coast - the way SEQ Campers does it.'
const testimonialsEyebrow = settings?.testimonialsEyebrow || 'In their own words'
const testimonialsHeading = settings?.testimonialsHeading || 'Real off-road owners, real trips, real stories'
const testimonialsIntro = settings?.testimonialsIntro || "From Kimberley Karavan and Kruiser owners exploring the outback to Stockman Trekka and Rover families chasing off-grid camping weekends - here's what they have to say about SEQ Campers."
const happeningEyebrow = settings?.happeningEyebrow || "What's happening"
const happeningHeading = settings?.happeningHeading || 'News from the showroom floor'

// The reviews counter bolds the "N five-star reviews" clause. Split on the
// word "reviews" so the count + label are bold and the trailing text is not,
// matching the original hardcoded markup ("35+ five-star reviews" bold,
// "from SEQ owners" regular). Falls back gracefully if the pattern differs.
const reviewsCounterMatch = reviewsCounter.match(/^(.*?reviews)(.*)$/i)
const reviewsCounterBold = reviewsCounterMatch ? reviewsCounterMatch[1] : reviewsCounter
const reviewsCounterRest = reviewsCounterMatch ? reviewsCounterMatch[2] : ''

// What's Happening (homepage view). Pulls from Sanity - getHappeningsFeed
// merges editor "What's Happening" items with upcoming/active shows so a show
// added in Studio appears here automatically. Newest 3 flagged for homepage.
let happeningsFeed = []
try {
  happeningsFeed = await getHappeningsFeed()
} catch (err) {
  console.warn('Sanity unreachable for homepage feed:', err.message)
}
const homeFeed = happeningsFeed.filter((i) => i.showOnHomepage).slice(0, 3)

const typeColors = {
  'New Arrival': 'rust',
  'Handover': 'green',
  'Event': 'gold',
  'New Video': 'blue',
  'Workshop': 'muted',
  'News': 'muted',
}

// LocalBusiness schema - tells Google/AI "we are an Australian caravan dealer"
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': 'https://seqcampers.com.au/#business',
  name: 'SEQ Campers',
  description: "Premium off-road caravan dealer on the Sunshine Coast, Queensland. Hand-picked Kimberley Kampers and Stockman Products stock. Off-road camping experts since 2013.",
  url: 'https://seqcampers.com.au',
  telephone: ldTelephone,
  email: ldEmail,
  areaServed: { '@type': 'State', name: 'Queensland, Australia' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: ldStreet,
    addressLocality: ldLocality,
    addressRegion: ldRegion,
    postalCode: ldPostcode,
    addressCountry: 'AU',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:30', closes: '15:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:30', closes: '12:30' },
  ],
  priceRange: '$$$',
  knowsAbout: ['Kimberley Kampers', 'Stockman Caravans', 'Off-road caravans', 'Caravan inspections', 'Sunshine Coast caravan dealer'],
  sameAs: ['https://www.youtube.com/channel/UCOeiI-wxOLUCX1UzMiE6XVg'],
}

// FAQ schema - direct answers AI search engines can quote
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What brands of caravan does SEQ Campers stock?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers specialises in premium off-road caravans from Kimberley Kampers and Stockman Products. Every van on the lot is hand-picked, inspected, and prepared by Shane and the SEQ team before it goes on sale.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is SEQ Campers located?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SEQ Campers operates from the Sunshine Coast in Queensland, Australia. Visits are by appointment. Call (07) 5370 7933 to book a time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are SEQ Campers caravans inspected before sale?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Shane personally inspects every caravan that comes through SEQ Campers. We have on-site mechanics, roadworthy inspections, and full pre-delivery preparation as part of the sale process.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long has SEQ Campers been operating?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "SEQ Campers has been the Sunshine Coast home of premium off-road caravans since 2013, building on Kimberley Kampers' 30-year Australian heritage. We also run a YouTube channel with more than 2,000 subscribers where Shane walks through every caravan in detail.",
      },
    },
    {
      '@type': 'Question',
      name: 'Can SEQ Campers help with caravan handover and delivery?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Handover happens on the SEQ premises. We walk you through the van, run you through the systems, and have mechanics on site if anything needs adjusting before you tow it home.',
      },
    },
  ],
}
---

<Site
  title="Premium Off-Road Caravans"
  description="SEQ Campers - the Sunshine Coast home of off-road caravan and off-grid camping Australia. Hand-picked Kimberley Kampers (Karavan, Kube, Kruiswagen, Kruiser) and Stockman Products (Trekka, Rover, Pod) off-grid caravans and 4x4 camper vans. Authorised dealer for Queensland. Off-road camping experts since 2013."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusiness)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero - silent looping video. No text overlay - the brand reads through
       the header logo + the video itself. A transparent click-blocker layer
       sits over the iframe so user mouseover never triggers YouTube's chrome
       (the controls that occasionally flicker in). -->
  <section class="hero hero-video hero-video-clean">
    <div class="hero-video-bg" aria-hidden="true">
      {heroYouTubeId ? (
        <iframe
          class="hero-video-iframe"
          src={`https://www.youtube-nocookie.com/embed/${heroYouTubeId}?autoplay=1&mute=1&loop=1&playlist=${heroYouTubeId}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0`}
          title="Home page hero video"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen="false"
          tabindex="-1"
          inert
          loading="eager"
        ></iframe>
      ) : (
        <video
          class="hero-video-mp4"
          src="/hero-video.mp4"
          poster="/hero-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          disablepictureinpicture
          controlslist="nodownload nofullscreen noremoteplayback"
          tabindex="-1"
        ></video>
      )}
      <div class="hero-video-block" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Media Session blockade now lives site-wide in Site.astro - covers every
       autoplay video on every page (hero, pathway, BrollCard, /new tiles,
       /quote intro, /service team + workshop, /shows compilation). -->


  <!-- Three pathway video tiles (Kimberley-style 4-box pattern but with 3 +
       video-backgrounds). Shane's preferred home page architecture: compact
       side-by-side boxes with looping muted B-roll inside, mountain icon and
       label overlaid. Click goes down the relevant "tree". -->
  <section class="section pathway-tiles-section" aria-label="Three steps to your next adventure">
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:4px; margin-bottom:18px;">
        <div class="page-eyebrow" style="color:var(--rust);">{pathwayEyebrow}</div>
        <h2 class="section-title">{pathwayHeading}</h2>
        <p style="color:var(--muted); font-size:0.98rem; margin-top:6px; max-width:620px; margin-left:auto; margin-right:auto;">
          {pathwayIntro}
        </p>
      </div>

      <div class="pathway-tile-grid">
        {[
          { href: '/videos', label: '1. Watch', sub: pathwayWatch.sub, videoId: pathwayWatch.videoId, variant: 'watch' },
          { href: '/stock', label: '2. Visit', sub: pathwayVisit.sub, videoId: pathwayVisit.videoId, variant: 'visit' },
          { href: '/service', label: '3. Adventure', sub: pathwayAdventure.sub, videoId: pathwayAdventure.videoId, variant: 'adventure' },
        ].map((p) => (
          <a href={p.href} class={`pathway-tile pathway-tile-${p.variant}`}>
            <div class="pathway-tile-media">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${p.videoId}?autoplay=1&mute=1&loop=1&playlist=${p.videoId}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0`}
                title={p.label}
                frameborder="0"
                allow="autoplay; encrypted-media"
                allowfullscreen="false"
                tabindex="-1"
                inert
                loading="lazy"
              ></iframe>
              <div class="pathway-tile-block" aria-hidden="true"></div>
            </div>
            <div class="pathway-tile-meta">
              <div class="pathway-tile-label">{p.label}</div>
              <div class="pathway-tile-sub">{p.sub}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Google reviews social proof - display only, no exit link. Per Bart:
       keep visitors on site. Clicking the bar smooth-scrolls to the
       testimonials section lower on the page. -->
  <div class="reviews-bar">
    <div class="container">
      <a href="#testimonials" class="reviews-bar-inner">
        <span class="reviews-stars" aria-hidden="true">★★★★★</span>
        <span class="reviews-text"><strong>{reviewsCounterBold}</strong>{reviewsCounterRest}</span>
        <span class="reviews-link">See what they say</span>
      </a>
    </div>
  </div>

  <!-- Shane's Pick / Sale of the Week - replaces the YouTube grid per Bart.
       Higher conversion than a 3-card browse grid: single focal point,
       Shane's personal endorsement, urgency narrative, one clear CTA. -->
  {shanesPick && (
    <section class="section" style="background:var(--sand-deep); padding-top:48px; padding-bottom:48px;">
      <div class="container">
        <div class="section-header">
          <div>
            <div class="page-eyebrow" style="color:var(--rust);">Sale of the week</div>
            <h2 class="section-title">
              Shane's Pick
              {shanesPick.status === 'available-now' && (
                <span class="shanes-pick-status shanes-pick-status-available" aria-label="Available now">Available now</span>
              )}
              {shanesPick.status === 'coming-soon' && (
                <span class="shanes-pick-status shanes-pick-status-soon" aria-label="Coming soon">Coming soon</span>
              )}
            </h2>
          </div>
          <a href={`/stock/${shanesPick.caravan.slug?.current}`} class="section-link">View this listing →</a>
        </div>

        <div class="shanes-pick">
          <div class="shanes-pick-photo">
            {shanesPick.caravan.mainImage ? (
              <img src={sanityImage(shanesPick.caravan.mainImage, { w: 800 })} alt={shanesPick.caravan.title} />
            ) : (
              <div class="caravan-card-noimg">No photo yet</div>
            )}
            <span class="shanes-pick-badge">Shane's Pick</span>
          </div>
          <div class="shanes-pick-body">
            {shanesPick.caravan.condition && conditionLabel(shanesPick.caravan.condition) && (
              <span class={`condition-badge condition-${shanesPick.caravan.condition}`}>{conditionLabel(shanesPick.caravan.condition)}</span>
            )}
            {shanesPick.caravan.brand && <div class="card-brand" style="margin-top:8px;">{shanesPick.caravan.brand}</div>}
            <h3 class="shanes-pick-title">{shanesPick.caravan.title}</h3>
            <div class="shanes-pick-prices">
              {shanesPick.originalPrice && (
                <span class="shanes-pick-original">${shanesPick.originalPrice.toLocaleString('en-AU')}</span>
              )}
              <span class="shanes-pick-price">${shanesPick.caravan.price?.toLocaleString('en-AU')}</span>
            </div>
            {shanesPick.quote && (
              <blockquote class="shanes-pick-quote">
                "{shanesPick.quote}"
                <cite>- SEQ team</cite>
              </blockquote>
            )}
            {shanesPick.caravan.specs && (
              <div class="shanes-pick-specs">
                {shanesPick.caravan.specs.sleeps && <div><span>Sleeps</span><strong>{shanesPick.caravan.specs.sleeps}</strong></div>}
                {shanesPick.caravan.specs.length && <div><span>Length</span><strong>{shanesPick.caravan.specs.length}m</strong></div>}
                {shanesPick.caravan.specs.tareWeight && <div><span>Tare</span><strong>{shanesPick.caravan.specs.tareWeight}kg</strong></div>}
              </div>
            )}
            <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:18px;">
              <a href={`/stock/${shanesPick.caravan.slug?.current}`} class="btn-primary">View this listing</a>
              <a href="/stock" class="btn-ghost" style="background:rgba(42,22,8,0.06); color:var(--ink); border-color:var(--tan-border);">See all stock</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <style>
    /* Three Pathway Tiles - Kimberley-style side-by-side video boxes.
       Default state: still YouTube thumbnail. Hover/touch: iframe swaps in
       and auto-plays muted. Mouse-leave clears the iframe so multiple tiles
       never play at once. */
    .pathway-tiles-section {
      padding-top: 32px;
      padding-bottom: 32px;
    }
    /* Pathway tiles - landscape 16:9 cards matching the /stock BrollCard
       pattern per Shane's request 16 Jun. Each tile auto-plays its YouTube
       video muted and looping, with the label + sub rendered below the
       video (not overlaid). */
    .pathway-tile-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    @media (max-width: 880px) {
      .pathway-tile-grid { grid-template-columns: 1fr; gap: 14px; }
    }
    .pathway-tile {
      display: block;
      background: #fff;
      border: 1px solid var(--tan-border, #DCCBA8);
      border-radius: 10px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }
    .pathway-tile:hover {
      transform: translateY(-3px);
      border-color: var(--rust, #C0341A);
      box-shadow: 0 10px 28px rgba(42, 22, 8, 0.14);
    }
    .pathway-tile-media {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #1a1a1c;
      overflow: hidden;
    }
    .pathway-tile-media iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.78%;
      height: 100%;
      min-width: 100%;
      min-height: 56.25vw;
      transform: translate(-50%, -50%);
      border: 0;
    }
    .pathway-tile-block {
      position: absolute;
      inset: 0;
      z-index: 5;
      background: transparent;
      pointer-events: auto;
    }
    .pathway-tile-meta {
      padding: 14px 16px 16px;
    }
    .pathway-tile-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      color: var(--ink, #2A1608);
      font-size: 1.15rem;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
    .pathway-tile-sub {
      margin-top: 4px;
      color: var(--muted, #8B6A40);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    /* Hero video section: full viewport height. Uses 100dvh (dynamic
       viewport height) on modern browsers so the URL bar on mobile Safari
       doesn't shift the hero off-screen. Falls back to 100vh on older
       browsers. */
    :global(.hero-video.hero-video-clean) {
      padding: 0 !important;
      min-height: 100vh !important;
      min-height: 100dvh !important;
      height: 100vh;
      height: 100dvh;
    }
    :global(.hero-video-mp4) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      border: 0;
      pointer-events: none;
    }
    /* Aggressively hide every browser-native media control on the hero MP4.
       Without these, Chrome/Safari surface skip-back / pause / skip-forward
       icons on hover (the "global media controls" overlay) which kills the
       cinematic feel Shane wants. */
    :global(.hero-video-mp4::-webkit-media-controls),
    :global(.hero-video-mp4::-webkit-media-controls-panel),
    :global(.hero-video-mp4::-webkit-media-controls-play-button),
    :global(.hero-video-mp4::-webkit-media-controls-start-playback-button),
    :global(.hero-video-mp4::-webkit-media-controls-overlay-play-button),
    :global(.hero-video-mp4::-webkit-media-controls-enclosure),
    :global(.hero-video-mp4::-webkit-media-controls-current-time-display),
    :global(.hero-video-mp4::-webkit-media-controls-time-remaining-display),
    :global(.hero-video-mp4::-webkit-media-controls-timeline),
    :global(.hero-video-mp4::-webkit-media-controls-volume-slider),
    :global(.hero-video-mp4::-webkit-media-controls-mute-button),
    :global(.hero-video-mp4::-webkit-media-controls-fullscreen-button) {
      display: none !important;
      -webkit-appearance: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
    /* hero-video-block sits over the video element to intercept ALL pointer
       events so the browser's hover-media-controls never trigger. Critical
       for keeping the hero clean. */
    :global(.hero-video-block) {
      position: absolute;
      inset: 0;
      z-index: 10;
      background: transparent;
      pointer-events: auto;
      cursor: default;
    }
    /* YouTube iframe needs a wider-than-100% trick so the 16:9 video covers
       the full viewport-height hero box without letterboxing. */
    :global(.hero-video-iframe) {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.78vh;
      height: 100vh;
      min-width: 100vw;
      min-height: 56.25vw;
      transform: translate(-50%, -50%);
      border: 0;
      pointer-events: none;
    }
    @media (max-width: 768px) {
      :global(.hero-video.hero-video-clean) {
        min-height: 85vh !important;
        height: 85vh;
      }
      :global(.hero-video-iframe) {
        width: 177.78vh;
        height: 85vh;
        min-height: 47.81vw;
      }
    }

    /* Shane's Pick status pill - sits next to the Shane's Pick heading.
       "Coming soon" = orange amber. "Available now" = green. Maud picks
       which one shows in Sanity Studio. Per Bart 8 Jun. */
    .shanes-pick-status {
      display: inline-block;
      vertical-align: middle;
      margin-left: 12px;
      padding: 5px 12px;
      border-radius: 999px;
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #fff;
      line-height: 1;
    }
    .shanes-pick-status-available {
      background: linear-gradient(135deg, #2BA85F 0%, #1F8049 100%);
      box-shadow: 0 4px 14px rgba(43, 168, 95, 0.30);
    }
    .shanes-pick-status-soon {
      background: linear-gradient(135deg, #E58A2A 0%, #B45D10 100%);
      box-shadow: 0 4px 14px rgba(229, 138, 42, 0.30);
    }
  </style>

  <!-- Testimonials - lives below Shane's Pick. Reviews bar above scrolls
       here. Real Google reviews. No external link out - keeps visitors
       on the site. -->
  <section id="testimonials" class="section">
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:4px; margin-bottom:8px;">
        <div class="page-eyebrow" style="color:var(--rust);">{testimonialsEyebrow}</div>
        <h2 class="section-title">{testimonialsHeading}</h2>
        <p style="color:var(--muted); font-size:0.98rem; margin-top:6px; max-width:620px; margin-left:auto; margin-right:auto; text-align:center;">
          {testimonialsIntro}
        </p>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((t) => {
          const stars = Math.max(1, Math.min(5, Number(t.rating) || 5))
          return (
          <figure class="testimonial-card">
            <div class="testimonial-stars" aria-label={`${stars} out of 5 stars`}>
              {Array.from({ length: stars }).map(() => <span aria-hidden="true">★</span>)}
            </div>
            <blockquote class="testimonial-quote">"{t.quote}"</blockquote>
            <figcaption class="testimonial-meta">
              <div class="testimonial-name">{t.name}</div>
              <div class="testimonial-sub">{t.source}</div>
            </figcaption>
          </figure>
        )})}
      </div>
    </div>
  </section>

  <!-- What's Happening - shows + editor news from Sanity (newest 3). Hidden
       when the feed is empty. Full list lives at /whats-happening. -->
  {homeFeed.length > 0 && (
    <section class="section" style="background:var(--sand-deep); padding-top:56px; padding-bottom:56px;">
      <div class="container" style="max-width:880px;">
        <div class="section-header" style="margin-bottom:28px;">
          <div>
            <div class="page-eyebrow" style="color:var(--rust);">{happeningEyebrow}</div>
            <h2 class="section-title">{happeningHeading}</h2>
          </div>
          <a href="/whats-happening" class="section-link">See all →</a>
        </div>
        <div class="news-timeline">
          {homeFeed.map((n) => (
            <article class="news-item">
              <div class="news-date">{shortDate(n.date)}</div>
              <div class="news-body">
                <span class={`news-type news-type-${typeColors[n.type] || 'muted'}`}>{n.type}</span>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
                {n.link && (
                  <a
                    href={n.link}
                    {...(/^https?:\/\//i.test(n.link) ? { rel: 'noopener', target: '_blank' } : {})}
                    style="color:var(--rust); font-weight:600; text-decoration:none;"
                  >Read more →</a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <YoutubeSubscribeBar variant="bar" />
  <ReserveCta variant="band" />
</Site>

