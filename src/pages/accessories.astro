---
import Site from '../layouts/Site.astro'
import ReserveCta from '../components/ReserveCta.astro'
import { getAccessoriesPage, getAccessories, sanityImage, sanitySrcset, youtubeId } from '../lib/sanity.js'

let page = null
let realAccessories = []
try {
  page = await getAccessoriesPage()
  realAccessories = await getAccessories()
} catch (err) {
  console.warn('Sanity unreachable for /accessories:', err.message)
}

const intro = (page?.intro && page.intro.trim())
  || 'Genuine off-grid gear, fitted by our workshop and shipped Australia-wide. Browse below and order or register your interest - we confirm and invoice before delivery or fitting.'
const videoUrl = (page?.heroVideo?.youtubeUrl && page.heroVideo.youtubeUrl.trim())
  || 'https://www.youtube.com/watch?v=gq72bwiG-eI'
const videoId = youtubeId(videoUrl)
const videoCaption = page?.heroVideo?.caption || ''

// SAMPLE accessory (Off-Grid Toilets) - shown ONLY while no real accessory
// documents exist in Sanity, so it disappears automatically the moment SEQ
// adds the first real one. Lets us preview the exact rich layout now.
const SAMPLE_ACCESSORIES = [
  {
    _id: 'sample-toilets',
    title: 'Off-Grid Toilets',
    eyebrow: 'Composting & sealing',
    badges: ['Certified Installer', 'Waterless', 'Chemical-free', 'No dump points'],
    intro:
      'SEQ Campers is a certified installer of CompoCloset off-grid toilets. Two ways to ditch the chemical cassette: the Cuddy composting toilet (in stock now) and the new S1 dry-flush sealing toilet (pre-order). Come and see both at our Marcoola showroom, or order below.',
    photos: [],
    products: [
      {
        name: 'Cuddy Composting Toilet',
        brand: 'CompoCloset',
        type: 'Composting · waterless · smell-free',
        tag: 'In stock',
        tagColor: 'green',
        price: '$1,795',
        priceNote: 'Indicative - confirm with SEQ · 24-month warranty',
        pitch:
          'The best-value true composting toilet on the market. Separates liquids and solids, composts with a natural bulking agent, and stays odour-free with a carbon filter and fan.',
        features: ['No water, chemicals or dump points', '"Pee Full" LED level indicator', 'Manual agitator + carbon filter', 'Portable or wall-mount installable'],
        specs: ['422×385×432mm', '9.5kg', 'Solids 14.7L', 'Liquids 6.5L'],
      },
      {
        name: 'S1 Dry Flush Sealing Toilet',
        brand: 'CompoCloset',
        type: 'Sealing · waterless · push-button',
        tag: 'Pre-order',
        tagColor: 'rust',
        price: 'Pre-order',
        priceNote: 'On display at our showroom - see it, then pre-order',
        pitch:
          "The world's first separating sealing toilet. Push a button and solids are automatically heat-sealed in a bag - no composting, no layering, no smell. Urine diverts separately.",
        features: ['Automatic battery heat-seal - 50+ per charge', 'Built-in urine diversion, LED indicator', '~25 uses per liner roll · backup mode', 'On display at SEQ Campers to view before you pre-order'],
        specs: ['432×386×419mm', '13.2kg', 'Solids 15.7L', 'Urine 6.4L'],
      },
    ],
    compareHeading: 'Composting or sealing - which suits you?',
    compareIntro: 'Both are waterless, chemical-free and divert urine separately. The difference is what happens to the solids.',
    compareColumns: [
      { heading: 'Cuddy - Composting', body: 'Solids drop onto a natural bulking agent and break down over time. A front crank agitator mixes it; a carbon filter and fan keep it fresh.', note: 'Empty the solids bin roughly every 2-3 weeks for two. No power, no consumables, lowest running cost. In stock now.' },
      { heading: 'S1 - Sealing', body: 'Each solid use is hermetically heat-sealed in a bag at the push of a button - nothing to compost, nothing to see or smell.', note: 'Battery sealer (50+ seals/charge), ~25 uses per liner roll, with a backup diverting mode if you run out. Pre-order - with one on display at SEQ Campers to view first.' },
    ],
    compareNote: '',
  },
  {
    _id: 'sample-movers',
    title: 'Optitec Caravan Movers',
    eyebrow: 'Remote-control movers',
    badges: ['Remote control', 'Fully portable', 'Free shipping', 'No underbody install'],
    intro: "Reverse your van into any spot at the push of a button - no yelling, no stress, no expensive underbody install. Three Optitec movers: the wheeled Optimover V3 for hard surfaces, and the tracked All-Terrain 2500 and 4500 for grass, gravel and off-road. Not sure which? Use the quick guide below, or order online and we'll confirm the right fit.",
    photos: [],
    products: [
      { name: 'Optimover V3', brand: 'Optitec', type: 'Wheeled remote jockey wheel', tag: 'On-road', tagColor: 'olive', price: '$2,625', priceNote: 'Moves up to 3,500kg · hard surfaces · + clamp from $180', pitch: "The original remote-control jockey wheel - drives your van's own wheels to reverse and park it anywhere on firm ground.", features: ['12V DC, 50A high-torque motor', 'Single or double axle · tow-ball to 350kg', '3-year motor & transmission warranty', 'Clamp $180: OW14 (100-130mm) or OW15 (150mm)', 'Optional carry & storage bag - $140'], specs: ['22kg', 'Remote + cables incl.'] },
      { name: 'All Terrain 2500', brand: 'Optitec', type: 'Tracked off-road mover', tag: 'Off-road', tagColor: 'rust', price: '$4,500-$4,550', priceNote: 'Up to 2,500kg off-road · price depends on bracket', pitch: 'Track tyres built to go off-road. Ready for challenging sites with small to medium vans and trailers.', features: ['2 motors (288W each)', 'Moves 10m per minute under load', 'Fast-charging long-life battery as standard', 'Standard bracket (50mm) $4,500, or Universal $4,550'], specs: ['34kg', '540×470×210mm', '2yr warranty'] },
      { name: 'All Terrain 4500', brand: 'Optitec', type: 'Tracked off-road mover', tag: 'Off-road · HD', tagColor: 'gold', price: '$5,400-$5,450', priceNote: 'Up to 4,500kg off-road · price depends on bracket', pitch: 'The most powerful Optitec. Four motors and rubber tracks for the heaviest vans in the most challenging scenarios.', features: ['4 motors (288W each)', 'Moves 7m per minute under load', 'Fast-charging long-life battery as standard', 'Standard bracket (50mm) $5,400, or Universal $5,450'], specs: ['42kg', '540×470×210mm', '2yr warranty'] },
    ],
    compareHeading: 'Which mover do I need?',
    compareIntro: "Two quick questions sort it - what you'll drive it on, and how heavy your rig is.",
    compareColumns: [
      { heading: '1. What surface?', body: 'Hard & paved (concrete, bitumen, pavers, firm ground): the Optimover V3.', note: 'Grass, gravel, dirt, sand or inclines: a tracked All-Terrain mover.' },
      { heading: '2. How heavy is your rig?', body: 'Up to 3,500kg on firm ground: Optimover V3. Up to 2,500kg off-road: All Terrain 2500.', note: 'Up to 4,500kg / heaviest vans: All Terrain 4500.' },
    ],
    compareNote: "The short version: the V3 is a wheeled remote jockey wheel for hard ground; the All-Terrain 2500 and 4500 are tracked units that clamp to the drawbar and grip off-road. All three are remote-controlled and fully portable. The V3 takes an OW14 (100-130mm) or OW15 (150mm) clamp ($180), with an optional carry & storage bag ($140). The All-Terrain movers include a Standard (50mm) or Universal (50/75/100/130mm, +$50) bracket - that's the only reason for their price range. Still unsure? Tell us your van and we'll match it.",
  },
]

const usingSample = realAccessories.length === 0
const accessories = usingSample ? SAMPLE_ACCESSORIES : realAccessories

// Flatten every product name into the order form's dropdown.
const productOptions = []
for (const a of accessories) {
  for (const p of (a.products || [])) {
    if (p?.name) productOptions.push({ name: p.name, price: p.price })
  }
}

// Every product uses the SAME simple flow: one button -> one form -> SEQ
// emails an invoice. No "orderable vs enquiry-only" distinction to manage.

const description = 'Off-grid caravan accessories from SEQ Campers on the Sunshine Coast - composting and sealing toilets and more. Certified installer. Order online, we invoice before delivery or fitting.'
---

<Site title="Accessories" description={description}>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>Accessories</h1>
      <p>{intro}</p>
    </div>
  </div>

  {videoId && (
    <section class="section" style="padding-top:24px; padding-bottom:8px;">
      <div class="container" style="max-width:880px;">
        <div class="acc-video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=1&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1`}
            title="SEQ Campers accessories"
            frameborder="0"
            allow="autoplay; encrypted-media; fullscreen"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        {videoCaption && <p class="acc-video-caption">{videoCaption}</p>}
      </div>
    </section>
  )}

  {accessories.length > 1 && (
    <nav class="acc-submenu" aria-label="What we sell">
      <div class="container" style="max-width:1040px;">
        <span class="acc-submenu-label">What we sell:</span>
        {accessories.map((a, i) => (
          <a class="acc-submenu-link" href={`#acc-${i + 1}`}>{a.navLabel || a.title}</a>
        ))}
      </div>
    </nav>
  )}

  {accessories.map((a, i) => (
    <section id={`acc-${i + 1}`} class="section acc-section" style="padding-top:32px; padding-bottom:8px; scroll-margin-top:90px;">
      <div class="container" style="max-width:1040px;">
        <div class="acc-head">
          {a.eyebrow && <div class="acc-eyebrow">{a.eyebrow}</div>}
          <h2 class="acc-title">{a.title}</h2>
          {a.badges?.length > 0 && (
            <div class="acc-badges">
              {a.badges.map((b) => <span class="acc-pill">{b}</span>)}
            </div>
          )}
          {a.intro && <p class="acc-intro">{a.intro}</p>}
        </div>

        {a.products?.length > 0 && (
          <div class="acc-prods">
            {a.products.map((p) => (
              <div class="pcard">
                {p.photos?.length > 0 && (
                  <div class="pcard-media">
                    <img
                      class="gallery-img pcard-hero"
                      src={sanityImage(p.photos[0].url, { w: 800 })}
                      srcset={sanitySrcset(p.photos[0].url, [320, 480, 640, 800])}
                      sizes="(max-width: 760px) 100vw, 500px"
                      alt={p.photos[0].alt || p.name}
                      loading="lazy"
                      data-full={sanityImage(p.photos[0].url, { w: 1600 })}
                    />
                    {p.photos.length > 1 && (
                      <div class="pcard-thumbs">
                        {p.photos.slice(1).map((ph) => ph?.url && (
                          <img
                            class="gallery-img pcard-thumb"
                            src={sanityImage(ph.url, { w: 200 })}
                            alt={ph.alt || p.name}
                            loading="lazy"
                            data-full={sanityImage(ph.url, { w: 1600 })}
                          />
                        ))}
                      </div>
                    )}
                  </div>
                )}
                <div class="pcard-body">
                  <div class="pcard-top">
                    {p.brand && <span class="pcard-brand">{p.brand}</span>}
                    {p.tag && <span class={`pcard-state tag-${p.tagColor || 'rust'}`}>{p.tag}</span>}
                  </div>
                  <h3 class="pcard-name">{p.name}</h3>
                  {p.type && <div class="pcard-type">{p.type}</div>}
                  <div class="pcard-price">{p.price || 'Enquire'}{p.priceNote && <small>{p.priceNote}</small>}</div>
                  {p.pitch && <p class="pcard-pitch">{p.pitch}</p>}
                  {p.videoUrl && youtubeId(p.videoUrl) && (
                    <div class="pcard-video">
                      <iframe
                        src={`https://www.youtube-nocookie.com/embed/${youtubeId(p.videoUrl)}?rel=0&modestbranding=1&playsinline=1`}
                        title={`${p.name} walkthrough`}
                        frameborder="0"
                        allow="encrypted-media; fullscreen"
                        allowfullscreen
                        loading="lazy"
                      ></iframe>
                    </div>
                  )}
                  {p.features?.length > 0 && (
                    <ul class="pcard-ticks">
                      {p.features.map((f) => <li>{f}</li>)}
                    </ul>
                  )}
                  {p.specs?.length > 0 && (
                    <div class="pcard-specs">
                      {p.specs.map((s) => <span>{s}</span>)}
                    </div>
                  )}
                  <a href="#order" class="btn-primary pcard-cta order-btn" data-product={p.name}>Order this</a>
                </div>
              </div>
            ))}
          </div>
        )}

        {a.compareHeading && a.compareColumns?.length > 0 && (
          <div class="acc-compare">
            <h3>{a.compareHeading}</h3>
            {a.compareIntro && <p class="acc-compare-sub">{a.compareIntro}</p>}
            <div class="acc-compare-cols">
              {a.compareColumns.map((c) => (
                <div class="acc-compare-col">
                  {c.heading && <h4>{c.heading}</h4>}
                  {c.body && <p>{c.body}</p>}
                  {c.note && <p class="acc-compare-note">{c.note}</p>}
                </div>
              ))}
            </div>
            {a.compareNote && <p class="acc-compare-fullnote">{a.compareNote}</p>}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- ONE order form for all accessories. The product dropdown is built from
       every accessory's products, so SEQ never needs a new form. -->
  <section class="section" id="order" style="padding-top:24px; padding-bottom:48px;">
    <div class="container" style="max-width:760px;">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:14px;">
        <div class="page-eyebrow" style="color:var(--rust);">Order or register interest</div>
        <h2 class="section-title">Order an accessory.</h2>
        <p style="color:var(--muted); margin-top:6px; line-height:1.65;">
          No payment is taken here - we confirm and email you an invoice to pay, then arrange delivery or fitting. Pre-order items are taken as a pre-order. Or call us on <a href="tel:0753707933" style="color:var(--rust); font-weight:600;">(07) 5370 7933</a>.
        </p>
      </div>

      <form
        class="enquiry-form"
        name="accessory-order"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <input type="hidden" name="form-name" value="accessory-order" />
        <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <label>
          Product
          <select name="product" required>
            <option value="">-- Choose a product --</option>
            {productOptions.map((p) => (
              <option value={p.name}>{p.name}{p.price && p.price !== 'Pre-order' ? ` - ${p.price}` : ''}</option>
            ))}
            <option value="Not sure yet - please advise">Not sure yet - please advise</option>
          </select>
        </label>

        <div class="form-row">
          <label>Your name<input type="text" name="customer_name" required autocomplete="name" /></label>
          <label>Phone<input type="tel" name="customer_phone" required autocomplete="tel" placeholder="04xx xxx xxx" /></label>
        </div>
        <div class="form-row">
          <label>Email<input type="email" name="customer_email" required autocomplete="email" /></label>
          <label>Quantity<input type="number" name="quantity" min="1" value="1" /></label>
        </div>

        <label>
          Delivery or collection
          <select name="fulfilment" required>
            <option value="">-- Choose one --</option>
            <option value="Deliver to my address">Deliver to my address</option>
            <option value="Pick up from SEQ Campers (Marcoola)">Pick up from SEQ Campers (Marcoola)</option>
            <option value="Fit to my van/camper at SEQ Campers">Fit to my van/camper at SEQ Campers</option>
          </select>
        </label>

        <label>Delivery address (if delivering)<input type="text" name="address" autocomplete="street-address" /></label>
        <label>Notes (optional)<textarea name="message" placeholder="Anything we should know..."></textarea></label>

        <button type="submit" class="btn-primary">Submit order / enquiry</button>
        <p class="form-policy-note" style="font-size:0.82rem; color:var(--muted); margin: 10px 0 0;">
          SEQ Campers is a certified installer. We'll confirm your order and email an invoice to pay.
        </p>
      </form>
    </div>
  </section>

  <!-- Photo lightbox (shared) -->
  <div id="lightbox" class="lightbox" hidden aria-hidden="true">
    <button class="lb-btn lb-close" aria-label="Close">&times;</button>
    <button class="lb-btn lb-prev" aria-label="Previous photo">&#8249;</button>
    <img class="lb-img" src="" alt="" />
    <button class="lb-btn lb-next" aria-label="Next photo">&#8250;</button>
    <div class="lb-counter"></div>
  </div>

  <script is:inline>
    (function () {
      // Smooth-scroll the accessory sub-menu links to their section.
      document.querySelectorAll('.acc-submenu-link').forEach(function (a) {
        a.addEventListener('click', function (e) {
          var id = a.getAttribute('href')
          var target = id && document.querySelector(id)
          if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); history.replaceState(null, '', id) }
        })
      })

      // Pre-select the product in the order form when a card button is clicked.
      document.querySelectorAll('.order-btn[data-product]').forEach(function (b) {
        b.addEventListener('click', function () {
          var sel = document.querySelector('select[name="product"]')
          if (sel) {
            var want = b.getAttribute('data-product')
            for (var i = 0; i < sel.options.length; i++) {
              if (sel.options[i].value === want) { sel.selectedIndex = i; break }
            }
          }
        })
      })

      // Lightbox - scoped to the gallery the clicked photo belongs to.
      var box = document.getElementById('lightbox')
      if (!box) return
      var lbImg = box.querySelector('.lb-img')
      var counter = box.querySelector('.lb-counter')
      var urls = [], alts = [], idx = 0
      function show(i) { idx = (i + urls.length) % urls.length; lbImg.src = urls[idx]; lbImg.alt = alts[idx]; counter.textContent = (idx + 1) + ' / ' + urls.length }
      function close() { box.hidden = true; box.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; lbImg.src = '' }
      document.querySelectorAll('.gallery-img').forEach(function (im) {
        im.addEventListener('click', function () {
          var gallery = im.closest('.pcard-media') || document
          var imgs = Array.prototype.slice.call(gallery.querySelectorAll('.gallery-img'))
          urls = imgs.map(function (x) { return x.getAttribute('data-full') || x.src })
          alts = imgs.map(function (x) { return x.alt || '' })
          show(imgs.indexOf(im))
          box.hidden = false; box.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'
        })
      })
      box.querySelector('.lb-close').addEventListener('click', close)
      box.querySelector('.lb-prev').addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1) })
      box.querySelector('.lb-next').addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1) })
      box.addEventListener('click', function (e) { if (e.target === box) close() })
      document.addEventListener('keydown', function (e) {
        if (box.hidden) return
        if (e.key === 'Escape') close(); else if (e.key === 'ArrowLeft') show(idx - 1); else if (e.key === 'ArrowRight') show(idx + 1)
      })
    })()
  </script>

  <style>
    .acc-video { position: relative; aspect-ratio: 16 / 9; background: #1a1a1c; border-radius: 14px; overflow: hidden; box-shadow: 0 14px 36px rgba(42,22,8,0.16); }
    .acc-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .acc-video-caption { margin: 12px 0 0; text-align: center; color: var(--muted); font-size: 0.95rem; }

    /* Accessories sub-menu - jump links under the video. Labels come from each
       accessory's "Sub-menu label" (or name) in Sanity, so Maud controls them. */
    .acc-submenu { padding: 18px 0 4px; }
    .acc-submenu > .container { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; justify-content: center; }
    .acc-submenu-label { font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
    .acc-submenu-link { font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 0.9rem; color: var(--ink); background: var(--sand-deep); border: 1px solid var(--tan-border); border-radius: 999px; padding: 8px 16px; text-decoration: none; transition: background 0.15s, color 0.15s, border-color 0.15s; }
    .acc-submenu-link:hover { background: var(--rust); color: #fff; border-color: var(--rust); }

    .acc-sample-note { background: #FFF5EC; border: 1px solid #F0CDA8; border-left: 4px solid var(--gold, #D4943A); border-radius: 8px; padding: 12px 16px; color: #5A3818; font-size: 0.9rem; line-height: 1.5; }

    .acc-section + .acc-section { border-top: 1px solid var(--tan-border); }
    .acc-head { text-align: center; max-width: 760px; margin: 0 auto 18px; }
    .acc-eyebrow { font-family: 'Inter Tight', sans-serif; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold, #D4943A); margin-bottom: 6px; }
    .acc-title { font-family: 'Inter Tight', sans-serif; font-size: 1.9rem; font-weight: 800; color: var(--ink); line-height: 1.1; }
    .acc-badges { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin: 12px 0 0; }
    .acc-pill { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em; padding: 5px 13px; border-radius: 999px; background: var(--sand-deep); color: var(--ink); border: 1px solid var(--tan-border); }
    .acc-intro { color: var(--muted); line-height: 1.65; margin-top: 12px; }

    .acc-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin: 0 auto 22px; }
    .acc-gallery .gallery-img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; border: 1px solid var(--tan-border); cursor: zoom-in; background: var(--sand-deep); }
    .acc-photo-ph { aspect-ratio: 4 / 3; border-radius: 10px; border: 1px dashed var(--tan-border); background: repeating-linear-gradient(45deg, var(--sand-deep) 0 10px, #ece3d2 10px 20px); display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 0.8rem; }

    .acc-prods { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
    @media (max-width: 760px) { .acc-prods { grid-template-columns: 1fr; } }
    .pcard { background: #fff; border: 1px solid var(--tan-border); border-radius: 14px; overflow: hidden; box-shadow: 0 4px 18px rgba(42,22,8,0.07); display: flex; flex-direction: column; }
    .pcard-media { background: linear-gradient(150deg, #eee4d2, #f7f0e4); padding: 16px; }
    .pcard-hero { width: 100%; max-height: 280px; object-fit: contain; display: block; cursor: zoom-in; }
    .pcard-thumbs { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .pcard-thumb { width: 60px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid var(--tan-border); cursor: zoom-in; background: #fff; }
    .pcard-body { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
    .pcard-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .pcard-brand { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold, #D4943A); }
    .pcard-state { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; color: #fff; }
    .tag-green { background: var(--green, #2BA85F); }
    .tag-rust { background: var(--rust); }
    .tag-gold { background: var(--gold, #D4943A); color: var(--ink); }
    .tag-olive { background: #6B7A3A; }
    .tag-muted { background: var(--muted); }
    .pcard-name { font-family: 'Inter Tight', sans-serif; font-size: 1.35rem; font-weight: 700; color: var(--ink); margin: 6px 0 3px; line-height: 1.15; }
    .pcard-type { font-size: 0.85rem; color: var(--muted); font-weight: 600; margin-bottom: 10px; }
