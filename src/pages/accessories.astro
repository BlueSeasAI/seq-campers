---
import Site from '../layouts/Site.astro'
import ReserveCta from '../components/ReserveCta.astro'
import { getAccessoriesPage, youtubeId } from '../lib/sanity.js'

let page = null
try {
  page = await getAccessoriesPage()
} catch (err) {
  console.warn('Sanity unreachable for /accessories:', err.message)
}

const intro = (page?.intro && page.intro.trim())
  || 'Genuine off-road accessories, fitted by our workshop and shipped Australia-wide. Tell us what you are after and we will sort it out.'
const videoUrl = (page?.heroVideo?.youtubeUrl && page.heroVideo.youtubeUrl.trim())
  || 'https://www.youtube.com/watch?v=gq72bwiG-eI'
const videoId = youtubeId(videoUrl)
const videoCaption = page?.heroVideo?.caption || ''

// Real accessories from Sanity. If there are none yet, fall back to a set of
// SAMPLE items so Maud + Shane can see the page layout. These are a WIREFRAME
// only - they vanish automatically the moment a real accessory is added in
// Sanity, so there's no lingering placeholder to forget to remove.
const realItems = Array.isArray(page?.items) ? page.items.filter((i) => i?.title) : []
const usingSamples = realItems.length === 0
const SAMPLE_ITEMS = [
  { title: 'Recovery Tracks (pair)', description: 'Heavy-duty recovery boards for sand, mud and ruts. Mount to the toolbox or A-frame.' },
  { title: '270 Degree Awning', description: 'Wraparound shade off the door side - sets up in under a minute, no poles.' },
  { title: 'Dual Battery + DC-DC Kit', description: 'Charges your van batteries off the car as you drive. Lithium-ready.' },
  { title: 'Slide-Out Kitchen', description: 'Stainless slide for the rear toolbox - stove, prep space and storage in one.' },
  { title: 'Portable Solar Blanket', description: '200W folding blanket to top up off-grid. Packs flat under a seat.' },
  { title: 'Water Tank Upgrade', description: 'Extra poly tank with a stone guard - more days between fills when you are remote.' },
]
const items = usingSamples ? SAMPLE_ITEMS : realItems

const description = 'Off-road caravan accessories from SEQ Campers on the Sunshine Coast - fitted by our workshop and shipped Australia-wide. Enquire about any item.'
---

<Site title="Accessories" description={description}>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>Accessories</h1>
      <p>{intro}</p>
    </div>
  </div>

  {videoId && (
    <section class="section" style="padding-top:24px; padding-bottom:8px;">
      <div class="container" style="max-width:880px;">
        <div class="acc-video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=1&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1`}
            title="SEQ Campers accessories"
            frameborder="0"
            allow="autoplay; encrypted-media; fullscreen"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        {videoCaption && <p class="acc-video-caption">{videoCaption}</p>}
      </div>
    </section>
  )}

  {items.length > 0 ? (
    <section class="section" style="padding-top:28px; padding-bottom:32px;">
      <div class="container">
        <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:18px;">
          <div class="page-eyebrow" style="color:var(--rust);">What we stock</div>
          <h2 class="section-title">Off-road accessories.</h2>
        </div>
        {usingSamples && (
          <div class="acc-sample-note">
            <strong>Sample layout (preview only).</strong> These example accessories show how the page will look with five or six items. They disappear automatically the moment a real accessory is added in Sanity - there is no placeholder to remember to remove.
          </div>
        )}
        <div class="acc-grid">
          {items.map((a) => (
            <div class="acc-card">
              <div class="acc-media">
                {a.imageUrl ? (
                  <img src={`${a.imageUrl}?w=640&auto=format`} alt={a.imageAlt || a.title} loading="lazy" />
                ) : (
                  <div class="acc-noimg">
                    <span class="acc-play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                    <span>Photo or video</span>
                  </div>
                )}
              </div>
              <div class="acc-meta">
                <h3 class="acc-title">{a.title}</h3>
                {a.description && <p class="acc-desc">{a.description}</p>}
                <div class="acc-foot">
                  {a.priceLabel && <span class="acc-price">{a.priceLabel}</span>}
                  <a href="#accessories-enquiry" class="acc-cta" data-accessory={a.title}>Enquire →</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section" style="padding-top:28px;">
      <div class="container" style="max-width:720px; text-align:center;">
        <p style="color:var(--muted); line-height:1.65;">Our accessories range is being added shortly. In the meantime, get in touch below and we will help you out.</p>
      </div>
    </section>
  )}

  <!-- Enquiry form - no buying flow yet, this emails SEQ so they can follow up. -->
  <section class="section" id="accessories-enquiry" style="padding-top:8px; padding-bottom:48px;">
    <div class="container" style="max-width:720px;">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:14px;">
        <div class="page-eyebrow" style="color:var(--rust);">Get in touch</div>
        <h2 class="section-title">Enquire about an accessory.</h2>
        <p style="color:var(--muted); margin-top:6px; line-height:1.65;">
          Tell us what you are after and we will come back with availability and a price. You can also call us on <a href="tel:0753707933" style="color:var(--rust); font-weight:600;">(07) 5370 7933</a>.
        </p>
      </div>

      <form
        class="enquiry-form"
        name="accessories-enquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <input type="hidden" name="form-name" value="accessories-enquiry" />
        <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <label>
            Your name
            <input type="text" name="customer_name" required autocomplete="name" />
          </label>
          <label>
            Email
            <input type="email" name="customer_email" required autocomplete="email" />
          </label>
        </div>

        <div class="form-row">
          <label>
            Phone (optional)
            <input type="tel" name="customer_phone" autocomplete="tel" placeholder="04xx xxx xxx" />
          </label>
          <label>
            Which accessory?
            <input type="text" name="accessory_interest" placeholder="e.g. recovery kit, awning..." />
          </label>
        </div>

        <label>
          Anything else? (optional)
          <textarea name="message" placeholder="Quantity, your van model, delivery address..."></textarea>
        </label>

        <button type="submit" class="btn-primary">Send my enquiry</button>
      </form>
    </div>
  </section>

  <script is:inline>
    /* When a visitor clicks "Enquire" on an accessory, prefill the
       "Which accessory?" field so SEQ knows which item they mean. */
    (function () {
      document.querySelectorAll('.acc-cta[data-accessory]').forEach(function (a) {
        a.addEventListener('click', function () {
          var field = document.querySelector('input[name="accessory_interest"]')
          if (field) field.value = a.getAttribute('data-accessory') || ''
        })
      })
    })()
  </script>

  <style>
    .acc-video {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #1a1a1c;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 14px 36px rgba(42, 22, 8, 0.16);
    }
    .acc-video iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .acc-video-caption {
      margin: 12px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .acc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 18px;
    }
    @media (max-width: 640px) {
      .acc-grid { grid-template-columns: 1fr; gap: 14px; }
    }
    .acc-card {
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid var(--tan-border);
      border-radius: 12px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }
    .acc-card:hover {
      transform: translateY(-3px);
      border-color: var(--rust);
      box-shadow: 0 10px 28px rgba(42, 22, 8, 0.12);
    }
    .acc-media {
      position: relative;
      aspect-ratio: 4 / 3;
      background: var(--sand-deep);
    }
    .acc-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .acc-noimg {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 9px;
      color: var(--muted);
      font-size: 0.85rem;
      background: repeating-linear-gradient(45deg, var(--sand-deep) 0 10px, #ece3d2 10px 20px);
    }
    .acc-play {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(192, 52, 26, 0.92);
      color: #fff;
      padding-left: 3px;
      box-shadow: 0 4px 12px rgba(42, 22, 8, 0.2);
    }
    .acc-sample-note {
      max-width: 760px;
      margin: 0 auto 18px;
      background: #FFF5EC;
      border: 1px solid #F0CDA8;
      border-left: 4px solid var(--gold, #D4943A);
      border-radius: 8px;
      padding: 12px 16px;
      color: #5A3818;
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .acc-meta {
      padding: 16px 18px 18px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .acc-title {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--ink);
      line-height: 1.2;
    }
    .acc-desc {
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.55;
      margin-top: 8px;
    }
    .acc-foot {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: auto;
      padding-top: 14px;
    }
    .acc-price {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      color: var(--ink);
    }
    .acc-cta {
      color: var(--rust);
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      margin-left: auto;
    }
    .acc-cta:hover { text-decoration: underline; }
  </style>

  <ReserveCta variant="band" />
</Site>
