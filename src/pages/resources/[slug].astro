  </style>

  <script>
    // Reading progress + "which section am I in" highlight in the sidebar.
    ;(function () {
      const fill = document.getElementById('readProg')
      const main = document.querySelector('.guide-main')
      if (fill && main) {
        const tick = () => {
          const start = main.offsetTop
          const span = main.offsetHeight - window.innerHeight * 0.5
          const pct = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(span, 1)))
          fill.style.width = pct * 100 + '%'
        }
        addEventListener('scroll', tick, { passive: true })
        addEventListener('resize', tick)
        tick()
      }

      const links = {}
      const secs = Array.from(document.querySelectorAll('.guide-sec'))
      secs.forEach((el) => {
        const a = document.querySelector('.guide-toc a[href="#' + el.id + '"]')
        if (a) links[el.id] = a
      })
      if ('IntersectionObserver' in window && secs.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              const a = links[e.target.id]
              if (!a) return
              if (e.isIntersecting) {
                Object.keys(links).forEach((k) => links[k].removeAttribute('aria-current'))
                a.setAttribute('aria-current', 'true')
              }
            })
          },
          { rootMargin: '-15% 0px -70% 0px' }
        )
        secs.forEach((el) => io.observe(el))
      }
    })()
  </script>
</Site>
