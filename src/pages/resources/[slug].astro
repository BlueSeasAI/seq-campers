---
import Site from '../../layouts/Site.astro'
import { allResources, guides, PRICES, STRIPE, getResource, buyLink } from '../../data/guides.js'

export function getStaticPaths() {
  return allResources.map((r) => ({ params: { slug: r.slug }, props: { slug: r.slug } }))
}

const { slug } = Astro.props
const r = getResource(slug)
const isGuide = r.kind === 'guide'

const base = 'https://seqcampers.com.au'
const url = `${base}/resources/${r.slug}`

// The article's "buy the book" CTA points at whichever guide it came out of.
const related = r.relatedGuide ? guides.find((g) => g.slug === r.relatedGuide) : null

// Other things to read at the end of the page
const alsoRead = allResources.filter((x) => x.slug !== r.slug).slice(0, 2)

// Buy CTAs. While a Stripe link is missing these become "Email us to buy" so a
// live page never carries a dead checkout button. See buyLink() in guides.js.
const buyThis = isGuide ? buyLink(r.stripeUrl, `${r.title} - PDF, $${PRICES.pdf}`) : null
const buyBundle = buyLink(STRIPE.bundlePdf, `Both guides - PDF bundle, $${PRICES.bundle}`)
const buyRelated = related ? buyLink(related.stripeUrl, `${related.title} - PDF, $${PRICES.pdf}`) : null

const freeSectionList = r.sections
  .map((s) => s.n)
  .join(', ')
  .replace(/, ([^,]*)$/, ' and $1')

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: r.title,
      description: r.meta.description,
      inLanguage: 'en-AU',
      datePublished: r.publishedAt || '2026-07-29',
      dateModified: r.publishedAt || '2026-07-29',
      mainEntityOfPage: url,
      author: { '@type': 'Organization', name: 'SEQ Campers' },
      publisher: { '@type': 'Organization', name: 'SEQ Campers', url: base },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: base },
        { '@type': 'ListItem', position: 2, name: 'Resources', item: `${base}/resources` },
        { '@type': 'ListItem', position: 3, name: r.title, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: r.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
}
---

<Site title={r.meta.title} description={r.meta.description} ogType="article" ogImage={r.ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="read-prog" role="presentation"><div class="read-prog-fill" id="readProg"></div></div>

  <div class="page-header page-header-tight">
    <div class="container">
      <p class="page-eyebrow">
        <a href="/resources">Resources</a> &nbsp;/&nbsp; {isGuide ? r.edition : r.eyebrow}
      </p>
      <h1>{r.title}</h1>
      <p>{r.tagline}</p>
      <p class="guide-hero-meta">
        {isGuide && <span><b>{r.pages}</b> pages</span>}
        <span><b>{r.readMins}</b> min read</span>
        {isGuide && <span>${PRICES.pdf} PDF</span>}
        <span>Updated {r.updated}</span>
      </p>
    </div>
  </div>

  <section class="section" style="padding-top:40px; padding-bottom:56px;">
    <div class="container">
      <div class="guide-layout">
        <!-- ---------------- content ---------------- -->
        <div class="guide-main">
          <p class="guide-standfirst" set:html={r.standfirst} />

          {r.sections.map((s) => (
            <section class="guide-sec" id={s.id}>
              <div class="guide-sec-head">
                <div class="guide-sec-n">{s.n}</div>
                <h2 class="guide-sec-t">{s.title}</h2>
              </div>
              <div class="guide-body" set:html={s.html} />
            </section>
          ))}

          <p class="guide-disclaimer"><b>Disclaimer.</b> {r.disclaimer}</p>
        </div>

        <!-- ---------------- sidebar ---------------- -->
        <aside class="guide-side">
          <nav class="guide-toc" aria-label="Sections">
            <p class="guide-toc-label">On this page</p>
            <ol>
              {r.sections.map((s) => (
                <li><a href={`#${s.id}`}><span>{s.n}</span>{s.title}</a></li>
              ))}
            </ol>
          </nav>

          {isGuide ? (
            <div class="guide-buybox">
              <p class="guide-buybox-label">The complete guide</p>
              <p class="guide-buybox-price">${PRICES.pdf}</p>
              <p class="guide-buybox-what">All {r.pages} pages as a PDF, including {r.locked.workbook.name}. Delivered immediately.</p>
              <a class="btn-enquire" href={buyThis.href}>{buyThis.label}</a>
              <a class="guide-buybox-alt" href={`#get-the-pdf`}>Both books for ${PRICES.bundle} &rarr;</a>
              <p class="guide-buybox-fine">
                Sections {freeSectionList} are free to read on this page, in full. Nothing is held back within them.
              </p>
            </div>
          ) : related ? (
            <div class="guide-buybox">
              <p class="guide-buybox-label">Goes deeper in</p>
              <p class="guide-buybox-book">{related.title}</p>
              <p class="guide-buybox-what" set:html={r.relatedNote} />
              <a class="btn-enquire" href={`/resources/${related.slug}`}>Read it free</a>
              <a class="guide-buybox-alt" href={buyRelated.href}>{buyRelated.label}, ${PRICES.pdf} &rarr;</a>
            </div>
          ) : null}

          <div class="guide-side-visit">
            <p>Rather ask a person?</p>
            <a href="/contact">Come and see us in Marcoola &rarr;</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ---------------- buy band (guides only) ---------------- -->
  {isGuide && (
    <section class="band-dark buy-band" id="get-the-pdf">
      <div class="container">
        <p class="buy-band-eyebrow">{r.locked.heading}</p>
        <h2>The complete guide.</h2>
        <p class="buy-band-lede">{r.locked.blurb}</p>

        <div class="locked-grid">
          {r.locked.items.map(([n, t, why]) => (
            <div class="locked-item">
              <span class="locked-n">{n}</span>
              <div>
                <p class="locked-t">{t}</p>
                <p class="locked-why">{why}</p>
              </div>
            </div>
          ))}
          <div class="locked-item locked-item-workbook">
            <span class="locked-n locked-n-star">&#9733;</span>
            <div>
              <p class="locked-t">{r.locked.workbook.name}</p>
              <p class="locked-why" set:html={r.locked.workbook.detail} />
            </div>
          </div>
        </div>

        <div class="buy-grid">
          <a class="buy-card" href={buyThis.href}>
            <span class="buy-price">${PRICES.pdf}</span>
            <span class="buy-what">This guide, complete PDF</span>
            <span class="buy-detail">
              All {r.pages} pages, including {r.locked.workbook.name}.
              {buyThis.pending ? ' Email us and we will send it straight back.' : ' Delivered immediately.'}
            </span>
            <span class="buy-go">{buyThis.label} &rarr;</span>
          </a>

          <a class="buy-card buy-card-bundle" href={buyBundle.href}>
            <span class="buy-price">${PRICES.bundle}<span class="buy-was">${PRICES.bundleWas}</span></span>
            <span class="buy-what">Both books, PDF</span>
            <span class="buy-detail">
              {guides.map((g) => g.title).join(' and ')}. Choosing one, and living with it.
            </span>
            <span class="buy-go">{buyBundle.pending ? 'Email us to buy' : 'Buy both'} &rarr;</span>
          </a>

          <div class="buy-card buy-card-quiet">
            <span class="buy-price-sm">Printed</span>
            <span class="buy-what">Coming soon</span>
            <span class="buy-detail">
              A bound copy that lives in the van and works without a screen. We are counting numbers before we
              commit to a print run.
            </span>
            <a class="buy-go-quiet" href="/contact">Register your interest &rarr;</a>
          </div>
        </div>

        <p class="buy-fine">
          We do not offer refunds for change of mind. If a file will not open, pages are missing, or you were
          charged twice, tell us and we will replace it or refund you. Those rights come from the Australian
          Consumer Law and nothing here limits them. <a href="/terms">Full terms</a>.
        </p>
        <p class="buy-fine">
          Written by a dealer who services what they sell. No brand rankings, no sponsored placements, and a
          section arguing that some readers should not buy an off-road van at all.
        </p>
      </div>
    </section>
  )}

  <!-- ---------------- FAQs ---------------- -->
  <section class="section" style="padding-top:52px; padding-bottom:24px;">
    <div class="container">
      <div class="faq-section">
        <h2 class="faq-title">Common questions</h2>
        <div class="faq-list">
          {r.faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{f.q}</summary>
              <div class="faq-answer">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------- also read ---------------- -->
  <section class="section" style="padding-top:8px; padding-bottom:64px;">
    <div class="container">
      <div class="section-header"><h2 class="section-title">Also worth reading</h2></div>
      <div class="also-grid">
        {alsoRead.map((x) => (
          <a class="also-card" href={`/resources/${x.slug}`}>
            <span class="also-kind">{x.kind === 'guide' ? 'Guide' : 'Article'}</span>
            <span class="also-title">{x.title}</span>
            <span class="also-lede">{x.cardLede}</span>
            <span class="also-go">Read it &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style is:global>
    /* ---------- reading progress ---------- */
    .read-prog {
      position: fixed;
      inset: 0 0 auto 0;
      height: 3px;
      background: rgba(42, 22, 8, 0.1);
      z-index: 120;
    }
    .read-prog-fill {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--rust), var(--gold));
      transition: width 0.05s linear;
    }

    .page-eyebrow a { color: var(--gold); text-decoration: none; }
    .page-eyebrow a:hover { text-decoration: underline; }

    .guide-hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 14px !important;
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C9B79C !important;
    }
    .guide-hero-meta b { color: var(--gold); font-weight: 800; }

    /* ---------- layout ---------- */
    .guide-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 48px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .guide-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    }

    /* TEXT WIDTH DISCIPLINE: the grid column is the boundary, not the text.
       Never add max-width (px, rem OR ch) to anything text-bearing. */
    .guide-main,
    .guide-standfirst,
    .guide-body p,
    .guide-body li,
    .buy-band-lede,
    .buy-fine,
    .locked-why,
    .guide-disclaimer { max-width: none; }

    .guide-main { min-width: 0; }

    .guide-standfirst {
      font-size: 1.16rem;
      line-height: 1.68;
      color: var(--ink);
      margin-bottom: 8px;
    }

    /* ---------- section heads ---------- */
    .guide-sec { scroll-margin-top: 96px; padding-top: 40px; }

    .guide-sec-head {
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr);
      align-items: stretch;
      background: var(--ink);
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 22px;
    }
    .guide-sec-n {
      background: var(--rust);
      color: #fff;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      display: grid;
      place-items: center;
    }
    .guide-sec-t {
      color: var(--sand);
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: 0.02em;
      margin: 0;
      padding: 14px 18px;
      align-self: center;
    }

    /* ---------- body copy (Maud's sections, SEQ styling) ---------- */
    .guide-body { color: var(--ink); font-size: 1.01rem; line-height: 1.78; }
    .guide-body p { margin-bottom: 16px; }
    .guide-body p.standfirst { font-size: 1.1rem; line-height: 1.7; color: var(--ink); }
    .guide-body h3 {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.24rem;
      font-weight: 700;
      color: var(--ink);
      margin: 30px 0 10px;
      line-height: 1.3;
    }
    .guide-body h4 {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--rust);
      margin: 26px 0 8px;
    }
    .guide-body ul { list-style: none; padding: 0; margin: 0 0 18px; }
    .guide-body ul li { position: relative; padding-left: 22px; margin-bottom: 9px; }
    .guide-body ul li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.68em;
      width: 7px;
      height: 7px;
      border-radius: 2px;
      background: var(--gold);
    }
    .guide-body strong { font-weight: 700; color: var(--ink); }

    /* checkbox lists */
    .guide-body ul.check { margin: 16px 0 20px; column-gap: 34px; }
    .guide-body ul.check li { padding-left: 26px; margin-bottom: 8px; break-inside: avoid; font-size: 0.97rem; }
    .guide-body ul.check li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.36em;
      width: 14px;
      height: 14px;
      border-radius: 3px;
      border: 1.5px solid var(--gold);
      background: #fff;
    }
    @media (min-width: 720px) {
      .guide-body ul.check--2 { column-count: 2; }
    }

    /* call-out notes */
    .guide-body .note {
      background: #fff;
      border: 1px solid var(--tan-border);
      border-left: 4px solid var(--gold);
      border-radius: 0 8px 8px 0;
      padding: 18px 22px;
      margin: 24px 0;
      box-shadow: var(--shadow-sm);
    }
    .guide-body .note--warn { border-left-color: var(--rust); background: #FFF7F2; }
    .guide-body .note p { margin-bottom: 10px; }
    .guide-body .note p:last-child { margin-bottom: 0; }
    .guide-body .note b {
      display: block;
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--rust);
      margin-bottom: 8px;
    }

    /* tables */
    .guide-body .tw {
      overflow-x: auto;
      margin: 22px 0;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--tan-border);
      border-radius: 8px;
      background: #fff;
    }
    .guide-body table { border-collapse: collapse; width: 100%; min-width: 26rem; font-size: 0.93rem; }
    .guide-body thead th {
      background: var(--ink);
      color: var(--sand);
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.75rem;
      text-align: left;
      padding: 11px 14px;
    }
    .guide-body td {
      padding: 11px 14px;
      border-bottom: 1px solid var(--tan-border);
      vertical-align: top;
      line-height: 1.55;
      color: var(--ink);
    }
    .guide-body tbody tr:last-child td { border-bottom: none; }
    .guide-body tbody tr:nth-child(even) { background: var(--sand); }
    .guide-body td:first-child { font-weight: 600; }

    .guide-disclaimer {
      margin-top: 40px;
      padding-top: 18px;
      border-top: 1px solid var(--tan-border);
      font-size: 0.86rem;
      line-height: 1.62;
      color: var(--muted);
    }
    .guide-disclaimer b { color: var(--ink); }

    /* ---------- sidebar ---------- */
    .guide-side { position: sticky; top: 96px; display: grid; gap: 18px; }
    @media (max-width: 980px) { .guide-side { position: static; } }

    .guide-toc {
      background: #fff;
      border: 1px solid var(--tan-border);
      border-radius: 12px;
      padding: 20px 22px;
      box-shadow: var(--shadow-sm);
    }
    .guide-toc-label {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 12px;
    }
    .guide-toc ol { list-style: none; margin: 0; padding: 0; }
    .guide-toc li { border-top: 1px solid var(--tan-border); }
    .guide-toc li:first-child { border-top: none; }
    .guide-toc a {
      display: grid;
      grid-template-columns: 22px minmax(0, 1fr);
      gap: 6px;
      padding: 10px 0;
      text-decoration: none;
      color: var(--ink);
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.93rem;
      font-weight: 500;
      line-height: 1.35;
    }
    .guide-toc a span { color: var(--muted); font-weight: 700; font-size: 0.75rem; }
    .guide-toc a:hover { color: var(--rust); }
    .guide-toc a[aria-current='true'] { color: var(--rust); font-weight: 700; }
    .guide-toc a[aria-current='true'] span { color: var(--rust); }

    .guide-buybox {
      background: var(--ink);
      color: var(--sand);
      border-radius: 12px;
      padding: 24px 24px 22px;
      box-shadow: var(--shadow-md);
    }
    .guide-buybox-label {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 6px;
    }
    .guide-buybox-price {
      font-family: 'Inter Tight', sans-serif;
      font-size: 2.6rem;
      font-weight: 800;
      line-height: 1;
      color: var(--sand);
      margin-bottom: 10px;
    }
    .guide-buybox-book {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.24rem;
      font-weight: 800;
      line-height: 1.18;
      color: var(--sand);
      margin-bottom: 10px;
    }
    .guide-buybox-what { font-size: 0.75rem; line-height: 1.6; color: #E4D6C0; margin-bottom: 16px; }
    .guide-buybox .btn-enquire { margin-top: 0; }
    .guide-buybox-alt {
      display: block;
      margin-top: 12px;
      text-align: center;
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.86rem;
      font-weight: 600;
      color: var(--gold);
      text-decoration: none;
    }
    .guide-buybox-alt:hover { text-decoration: underline; }
    .guide-buybox-fine {
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid rgba(244, 237, 224, 0.16);
      font-size: 0.79rem;
      line-height: 1.55;
      color: #A08D77;
    }

    .guide-side-visit {
      background: #fff;
      border: 1px solid var(--tan-border);
      border-radius: 12px;
      padding: 18px 22px;
    }
    .guide-side-visit p {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .guide-side-visit a { color: var(--rust); font-weight: 600; font-size: 0.92rem; text-decoration: none; }
    .guide-side-visit a:hover { text-decoration: underline; }

    /* ---------- buy band ---------- */
    .buy-band-eyebrow {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 8px;
    }
    .buy-band h2 { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 10px; }
    .buy-band-lede { color: #E4D6C0; font-size: 1rem; line-height: 1.65; margin-bottom: 28px; }

    .locked-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 18px 32px;
      margin-bottom: 34px;
      padding-bottom: 30px;
      border-bottom: 1px solid rgba(244, 237, 224, 0.16);
    }
    .locked-item { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 14px; align-items: start; }
    .locked-n {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(244, 237, 224, 0.1);
      border: 1px solid rgba(244, 237, 224, 0.28);
      color: var(--gold);
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.84rem;
      font-weight: 800;
      display: grid;
      place-items: center;
    }
    .locked-n-star { background: var(--gold); border-color: var(--gold); color: var(--ink); }
    .locked-t {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: var(--sand);
      margin-bottom: 3px;
      line-height: 1.3;
    }
    .locked-why { font-size: 0.89rem; line-height: 1.58; color: #C9B79C; }

    .buy-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 16px;
    }
    .buy-card {
      display: grid;
      align-content: start;
      gap: 6px;
      padding: 22px 24px;
      background: rgba(0, 0, 0, 0.22);
      border: 1px solid rgba(244, 237, 224, 0.2);
      border-radius: 12px;
      text-decoration: none;
      transition: border-color 0.15s, background 0.15s, transform 0.15s;
    }
    a.buy-card:hover { border-color: var(--gold); background: rgba(0, 0, 0, 0.34); transform: translateY(-2px); }
    .buy-card-bundle { border-color: var(--gold); }
    .buy-card-quiet { background: transparent; }

    .buy-price {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 2.3rem;
      line-height: 1;
      color: var(--gold);
    }
    .buy-price-sm {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 1.5rem;
      line-height: 1.25;
      color: var(--gold);
    }
    .buy-was {
      font-size: 0.95rem;
      color: #8B6A40;
      text-decoration: line-through;
      margin-left: 8px;
      font-weight: 700;
    }
    .buy-what {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--sand);
