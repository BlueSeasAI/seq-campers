---
import Site from '../../layouts/Site.astro'
import BrollCard from '../../components/BrollCard.astro'
import { getNewCaravans, getSiteSettings, youtubeId } from '../../lib/sanity.js'

let caravans = []
try {
  caravans = await getNewCaravans()
} catch (err) {
  console.warn('Sanity unreachable for /new:', err.message)
}

let settings = null
try {
  settings = await getSiteSettings()
} catch (err) {
  console.warn('Sanity unreachable for /new settings:', err.message)
}

const reserveCta = (settings?.reserveCta?.enabled && settings.reserveCta.stripeUrl) ? settings.reserveCta : null

// Sort caravans by price descending (most expensive first) per Bart 8 Jun.
caravans = [...caravans].sort((a, b) => (b.price || 0) - (a.price || 0))

const brands = [...new Set(caravans.map((c) => c.brand).filter(Boolean))].sort()

// ---------------------------------------------------------------------------
// 8 video tiles - the locked layout per Bart's 16 Jun meeting + 8 Jun
// clarification. Order is FIXED in code (most expensive top-left, cheapest
// bottom-right, with Accessories as the 8th non-priced tile). Each tile
// has sensible defaults; Maud can override any field via Sanity Studio at
// Site Settings -> "New page video tiles (8 slots)".
// ---------------------------------------------------------------------------
const NEW_TILE_DEFAULTS = [
  { youtubeUrl: 'https://www.youtube.com/watch?v=tozC7prVbOg', brandLabel: 'Kimberley Campers', modelLabel: 'Kruiswagen', priceLabel: 'From $203,350', ctaHref: '/quote/kruiswagen' },
  { youtubeUrl: 'https://www.youtube.com/watch?v=xYf81xUZtNE', brandLabel: 'Kimberley Campers', modelLabel: 'Kruiser',    priceLabel: 'From $139,300', ctaHref: '/quote/kruiser-t' },
  { youtubeUrl: 'https://www.youtube.com/watch?v=WwgapQt3xO4', brandLabel: 'Kimberley Campers', modelLabel: 'Karavan',    priceLabel: 'From $129,385', ctaHref: '/quote/karavan' },
  { youtubeUrl: 'https://www.youtube.com/watch?v=tozC7prVbOg', brandLabel: 'Kimberley Campers', modelLabel: 'Kube',       priceLabel: 'From $80,365',  ctaHref: '/quote/kube' },
  { youtubeUrl: 'https://www.youtube.com/watch?v=xYf81xUZtNE', brandLabel: 'Stockman Products', modelLabel: 'Trekka',     priceLabel: 'From $65,500',  ctaHref: '/quote/trekka' },
  { youtubeUrl: 'https://www.youtube.com/watch?v=WwgapQt3xO4', brandLabel: 'Stockman Products', modelLabel: 'Rover',      priceLabel: 'From $63,490',  ctaHref: '/quote/rover' },
  { youtubeUrl: 'https://www.youtube.com/watch?v=tozC7prVbOg', brandLabel: 'Stockman Products', modelLabel: 'Pod',        priceLabel: 'Enquire',       ctaHref: '/contact' },
  { youtubeUrl: 'https://www.youtube.com/watch?v=xYf81xUZtNE', brandLabel: '',                  modelLabel: 'Accessories', priceLabel: 'Enquire',      ctaHref: '/contact' },
]

function resolveTile(idx) {
  const slot = settings?.[`newPageTile${idx + 1}`] || {}
  const fallback = NEW_TILE_DEFAULTS[idx]
  const youtubeUrl = (slot.youtubeUrl && slot.youtubeUrl.trim()) || fallback.youtubeUrl
  const videoId = youtubeId(youtubeUrl) || youtubeId(fallback.youtubeUrl)
  return {
    videoId,
    brandLabel: (slot.brandLabel?.trim?.()) || fallback.brandLabel,
    modelLabel: (slot.modelLabel?.trim?.()) || fallback.modelLabel,
    priceLabel: (slot.priceLabel?.trim?.()) || fallback.priceLabel,
    ctaHref:    (slot.ctaHref?.trim?.())    || fallback.ctaHref,
  }
}

const tiles = NEW_TILE_DEFAULTS.map((_, i) => resolveTile(i))

const description = `Browse new Kimberley Campers and Stockman Products off-road caravans at SEQ Campers on the Sunshine Coast. Build your spec, lock in pricing, and order direct from the factory.`
---

<Site title="New off-road caravans" description={description}>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>Off-road caravans, built to your spec.</h1>
      <p>Pick a brand, build your spec, and we'll match it to a factory order or current build slot. Sunshine Coast based, Australia-wide.</p>
    </div>
  </div>

  {caravans.length > 0 && (
    <section class="section" style="padding-top:28px; padding-bottom:28px;">
      <div class="container">
        <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:18px;">
          <div class="page-eyebrow" style="color:var(--rust);">Available now</div>
          <h2 class="section-title">New caravans on the floor.</h2>
          <p style="color:var(--muted); margin-top:6px;">{caravans.length} new caravan{caravans.length !== 1 ? 's' : ''} ready or about to land - most expensive first. Tap any tile to see the full spec.</p>
        </div>

        {brands.length > 1 && (
          <form class="filter-bar" id="new-filters" aria-label="Filter new stock">
            <div class="filter-field">
              <label class="filter-label" for="filter-brand-new">Brand</label>
              <select id="filter-brand-new" name="brand">
                <option value="">All brands</option>
                {brands.map((b) => <option value={b}>{b}</option>)}
              </select>
            </div>
            <div class="filter-field">
              <label class="filter-label">&nbsp;</label>
              <button type="reset" class="filter-reset">Reset</button>
            </div>
          </form>
        )}

        <div class="broll-grid" id="new-grid">
          {caravans.map((c) => <BrollCard caravan={c} />)}
        </div>
      </div>
    </section>
  )}

  <!-- 8 video tiles - the locked /new layout per 16 Jun + 8 Jun. -->
  <section class="section" style={`padding-top:${caravans.length > 0 ? '24px' : '32px'}; padding-bottom:32px; ${caravans.length > 0 ? 'background:var(--sand-deep);' : ''}`}>
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:18px;">
        <div class="page-eyebrow" style="color:var(--rust);">The full range</div>
        <h2 class="section-title">{caravans.length > 0 ? 'Or pick a model and build from scratch.' : 'Pick a model and build your spec.'}</h2>
      </div>

      <div class="new-tile-grid">
        {tiles.map((t) => (
          <a href={t.ctaHref} class="new-tile">
            <div class="new-tile-media">
              {t.videoId ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${t.videoId}?autoplay=1&mute=1&loop=1&playlist=${t.videoId}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0`}
                  title={`${t.brandLabel} ${t.modelLabel}`}
                  frameborder="0"
                  allow="autoplay; encrypted-media"
                  allowfullscreen="false"
                  tabindex="-1"
                  inert
                  loading="lazy"
                ></iframe>
              ) : (
                <div class="new-tile-noimg">Video coming</div>
              )}
              <div class="new-tile-block" aria-hidden="true"></div>
            </div>
            <div class="new-tile-meta">
              {t.brandLabel && <div class="new-tile-brand">{t.brandLabel}</div>}
              <div class="new-tile-model">{t.modelLabel}</div>
              {t.priceLabel && <div class="new-tile-price">{t.priceLabel}</div>}
            </div>
          </a>
        ))}
      </div>

      <p class="new-tile-fineprint">
        Indicative starting prices for the entry-level variant. Kimberley Campers builds ex-factory Ballina NSW. Stockman Products builds ex-factory Melbourne. Includes GST and $3,500 dealer delivery (subject to fuel surcharge). Excludes stamp duty and registration.
      </p>

      {reserveCta && (
        <div class="reserve-cta-block">
          <div class="reserve-cta-text">
            <div class="page-eyebrow" style="color:#fff; opacity:0.85; margin-bottom:6px;">Lock your build slot</div>
            <h3>Found the one? Hold it now.</h3>
            <p>A small refundable deposit secures your factory build slot while we finalise your spec - so the slot doesn't get taken while you decide on options.</p>
          </div>
          <div class="reserve-cta-action">
            <a href={reserveCta.stripeUrl} class="reserve-cta-btn" target="_blank" rel="noopener">
              {reserveCta.buttonText || 'Reserve for $1,000'}
            </a>
            {reserveCta.helperText && (
              <div class="reserve-cta-helper">{reserveCta.helperText}</div>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Brochure-download enquiry. Per Shane: based on the Kimberley site
       pattern. Structured questions only - no vague "what would you like
       to know" free-text. NEVER ask about trade-in or finance. -->
  <section class="section" style="padding-top:32px; padding-bottom:48px;">
    <div class="container" style="max-width:720px;">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:14px;">
        <div class="page-eyebrow" style="color:var(--rust);">Want the full picture?</div>
        <h2 class="section-title">Request a brochure and price guide.</h2>
        <p style="color:var(--muted); margin-top:6px; line-height:1.65;">
          We'll send you the full spec sheets and current pricing.
        </p>
      </div>

      <form
        class="enquiry-form"
        name="brochure-download"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <input type="hidden" name="form-name" value="brochure-download" />
        <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <label>
            Your name
            <input type="text" name="customer_name" required autocomplete="name" />
          </label>
          <label>
            Email
            <input type="email" name="customer_email" required autocomplete="email" />
          </label>
        </div>

        <div class="form-row">
          <label>
            Phone (optional)
            <input type="tel" name="customer_phone" autocomplete="tel" placeholder="04xx xxx xxx" />
          </label>
          <label>
            State you live in
            <select name="customer_state" required>
              <option value="">-- Pick one --</option>
              <option value="QLD">Queensland</option>
              <option value="NSW">New South Wales</option>
              <option value="VIC">Victoria</option>
              <option value="WA">Western Australia</option>
              <option value="SA">South Australia</option>
              <option value="TAS">Tasmania</option>
              <option value="ACT">ACT</option>
              <option value="NT">Northern Territory</option>
            </select>
          </label>
        </div>

        <label>
          Which brand or model interests you?
          <select name="brand_interest" required>
            <option value="">-- Pick one --</option>
            <option value="kimberley-karavan">Kimberley Campers - Karavan</option>
            <option value="kimberley-kube">Kimberley Campers - Kube</option>
            <option value="kimberley-kruiswagen">Kimberley Campers - Kruiswagen</option>
            <option value="kimberley-kruiser-t">Kimberley Campers - Kruiser T Class</option>
            <option value="kimberley-kruiser-s">Kimberley Campers - Kruiser S Class</option>
            <option value="stockman-trekka">Stockman Products - Trekka</option>
            <option value="stockman-rover">Stockman Products - Rover</option>
            <option value="stockman-pod">Stockman Products - Pod</option>
            <option value="accessories">Accessories</option>
            <option value="multiple">Multiple - send everything</option>
            <option value="not-sure">Not sure yet - help me work it out</option>
          </select>
        </label>

        <label>
          What vehicle would you tow with?
          <input type="text" name="tow_vehicle" placeholder="e.g. 200-Series LandCruiser, Ranger, Patrol, or 'not sure yet'" />
        </label>

        <label>
          Are you upgrading or downsizing?
          <select name="motivation" required>
            <option value="">-- Pick one --</option>
            <option value="first-caravan">First caravan ever</option>
            <option value="upgrading">Upgrading from my current van</option>
            <option value="downsizing">Downsizing from my current van</option>
            <option value="replacing">Replacing a similar-size van</option>
            <option value="not-sure">Not sure yet</option>
          </select>
        </label>

        <label>
          When are you looking to buy?
          <select name="timeline">
            <option value="">-- Pick one --</option>
            <option value="asap">ASAP - happy to take available stock</option>
            <option value="3-months">Within 3 months</option>
            <option value="6-12-months">6 to 12 months</option>
            <option value="researching">Just researching for now</option>
          </select>
        </label>

        <label>
          Anything else? (optional)
          <textarea name="message" placeholder="Specific feature, layout preference, off-grid needs..."></textarea>
        </label>

        <p class="form-policy-note" style="font-size:0.82rem; color:var(--muted, #8B6A40); margin: 6px 0 14px;">
          Heads-up: we don't do trade-ins or finance - we just want this to be the right van for you.
        </p>

        <button type="submit" class="btn-primary">Send my details</button>
      </form>
    </div>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById('new-filters')
      if (!form) return
      const cards = Array.from(document.querySelectorAll('#new-grid .broll-card'))
      function applyFilters() {
        const brand = (form.brand?.value || '').trim()
        cards.forEach(function (c) {
          const cBrand = c.dataset.brand || ''
          c.style.display = !brand || cBrand === brand ? '' : 'none'
        })
      }
      form.addEventListener('input', applyFilters)
      form.addEventListener('reset', () => setTimeout(applyFilters, 0))
    })()
  </script>

  <style>
    .broll-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
    }
    @media (max-width: 640px) {
      .broll-grid { grid-template-columns: 1fr; gap: 14px; }
    }

    /* 8 video tiles - 4 rows of 2 on desktop, 1 column on mobile.
       Same BrollCard pattern as /stock - 16:9 autoplay loop + brand + model
       + price stacked below. Per Bart's 16 Jun spec. */
    .new-tile-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    @media (max-width: 720px) {
      .new-tile-grid { grid-template-columns: 1fr; gap: 14px; }
    }
    .new-tile {
      display: block;
      background: #fff;
      border: 1px solid var(--tan-border, #DCCBA8);
      border-radius: 10px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }
    .new-tile:hover {
      transform: translateY(-3px);
      border-color: var(--rust, #C0341A);
      box-shadow: 0 10px 28px rgba(42, 22, 8, 0.14);
    }
    .new-tile-media {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #1a1a1c;
      overflow: hidden;
    }
    .new-tile-media iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.78%;
      height: 100%;
      min-width: 100%;
      min-height: 56.25vw;
      transform: translate(-50%, -50%);
      border: 0;
    }
    .new-tile-block {
      position: absolute;
      inset: 0;
      z-index: 5;
      background: transparent;
      pointer-events: auto;
    }
    .new-tile-noimg {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.9rem;
    }
    .new-tile-meta {
      padding: 16px 18px 18px;
    }
    .new-tile-brand {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--rust, #C0341A);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .new-tile-model {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--ink, #2A1608);
      line-height: 1.15;
    }
    .new-tile-price {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      color: var(--ink, #2A1608);
      margin-top: 8px;
      font-size: 1rem;
    }
    .new-tile-fineprint {
      margin: 18px auto 0;
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.55;
      text-align: center;
      max-width: 820px;
    }

    /* Reserve $1,000 CTA - dark slab with prominent Stripe link. Sits
       under the tile grid, only renders when Maud enables it + sets a
       Stripe URL in Site Settings. */
    .reserve-cta-block {
      margin-top: 28px;
      padding: 28px 32px;
      border-radius: 14px;
      background: linear-gradient(135deg, #2A1608 0%, #0f0703 100%);
      color: #fff;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 24px;
      align-items: center;
      box-shadow: 0 14px 36px rgba(42,22,8,0.18);
    }
    @media (max-width: 720px) {
      .reserve-cta-block {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 24px 22px;
      }
    }
    .reserve-cta-text h3 {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.5rem;
      font-weight: 800;
      color: #fff;
      margin: 0 0 8px;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
    .reserve-cta-text p {
      color: rgba(255,255,255,0.85);
      margin: 0;
      line-height: 1.55;
      font-size: 0.98rem;
    }
    .reserve-cta-action {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }
    @media (max-width: 720px) {
      .reserve-cta-action { align-items: center; }
    }
    .reserve-cta-btn {
      display: inline-block;
      padding: 14px 28px;
      background: linear-gradient(135deg, #2BA85F 0%, #1F8049 100%);
      color: #fff;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      border-radius: 999px;
      text-decoration: none;
      box-shadow: 0 8px 22px rgba(43, 168, 95, 0.30);
      transition: transform 0.15s, box-shadow 0.15s;
      white-space: nowrap;
    }
    .reserve-cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(43, 168, 95, 0.36);
    }
    .reserve-cta-helper {
      font-size: 0.84rem;
      color: rgba(255,255,255,0.72);
      max-width: 260px;
      text-align: right;
    }
    @media (max-width: 720px) {
      .reserve-cta-helper { text-align: center; }
    }

    /* Tighten the brown page-header banner. Used on every page except home.
       Per Bart 8 Jun - smaller padding so the brown band does not dominate
       the viewport before the visitor sees the content. */
    :global(.page-header.page-header-tight) {
      padding-top: 32px;
      padding-bottom: 32px;
    }
  </style>
</Site>
