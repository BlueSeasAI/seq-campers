---
import Site from '../../layouts/Site.astro'
import CaravanCard from '../../components/CaravanCard.astro'
import TrustStrip from '../../components/TrustStrip.astro'
import { getNewCaravans, getDistinctBrands } from '../../lib/sanity.js'
import { quoteBrands } from '../../data/quote-brands.js'

let caravans = []
try {
  caravans = await getNewCaravans()
} catch (err) {
  console.warn('Sanity unreachable for /new:', err.message)
}

const brands = [...new Set(caravans.map((c) => c.brand).filter(Boolean))].sort()

const description = `Browse new Kimberley Kampers and Stockman caravans at SEQ Campers in Queensland. Build your spec, lock in show pricing, and order direct from the factory.`
---

<Site title="New Caravans" description={description}>
  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">New</div>
      <h1>New caravans, built to your spec.</h1>
      <p>Pick a brand, build your spec, and we'll match it to a factory order or current build slot.</p>
    </div>
  </div>

  <TrustStrip />

  <!-- Configurator entry tiles - the 7 brands -->
  <section class="section" style="padding-top:32px; padding-bottom:32px;">
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:18px;">
        <div class="page-eyebrow" style="color:var(--rust);">Build your spec</div>
        <h2 class="section-title">Configure a new caravan in your time.</h2>
      </div>
      <div class="new-config-grid">
        {quoteBrands.map((b) => (
          <a href={`/quote/${b.slug}`} class="new-config-card">
            <div class="new-config-brand">{b.brandFamily}</div>
            <div class="new-config-name">{b.name.replace(b.brandFamily + ' ', '')}</div>
            <div class="new-config-headline">{b.headline}</div>
            <div class="new-config-price">{b.indicativePrice}</div>
            <span class="new-config-cta">Build your spec →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {caravans.length > 0 && (
    <section class="section" style="background:var(--sand-deep); padding-top:32px; padding-bottom:32px;">
      <div class="container">
        <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:18px;">
          <div class="page-eyebrow" style="color:var(--rust);">In stock</div>
          <h2 class="section-title">New caravans available now.</h2>
          <p style="color:var(--muted); margin-top:6px;">{caravans.length} new caravan{caravans.length !== 1 ? 's' : ''} ready or about to land.</p>
        </div>

        {brands.length > 1 && (
          <form class="filter-bar" id="new-filters" aria-label="Filter new stock">
            <div class="filter-field">
              <label class="filter-label" for="filter-brand-new">Brand</label>
              <select id="filter-brand-new" name="brand">
                <option value="">All brands</option>
                {brands.map((b) => <option value={b}>{b}</option>)}
              </select>
            </div>
            <div class="filter-field">
              <label class="filter-label">&nbsp;</label>
              <button type="reset" class="filter-reset">Reset</button>
            </div>
          </form>
        )}

        <div class="stock-grid" id="new-grid">
          {caravans.map((c) => <CaravanCard caravan={c} showSpecs />)}
        </div>
      </div>
    </section>
  )}

  <!-- Brochure-download enquiry. Per Shane: based on the Kimberley site
       pattern. Structured questions only - no vague "what would you like
       to know" free-text. NEVER ask about trade-in or finance. -->
  <section class="section" style="padding-top:32px; padding-bottom:48px;">
    <div class="container" style="max-width:720px;">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:6px; margin-bottom:14px;">
        <div class="page-eyebrow" style="color:var(--rust);">Want the full picture?</div>
        <h2 class="section-title">Request a brochure and price guide.</h2>
        <p style="color:var(--muted); margin-top:6px; line-height:1.65;">
          We'll send you the full spec sheets and current pricing for the brands you're interested in. No call from us unless you ask for one.
        </p>
      </div>

      <form
        class="enquiry-form"
        name="brochure-download"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <input type="hidden" name="form-name" value="brochure-download" />
        <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <label>
            Your name
            <input type="text" name="customer_name" required autocomplete="name" />
          </label>
          <label>
            Email
            <input type="email" name="customer_email" required autocomplete="email" />
          </label>
        </div>

        <div class="form-row">
          <label>
            Phone (optional)
            <input type="tel" name="customer_phone" autocomplete="tel" placeholder="04xx xxx xxx" />
          </label>
          <label>
            State you live in
            <select name="customer_state" required>
              <option value="">-- Pick one --</option>
              <option value="QLD">Queensland</option>
              <option value="NSW">New South Wales</option>
              <option value="VIC">Victoria</option>
              <option value="WA">Western Australia</option>
              <option value="SA">South Australia</option>
              <option value="TAS">Tasmania</option>
              <option value="ACT">ACT</option>
              <option value="NT">Northern Territory</option>
            </select>
          </label>
        </div>

        <label>
          Which brand or model interests you?
          <select name="brand_interest" required>
            <option value="">-- Pick one --</option>
            <option value="kimberley-karavan">Kimberley Karavan</option>
            <option value="kimberley-kube">Kimberley Kube</option>
            <option value="kimberley-kruiswagen">Kimberley Kruiswagen</option>
            <option value="kimberley-kruiser-t">Kimberley Kruiser T Class</option>
            <option value="kimberley-kruiser-s">Kimberley Kruiser S Class</option>
            <option value="stockman-trekka">Stockman Trekka</option>
            <option value="stockman-rover">Stockman Rover</option>
            <option value="stockman-pod">Stockman Pod Trailer</option>
            <option value="multiple">Multiple - send everything</option>
            <option value="not-sure">Not sure yet - help me work it out</option>
          </select>
        </label>

        <label>
          What vehicle would you tow with?
          <input type="text" name="tow_vehicle" placeholder="e.g. 200-Series LandCruiser, Ranger, Patrol, or 'not sure yet'" />
        </label>

        <label>
          Are you upgrading or downsizing?
          <select name="motivation" required>
            <option value="">-- Pick one --</option>
            <option value="first-caravan">First caravan ever</option>
            <option value="upgrading">Upgrading from my current van</option>
            <option value="downsizing">Downsizing from my current van</option>
            <option value="replacing">Replacing a similar-size van</option>
            <option value="not-sure">Not sure yet</option>
          </select>
        </label>

        <label>
          When are you looking to buy?
          <select name="timeline">
            <option value="">-- Pick one --</option>
            <option value="asap">ASAP - happy to take available stock</option>
            <option value="3-months">Within 3 months</option>
            <option value="6-12-months">6 to 12 months</option>
            <option value="researching">Just researching for now</option>
          </select>
        </label>

        <label>
          Anything else? (optional)
          <textarea name="message" placeholder="Specific feature, layout preference, off-grid needs..."></textarea>
        </label>

        <p class="form-policy-note" style="font-size:0.82rem; color:var(--muted, #8B6A40); margin: 6px 0 14px;">
          Heads-up: we don't do trade-ins or finance - we just want this to be the right van for you.
        </p>

        <button type="submit" class="btn-primary">Send my details</button>
      </form>
    </div>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById('new-filters')
      if (!form) return
      const cards = Array.from(document.querySelectorAll('#new-grid .caravan-card'))
      function applyFilters() {
        const brand = (form.brand?.value || '').trim()
        cards.forEach(function (c) {
          const cBrand = c.dataset.brand || ''
          c.style.display = !brand || cBrand === brand ? '' : 'none'
        })
      }
      form.addEventListener('input', applyFilters)
      form.addEventListener('reset', () => setTimeout(applyFilters, 0))
    })()
  </script>

  <style>
    .new-config-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }
    .new-config-card {
      background: #fff;
      border: 1px solid var(--tan-border, #DCCBA8);
      border-radius: 10px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }
    .new-config-card:hover {
      transform: translateY(-3px);
      border-color: var(--rust, #C0341A);
      box-shadow: 0 8px 22px rgba(42,22,8,0.10);
    }
    .new-config-brand {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--rust, #C0341A);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .new-config-name {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--ink, #2A1608);
      line-height: 1.15;
    }
    .new-config-headline {
      color: var(--muted, #8B6A40);
      font-size: 0.92rem;
      line-height: 1.5;
      margin-top: 4px;
    }
    .new-config-price {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      color: var(--ink, #2A1608);
      margin-top: auto;
      padding-top: 14px;
    }
    .new-config-cta {
      color: var(--rust, #C0341A);
      font-weight: 600;
      font-size: 0.92rem;
      margin-top: 6px;
    }
  </style>
</Site>
