---
import Site from '../../layouts/Site.astro'
import { getShows, getSiteSettings, youtubeId } from '../../lib/sanity.js'

let shows = []
let intro = null
let compilationVideo = null
try {
  const [sList, settings] = await Promise.all([getShows(), getSiteSettings()])
  shows = Array.isArray(sList) ? sList : []
  if (settings?.showsIndexIntro && settings.showsIndexIntro.trim()) {
    intro = settings.showsIndexIntro.trim()
  }
  const compilationUrl = settings?.showsCompilationVideo?.youtubeUrl
  const compilationId = compilationUrl ? youtubeId(compilationUrl) : null
  if (compilationId) {
    compilationVideo = {
      id: compilationId,
      caption: settings.showsCompilationVideo?.caption || '',
    }
  }
} catch (err) {
  console.warn('Sanity unreachable for /shows:', err.message)
}

// Brisbane 2026 lives as a Sanity Show document (seeded via
// sanity/scripts/seed-brisbane-show.js) - the hardcoded fallback card
// was removed once that doc landed. The legacy /brisbane-show-2026
// URL stays as a hardcoded page so printed QR codes / Facebook posts
// keep working, but it does not appear on this /shows index.

const statusOrder = { active: 0, upcoming: 1, archived: 2 }
const allCards = shows
  .map((s) => ({
    _id: s._id,
    title: s.title,
    href: s.slug ? `/shows/${s.slug}` : '#',
    status: s.status,
    startDate: s.startDate,
    endDate: s.endDate,
    datesLabel: s.datesLabel,
    venueName: s.venueName,
    standNumber: s.standNumber,
    standArea: s.standArea,
    blurb: s.heroH1 || s.seoDescription || '',
  }))
  .sort((a, b) => {
    const sa = statusOrder[a.status] ?? 9
    const sb = statusOrder[b.status] ?? 9
    if (sa !== sb) return sa - sb
    return (b.startDate || '').localeCompare(a.startDate || '')
  })

const activeAndUpcoming = allCards.filter((c) => c.status !== 'archived')
const archived = allCards.filter((c) => c.status === 'archived')

const description = intro
  || 'Where to see SEQ Campers in person. Caravan shows, expos and events across Queensland.'
---

<Site title="Shows & events" description={description.slice(0, 200)}>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>See us at the next show.</h1>
      <p>The easiest way to walk through every caravan in our range and ask all the questions face-to-face. Sunshine Coast based, we travel to shows across Queensland.</p>
    </div>
  </div>

  {compilationVideo && (
    <section class="section" style="padding-top:24px; padding-bottom:8px;">
      <div class="container" style="max-width:880px;">
        <div class="shows-compilation">
          <div class="shows-compilation-media">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${compilationVideo.id}?autoplay=1&mute=1&loop=1&playlist=${compilationVideo.id}&controls=1&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1`}
              title="Shows compilation"
              frameborder="0"
              allow="autoplay; encrypted-media; fullscreen"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          {compilationVideo.caption && (
            <p class="shows-compilation-caption">{compilationVideo.caption}</p>
          )}
        </div>
      </div>
    </section>
  )}

  {intro && (
    <section class="section" style="padding-top:24px; padding-bottom:0;">
      <div class="container" style="max-width:780px;">
        <p style="color:var(--ink); line-height:1.75; font-size:1.05rem;">{intro}</p>
      </div>
    </section>
  )}

  {activeAndUpcoming.length > 0 && (
    <section class="section" style="padding-top:28px; padding-bottom:24px;">
      <div class="container">
        <div class="page-eyebrow" style="color:var(--rust); margin-bottom:8px;">On now &amp; upcoming</div>
        <h2 class="section-title" style="margin-bottom:18px;">Where to find us next.</h2>

        <div class="shows-grid">
          {activeAndUpcoming.map((s) => (
            <a href={s.href} class={`show-card show-card-${s.status}`}>
              {s.status === 'active' && <div class="show-card-badge show-card-badge-active">On now</div>}
              {s.status === 'upcoming' && <div class="show-card-badge show-card-badge-upcoming">Upcoming</div>}
              <h3 class="show-card-title">{s.title}</h3>
              <div class="show-card-dates">{s.datesLabel || ''}</div>
              <div class="show-card-venue">{s.venueName || ''}</div>
              {(s.standNumber || s.standArea) && (
                <div class="show-card-stand">
                  {s.standNumber && <strong>{s.standNumber}</strong>}
                  {s.standNumber && s.standArea && ' · '}
                  {s.standArea}
                </div>
              )}
              {s.blurb && <p class="show-card-blurb">{s.blurb}</p>}
              <span class="show-card-cta">See show details →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {archived.length > 0 && (
    <section class="section" style="background:var(--sand-deep); padding-top:32px; padding-bottom:32px;">
      <div class="container">
        <div class="page-eyebrow" style="color:var(--muted); margin-bottom:8px;">Past shows</div>
        <h2 class="section-title" style="margin-bottom:18px; color:var(--muted);">Where you've seen us before.</h2>
        <div class="shows-grid shows-grid-archive">
          {archived.map((s) => (
            <a href={s.href} class="show-card show-card-archived">
              <h3 class="show-card-title">{s.title}</h3>
              <div class="show-card-dates">{s.datesLabel || ''}</div>
              <div class="show-card-venue">{s.venueName || ''}</div>
              <span class="show-card-cta">View archive →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band-dark" style="margin-top:8px;">
    <div class="container" style="text-align:center; max-width:680px; margin:0 auto;">
      <h2 style="color:var(--sand); font-size:1.6rem; margin-bottom:10px;">Can't make a show?</h2>
      <p style="color:var(--gold); margin-bottom:22px; line-height:1.6;">
        Our Sunshine Coast showroom is open by appointment. Drive an hour north of Brisbane and you'll get our undivided attention - no show-floor crowd.
      </p>
      <a href="/contact" class="btn-primary">Book a Sunshine Coast visit</a>
    </div>
  </section>

  <style>
    /* Shows compilation video block - sits at the top of /shows when Maud
       has set siteSettings.showsCompilationVideo. 16:9 responsive iframe
       with a small caption below. Per Bart 8 Jun. */
    .shows-compilation {
      margin: 0;
    }
    .shows-compilation-media {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #1a1a1c;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 14px 36px rgba(42, 22, 8, 0.16);
    }
    .shows-compilation-media iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .shows-compilation-caption {
      margin: 12px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* Tighten the brown page-header banner. Used on every page except
       homepage. Per Bart 8 Jun. */
    :global(.page-header.page-header-tight) {
      padding-top: 32px;
      padding-bottom: 32px;
    }

    .shows-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 16px;
    }
    .show-card {
      display: block;
      background: #fff;
      border: 1px solid var(--tan-border);
      border-radius: 14px;
      padding: 22px 24px;
      text-decoration: none;
      color: var(--ink);
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      position: relative;
    }
    .show-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(42,22,8,0.10);
      border-color: var(--rust);
    }
    .show-card-active { border-color: #2BA85F; }
    .show-card-active:hover { border-color: #1F8049; }
    .show-card-archived {
      background: rgba(255,255,255,0.6);
      opacity: 0.85;
    }
    .show-card-badge {
      position: absolute;
      top: -10px;
      left: 22px;
      padding: 5px 12px;
      border-radius: 999px;
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #fff;
    }
    .show-card-badge-active { background: linear-gradient(135deg, #2BA85F 0%, #1F8049 100%); }
    .show-card-badge-upcoming { background: linear-gradient(135deg, #C0341A 0%, #8B2410 100%); }
    .show-card-title {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--ink);
      margin: 6px 0 8px;
      line-height: 1.25;
    }
    .show-card-dates {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      color: var(--rust);
      margin-bottom: 4px;
    }
    .show-card-venue {
      color: var(--muted);
      font-size: 0.92rem;
      margin-bottom: 4px;
    }
    .show-card-stand {
      color: var(--ink);
      font-size: 0.92rem;
      margin-bottom: 10px;
    }
    .show-card-stand strong {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
    }
    .show-card-blurb {
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.55;
      margin: 10px 0 12px;
    }
    .show-card-cta {
      display: inline-block;
      color: var(--rust);
      font-weight: 600;
      font-size: 0.92rem;
    }
  </style>
</Site>
