---
import Site from '../layouts/Site.astro'
import VideoCard from '../components/VideoCard.astro'
import { getVideosByCategory } from '../lib/sanity.js'

let groups = {}
try {
  groups = await getVideosByCategory()
} catch (err) {
  console.warn('Sanity unreachable on build - videos empty:', err.message)
}

// Placeholder videos shown when Sanity has nothing yet, so the page is
// presentable on day one. Maud replaces these by adding real videos in
// the Studio - the placeholders disappear automatically once any video
// of that category is added.
const PLACEHOLDER_VIDEO = 'https://www.youtube.com/watch?v=dQw4w9WcXgQ'
const placeholderGroups = {
  'getting-started': [
    { title: 'Introduction to Kimberley Kampers', youtubeUrl: PLACEHOLDER_VIDEO, description: 'A complete overview of the Kimberley Kampers range - who they\'re built for, what makes them different, and why they\'ve earned a reputation as Australia\'s toughest off-road campers.', category: 'getting-started' },
    { title: 'Why Buy a Kimberley Kamper?', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Shane walks through what sets the Kimberley range apart - build quality, after-sales support, and the kind of trips they were built for.', category: 'getting-started' },
    { title: 'Features on a Platinum Camper-Trailer', youtubeUrl: PLACEHOLDER_VIDEO, description: 'The premium features that come standard on every Platinum: chassis, suspension, kitchen, electrics, and the small touches that matter.', category: 'getting-started' },
  ],
  'setup': [
    { title: 'Preparing to Set-Up Your Karavan', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Site selection, positioning, and the checks that save you hassle later.', category: 'setup' },
    { title: 'Setting Up the Stabilisers & Levelling', youtubeUrl: PLACEHOLDER_VIDEO, description: 'The step-by-step on getting the van level fast - even on rough ground.', category: 'setup' },
    { title: 'Pushing the Bed Out on Your Karavan', youtubeUrl: PLACEHOLDER_VIDEO, description: 'How the bed extension works, what to watch for, and the easiest pack-down sequence.', category: 'setup' },
    { title: 'Packing Up Your Kimberley Karavan', youtubeUrl: PLACEHOLDER_VIDEO, description: 'The full pack-down workflow - the things first-time owners always miss.', category: 'setup' },
  ],
  'deep-dive': [
    { title: 'The New 2026 Stockman Rover 02 is Here!', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Every upgrade, every improvement - Shane walks you through it all.', category: 'deep-dive' },
    { title: 'Touring the Sleek "Night Storm" Interior', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Luxury finishes, Corian benchtops, and dimmable lighting throughout.', category: 'deep-dive' },
    { title: 'Inside the Stockman Rover: No More Cramped Pods!', youtubeUrl: PLACEHOLDER_VIDEO, description: 'See how the new Rover layout makes off-grid living actually comfortable.', category: 'deep-dive' },
  ],
  'on-the-road': [
    { title: 'Can a Mercedes Van Handle Deep Mud?', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Testing the Kimberley Kruiswagen where it\'s supposed to go.', category: 'on-the-road' },
    { title: 'Testing the 50mm Lift Kit Off-Road', youtubeUrl: PLACEHOLDER_VIDEO, description: 'What the lift kit actually gets you on real outback corrugations.', category: 'on-the-road' },
    { title: 'The Ultimate Kimberley Kruiswagen Review', youtubeUrl: PLACEHOLDER_VIDEO, description: 'A full review of the Kruiswagen - what it\'s great at, what it isn\'t, and who it\'s for.', category: 'on-the-road' },
  ],
}

const categorySpec = [
  { key: 'getting-started', title: 'Getting Started', intro: 'New to off-road camping or to the Kimberley / Stockman range? Start here.' },
  { key: 'setup', title: 'Setup & Packing', intro: 'Everything you need to do before you start setting up camp - and how to pack it back down without missing anything.' },
  { key: 'deep-dive', title: 'Product Deep-Dives', intro: 'Walk through specific models and features. The detail that matters when you\'re comparing options.' },
  { key: 'on-the-road', title: 'On the Road', intro: 'We take them where most people wouldn\'t dare drive. Watch what happens.' },
]

const usingPlaceholders = Object.keys(groups).length === 0
const displayGroups = usingPlaceholders ? placeholderGroups : groups
---

<Site
  title="Learn From the Experts"
  description="The SEQ Campers video library - walkthroughs, setup tutorials, deep-dives and off-road testing. Watch before you visit."
>
  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">Education</div>
      <h1>Learn From the Experts</h1>
      <p>The SEQ Campers video library - walkthroughs, setup tutorials, deep-dives and real off-road testing.</p>
    </div>
  </div>

  <!-- YouTube CTA bar -->
  <div class="container" style="margin-top:28px;">
    <div class="youtube-cta-bar">
      <div class="youtube-cta-text">
        <div class="page-eyebrow" style="color:var(--rust); margin-bottom:6px;">YouTube</div>
        <h2 style="font-family:'Inter Tight', sans-serif; font-size:1.3rem; font-weight:600; color:var(--ink); margin-bottom:4px;">
          Watch the full library on YouTube
        </h2>
        <p style="color:var(--muted); font-size:0.92rem;">
          Join 2,000+ off-road enthusiasts. New walkthrough every fortnight.
        </p>
      </div>
      <div class="youtube-cta-buttons">
        <a
          href="https://www.youtube.com/channel/UCOeiI-wxOLUCX1UzMiE6XVg?sub_confirmation=1"
          target="_blank"
          rel="noopener"
          class="btn-primary youtube-btn-subscribe"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" style="vertical-align:-3px; margin-right:6px;">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12l-6.272 3.568z"/>
          </svg>
          Subscribe on YouTube
        </a>
        <a
          href="https://www.youtube.com/channel/UCOeiI-wxOLUCX1UzMiE6XVg/videos"
          target="_blank"
          rel="noopener"
          class="btn-ghost youtube-btn-watch"
        >
          See all videos on YouTube →
        </a>
      </div>
    </div>
  </div>

  {usingPlaceholders && (
    <div class="container" style="margin-top:24px;">
      <div class="configurator-placeholder-note">
        Sample video library shown for layout. Replace each placeholder by
        adding real videos in Sanity Studio (left sidebar → Videos library →
        + Create new). Once any real video is added in a category, that
        category's placeholders disappear automatically.
      </div>
    </div>
  )}

  <section class="section">
    <div class="container">
      {categorySpec.map((cat) => {
        const vids = displayGroups[cat.key] || []
        if (vids.length === 0) return null
        return (
          <div class="video-category-block">
            <div class="video-category-header">
              <h2 class="section-title">{cat.title}</h2>
              <p class="video-category-intro">{cat.intro}</p>
            </div>
            <div class="video-grid">
              {vids.map((v) => <VideoCard video={v} showCategory={false} />)}
            </div>
          </div>
        )
      })}
    </div>
  </section>

  <section class="band-dark">
    <div class="container" style="text-align:center; max-width:680px; margin:0 auto;">
      <h2 style="color:var(--sand); font-size:1.8rem; margin-bottom:12px;">There's nothing like walking through one yourself.</h2>
      <p style="color:var(--gold); margin-bottom:24px;">
        Book a time and Shane or Maud will show you around.
      </p>
      <a href="/contact" class="btn-primary">Book a walkthrough</a>
    </div>
  </section>
</Site>
