---
import Site from '../layouts/Site.astro'
import VideoCard from '../components/VideoCard.astro'
import YoutubeSubscribeBar from '../components/YoutubeSubscribeBar.astro'
import ReserveCta from '../components/ReserveCta.astro'
import { getVideosPageSettings, flattenVideosPage } from '../lib/sanity.js'

// /videos uses the videosPageSettings singleton - 12 curated slots
// (6 Kimberley + 6 Stockman). Maud edits each slot directly in
// Sanity Studio (Pages & content -> Videos page) and the tile auto-
// hides if the YouTube URL is left blank.
let settings = null
try {
  settings = await getVideosPageSettings()
} catch (err) {
  console.warn('Sanity unreachable for videos page settings:', err.message)
}
const { kimberley: kimberleySlots, stockman: stockmanSlots } = flattenVideosPage(settings)

// Placeholders shown only when Maud has not configured any slots yet.
// Disappear automatically as soon as she fills in one URL per tree.
const PLACEHOLDER_VIDEO = 'https://www.youtube.com/watch?v=tozC7prVbOg'
const kimberleyPlaceholders = [
  { _id: 'k1', title: 'Kimberley Karavan walk-around', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Inside and out of the Karavan - the original hybrid that started it all.', category: 'deep-dive', brandFamily: 'kimberley' },
  { _id: 'k2', title: 'Kimberley Kube - compact off-road', youtubeUrl: PLACEHOLDER_VIDEO, description: 'The smaller, lighter cousin. Same Kimberley build standard.', category: 'deep-dive', brandFamily: 'kimberley' },
  { _id: 'k3', title: 'Kimberley Kruiswagen - expedition motorhome', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Mercedes 4x4 chassis. Drive it, sleep in it, live out of it.', category: 'deep-dive', brandFamily: 'kimberley' },
  { _id: 'k4', title: 'Kimberley Kruiser T Class', youtubeUrl: PLACEHOLDER_VIDEO, description: 'The luxury off-road tourer. Long-haul ready.', category: 'deep-dive', brandFamily: 'kimberley' },
  { _id: 'k5', title: 'Kimberley Kruiser S Class', youtubeUrl: PLACEHOLDER_VIDEO, description: 'The flagship. Apartment-grade interior, expedition chassis.', category: 'deep-dive', brandFamily: 'kimberley' },
  { _id: 'k6', title: 'Kimberley Karavan setup walk-through', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Step-by-step setup of the pop-top mechanism and stabilisers.', category: 'setup', brandFamily: 'kimberley' },
]
const stockmanPlaceholders = [
  { _id: 's1', title: 'Stockman Trekka - the hard-floor camper', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Lower, lighter, tougher. Built for serious tracks.', category: 'deep-dive', brandFamily: 'stockman' },
  { _id: 's2', title: 'Stockman Rover - the all-rounder', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Off-grid ready, family friendly, 90-second setup.', category: 'deep-dive', brandFamily: 'stockman' },
  { _id: 's3', title: 'Stockman Pod Trailer walk-around', youtubeUrl: PLACEHOLDER_VIDEO, description: 'The compact pod for couples and weekend warriors.', category: 'deep-dive', brandFamily: 'stockman' },
  { _id: 's4', title: 'Setting up a Stockman in 90 seconds', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Arrival to kettle-on. Time-lapse of the easiest setup in the range.', category: 'setup', brandFamily: 'stockman' },
  { _id: 's5', title: 'Stockman Rover off-road test', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Sand, corrugations, river crossings. Real tracks, no studio.', category: 'on-the-road', brandFamily: 'stockman' },
  { _id: 's6', title: 'Stockman Pod - couples weekender setup', youtubeUrl: PLACEHOLDER_VIDEO, description: 'Compact, agile, ready to go. Setup walk-through.', category: 'setup', brandFamily: 'stockman' },
]

const kimberley = kimberleySlots.length ? kimberleySlots : kimberleyPlaceholders
const stockman = stockmanSlots.length ? stockmanSlots : stockmanPlaceholders
const general = []
const usingPlaceholders = !kimberleySlots.length && !stockmanSlots.length
---

<Site
  title="Watch - off-road model videos"
  description="Browse the SEQ Campers off-road video library on the Sunshine Coast. Kimberley Campers Kingdom + Stockman Products Convoy - walk-arounds, setup tutorials, deep-dives and real off-road testing."
>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>Learn more about our off-road models.</h1>
      <p>Two collections. Pick a brand and dive in - walk-arounds, setup, deep-dives and real off-road testing.</p>
    </div>
  </div>


  <!-- Two top-level tree entry tiles - Shane's "two trees that come out of Watch" -->
  <section class="section" style="padding-top:32px; padding-bottom:24px;">
    <div class="container">
      <div class="watch-tree-tiles">
        <a href="#kimberley-tree" class="watch-tree-tile watch-tree-kimberley">
          <h2>Kimberley Campers</h2>
          <p>30+ years Australian-built. Karavan, Kube, Kruiswagen, Kruiser T &amp; S.</p>
          <span class="watch-tree-cta">See the Kimberley Kingdom ↓</span>
        </a>
        <a href="#stockman-tree" class="watch-tree-tile watch-tree-stockman">
          <h2>Stockman Products</h2>
          <p>Built tough, ready for the track. Trekka, Rover, Pod.</p>
          <span class="watch-tree-cta">See the Stockman Convoy ↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Kimberley Kingdom -->
  <section id="kimberley-tree" class="section" style="padding-top:24px;">
    <div class="container">
      <div class="section-header" style="flex-direction:column; align-items:flex-start; gap:4px;">
        <div class="page-eyebrow" style="color:var(--rust);">Kimberley Campers</div>
        <h2 class="section-title">The Kimberley Kingdom</h2>
        <p style="color:var(--muted); margin-top:6px;">{kimberley.length} video{kimberley.length !== 1 ? 's' : ''} across the Kimberley Campers range.</p>
      </div>
      <div class="video-grid" style="margin-top:18px;">
        {kimberley.map((v) => <VideoCard video={v} showCategory={false} />)}
      </div>
    </div>
  </section>

  <!-- Stockman Convoy -->
  <section id="stockman-tree" class="section" style="background:var(--sand-deep); padding-top:32px;">
    <div class="container">
      <div class="section-header" style="flex-direction:column; align-items:flex-start; gap:4px;">
        <div class="page-eyebrow" style="color:var(--rust);">Stockman Products</div>
        <h2 class="section-title">The Stockman Convoy</h2>
        <p style="color:var(--muted); margin-top:6px;">{stockman.length} video{stockman.length !== 1 ? 's' : ''} across the Stockman Products range.</p>
      </div>
      <div class="video-grid" style="margin-top:18px;">
        {stockman.map((v) => <VideoCard video={v} showCategory={false} />)}
      </div>
    </div>
  </section>

  {general.length > 0 && (
    <section class="section" style="padding-top:32px;">
      <div class="container">
        <div class="section-header" style="flex-direction:column; align-items:flex-start; gap:4px;">
          <div class="page-eyebrow" style="color:var(--rust);">General</div>
          <h2 class="section-title">Other videos</h2>
        </div>
        <div class="video-grid" style="margin-top:18px;">
          {general.map((v) => <VideoCard video={v} showCategory={false} />)}
        </div>
      </div>
    </section>
  )}

  <YoutubeSubscribeBar variant="bar" headline="Watch the full library on YouTube" sub="Join 2,000+ off-road enthusiasts. New walkthrough every fortnight." />

  <ReserveCta variant="band" />

  <style>
    .watch-tree-tiles {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    @media (max-width: 760px) { .watch-tree-tiles { grid-template-columns: 1fr; } }
    .watch-tree-tile {
      display: block;
      padding: 26px 28px;
      border-radius: 14px;
      text-decoration: none;
      color: #fff;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .watch-tree-tile:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 30px rgba(0,0,0,0.18);
    }
    .watch-tree-kimberley {
      background: linear-gradient(135deg, #2B5A3F 0%, #1A3A28 100%);
    }
    .watch-tree-stockman {
      background: linear-gradient(135deg, #8B4513 0%, #5A2E0C 100%);
    }
    .watch-tree-eyebrow {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.8;
      margin-bottom: 6px;
    }
    .watch-tree-tile h2 {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.8rem;
      font-weight: 800;
      margin: 0 0 8px;
      letter-spacing: -0.01em;
      color: #fff;
    }
    .watch-tree-tile p {
      color: rgba(255,255,255,0.88);
      font-size: 0.98rem;
      line-height: 1.55;
      margin: 0 0 14px;
    }
    .watch-tree-cta {
      display: inline-block;
      font-weight: 600;
      color: #fff;
      opacity: 0.95;
    }
  </style>
</Site>
