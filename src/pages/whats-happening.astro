---
import Site from '../layouts/Site.astro'
import { getHappeningsFeed, shortDate } from '../lib/sanity.js'

// The full feed (editor "What's Happening" items + upcoming/active shows),
// newest first, from Sanity. Maud adds items in Studio and they appear here
// automatically. Shows fold in on their own - no duplicate doc needed.
let feed = []
try {
  feed = await getHappeningsFeed()
} catch (err) {
  console.warn('Sanity unreachable for /whats-happening:', err.message)
}

// Featured story - still hardcoded for now (move to Sanity later if wanted).
const featured = {
  title: 'The 2026 Stockman Rover 02 is in the showroom',
  body: 'The wait is over. Stockman\'s flagship slide-on camper has been completely redesigned for 2026 - stronger chassis, updated kitchen layout, and a new electrical system that makes off-grid living even easier. Come see it for yourself.',
}

const happyCampers = [
  { name: 'Mitchell Family', detail: 'Kimberley Karavan', story: 'Heading north for three months. First big trip with the kids.' },
  { name: 'Dave & Linda', detail: 'Kruiser S-Class', story: 'The big lap finally starts in May. Five years of planning.' },
  { name: 'O\'Brien Crew', detail: 'Stockman Rover', story: 'Weekend warriors from Brisbane. New playground every Saturday.' },
  { name: 'Raj & Priya', detail: 'Kimberley Kube', story: 'Compact luxury for two - first hit-the-road trip in years.' },
]

const typeColors = {
  'New Arrival': 'rust',
  'Handover': 'green',
  'Event': 'gold',
  'New Video': 'blue',
  'Workshop': 'muted',
  'News': 'muted',
}
---

<Site
  title="What's Happening at SEQ Campers"
  description="News, events, deliveries, and stories from the SEQ Campers showroom floor. New arrivals, customer handovers, workshop jobs, and upcoming shows."
>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>What's Happening</h1>
      <p>News, events, deliveries, and stories from the showroom floor.</p>
    </div>
  </div>

  <!-- Featured story -->
  <section class="section">
    <div class="container" style="max-width:880px;">
      <div class="featured-story">
        <div class="page-eyebrow" style="color:var(--rust);">Featured</div>
        <h2>{featured.title}</h2>
        <p>{featured.body}</p>
        <a href="/stock" class="btn-primary" style="margin-top:16px;">See it on the floor</a>
      </div>
    </div>
  </section>

  <!-- Timeline (from Sanity) -->
  <section class="section" style="background:var(--sand-deep); padding-top:64px; padding-bottom:64px;">
    <div class="container" style="max-width:880px;">
      <h2 class="section-title" style="margin-bottom:32px;">From the showroom floor</h2>
      {feed.length > 0 ? (
        <div class="news-timeline">
          {feed.map((n) => (
            <article class="news-item">
              <div class="news-date">{shortDate(n.date)}</div>
              <div class="news-body">
                <span class={`news-type news-type-${typeColors[n.type] || 'muted'}`}>{n.type}</span>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
                {n.link && (
                  <a
                    href={n.link}
                    {...(/^https?:\/\//i.test(n.link) ? { rel: 'noopener', target: '_blank' } : {})}
                    style="color:var(--rust); font-weight:600; text-decoration:none;"
                  >Read more →</a>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p style="color:var(--muted);">Nothing to report just now - check back soon, or see our <a href="/shows" style="color:var(--rust); font-weight:600;">upcoming shows</a>.</p>
      )}
    </div>
  </section>

  <!-- Happy campers -->
  <section class="section">
    <div class="container" style="max-width:1080px;">
      <div class="section-header">
        <div>
          <div class="page-eyebrow" style="color:var(--rust);">Happy Campers</div>
          <h2 class="section-title">Out there doing it</h2>
        </div>
      </div>
      <p style="color:var(--muted); margin-bottom:24px; max-width:680px;">
        There's nothing better than handing over the keys and watching a family head off on their first trip. Tag us on Instagram <a href="https://www.instagram.com/seq_campers/" rel="noopener" target="_blank" style="color:var(--rust); font-weight:600;">@seq_campers</a> and we'll feature your adventure right here.
      </p>
      <div class="happy-grid">
        {happyCampers.map((c) => (
          <div class="happy-card">
            <div class="happy-photo">
              <span>Photo<br/>placeholder</span>
            </div>
            <div class="happy-meta">
              <div class="happy-name">{c.name}</div>
              <div class="happy-detail">{c.detail}</div>
              <p class="happy-story">{c.story}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Site>
