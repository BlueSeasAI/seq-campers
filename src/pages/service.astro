---
import Site from '../layouts/Site.astro'
import { getSiteSettings } from '../lib/sanity.js'

let settings = {}
try { settings = await getSiteSettings() ?? {} } catch (err) {
  console.warn('Sanity unreachable on build:', err.message)
}

const services = [
  {
    title: 'Scheduled service',
    body: 'Bearings, brakes, lights, hoses, gas, electrics. The full pre-trip check.',
  },
  {
    title: 'Warranty work',
    body: 'Authorised warranty service for Kimberley Kampers and Stockman Products.',
  },
  {
    title: 'Custom modifications',
    body: 'Solar upgrades, lithium swap-outs, awnings, bike racks, storage. Set your rig up your way.',
  },
]
---

<Site
  title="Workshop & Service"
  description="SEQ Campers' on-site workshop services off-road campers and caravans on the Sunshine Coast. Scheduled service, warranty work, custom modifications."
>
  <div class="page-header">
    <div class="container">
      <div class="page-eyebrow">Workshop & owners group</div>
      <h1>Buy here. Service here. Stay part of the family.</h1>
    </div>
  </div>

  <!-- Meet the team video placeholder (real video coming from Anna's footage) -->
  <section class="section" style="padding-bottom:24px;">
    <div class="container" style="max-width:980px;">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:4px; margin-bottom:18px;">
        <div class="page-eyebrow" style="color:var(--rust);">Meet the team</div>
        <h2 class="section-title">The people looking after your van</h2>
      </div>
      <div class="meet-the-team-video">
        <div class="meet-the-team-placeholder" aria-label="Meet the team video coming soon">
          <div class="meet-the-team-icon" aria-hidden="true">▶</div>
          <div class="meet-the-team-text">
            <strong>Meet the team video</strong>
            <span>Grant, Mike and the SEQ workshop crew. Video lands here once Anna's footage is uploaded.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:24px; padding-bottom:24px;">
    <div class="container">
      <div class="services-grid">
        {services.map((s) => (
          <div class="service-card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Booking form (Netlify Forms) -->
  <section class="section" style="background:var(--sand-deep);">
    <div class="container" style="max-width:680px;">
      <div class="section-header" style="text-align:center; display:block;">
        <div class="page-eyebrow" style="color:var(--rust);">Book it in</div>
        <h2 class="section-title" style="margin-top:6px;">Get your rig booked into the workshop</h2>
      </div>

      <form
        class="enquiry-form"
        name="workshop-booking"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
        style="margin-top:24px;"
      >
        <input type="hidden" name="form-name" value="workshop-booking" />
        <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <label>
            Your name
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" required autocomplete="tel" placeholder="04xx xxx xxx" />
          </label>
        </div>

        <label>
          Email
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <div class="form-row">
          <label>
            Make / model
            <input type="text" name="caravan_model" placeholder="e.g. Kimberley Karavan 2022" />
          </label>
          <label>
            What's needed?
            <select name="service_type" required>
              <option value="">-- Pick one --</option>
              <option value="scheduled-service">Scheduled service</option>
              <option value="pre-trip-check">Pre-trip check</option>
              <option value="warranty-work">Warranty work</option>
              <option value="custom-mod">Custom modification</option>
              <option value="repair">Repair / fault</option>
              <option value="other">Other</option>
            </select>
          </label>
        </div>

        <label>
          Anything specific we should know?
          <textarea name="message" placeholder="Recent symptoms, upcoming trip dates, parts already sourced..."></textarea>
        </label>

        <button type="submit">Send booking request</button>
      </form>
    </div>
  </section>
</Site>
