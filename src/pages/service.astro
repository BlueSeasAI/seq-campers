---
import Site from '../layouts/Site.astro'
import ReserveCta from '../components/ReserveCta.astro'
import YoutubeSubscribeBar from '../components/YoutubeSubscribeBar.astro'
import { getSiteSettings, youtubeId } from '../lib/sanity.js'

let settings = {}
try { settings = await getSiteSettings() ?? {} } catch (err) {
  console.warn('Sanity unreachable on build:', err.message)
}

const services = [
  {
    title: 'Scheduled service & pre-trip check',
    body: 'Bearings, brakes, lights, hoses, gas, electrics. The full pre-trip check on every off-road caravan and 4x4 camper van before you point it at the outback.',
  },
  {
    title: 'Authorised warranty work',
    body: 'Authorised warranty service for Kimberley Kampers (Karavan, Kube, Kruiswagen, Kruiser) and Stockman Products (Trekka, Rover, Pod) on the Sunshine Coast.',
  },
  {
    title: 'Off-grid upgrades & custom mods',
    body: 'Solar upgrades, lithium battery swap-outs, REDARC systems, awnings, bike racks, storage builds. Set your off-grid caravan up your way.',
  },
]

// 6 service-page video tiles - 3x2 grid. Each tile is Sanity-driven via
// settings.servicePageVideo1..6. If a slot is empty we fall back to a sensible
// default so the page never looks broken. Maud can update each slot directly
// in Sanity Studio (Site Settings -> Service page videos).
const DEFAULT_TEAM_VIDEO = 'https://youtu.be/cbJPJQeNHSQ'

// Single row of 3 tiles only per Bart 16 Jun ("we just want three, one row").
const serviceTileDefaults = [
  { youtubeUrl: DEFAULT_TEAM_VIDEO, label: 'Meet Shane - owner since 2019' },
  { youtubeUrl: DEFAULT_TEAM_VIDEO, label: 'Meet Maud - co-owner & operations' },
  { youtubeUrl: DEFAULT_TEAM_VIDEO, label: 'Meet the workshop crew' },
]

const serviceTiles = serviceTileDefaults.map((def, i) => {
  const slot = settings?.[`servicePageVideo${i + 1}`] || {}
  return {
    youtubeUrl: slot.youtubeUrl || def.youtubeUrl,
    label: slot.label || def.label,
  }
}).filter((t) => !!t.youtubeUrl)

// Workshop-weekly video - single tile shown below the team grid, refreshed
// weekly. Sanity-driven via settings.serviceWorkshopWeekly. Hidden if blank.
const workshopWeekly = settings?.serviceWorkshopWeekly?.youtubeUrl
  ? settings.serviceWorkshopWeekly
  : { youtubeUrl: DEFAULT_TEAM_VIDEO, caption: 'Placeholder - Maud refreshes this weekly with the latest workshop clip.' }
---

<Site
  title="Workshop & Service - Sunshine Coast"
  description="SEQ Campers on-site workshop services off-road caravans, off-grid hybrids and 4x4 camper vans on the Sunshine Coast. Scheduled service, authorised Kimberley Kampers and Stockman Products warranty work, custom modifications - all in Marcoola, Queensland."
>
  <div class="page-header page-header-tight">
    <div class="container">
      <h1>From our Sunshine Coast workshop to your off-grid driveway.</h1>
      <p>Off-road caravan servicing, off-grid system upgrades and authorised Kimberley Kampers and Stockman Products warranty work - all under one roof in Marcoola, Queensland.</p>
    </div>
  </div>

  <!-- Meet the team - 3x2 grid of 16:9 video tiles (Sanity-driven) -->
  <section class="section" style="padding-top:32px; padding-bottom:24px;">
    <div class="container">
      <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:4px; margin-bottom:18px;">
        <div class="page-eyebrow" style="color:var(--rust);">Meet the crew</div>
        <h2 class="section-title">Keeping you moving. In a SEQ.</h2>
      </div>
      <div class="service-video-grid">
        {serviceTiles.map((tile) => {
          const vid = youtubeId(tile.youtubeUrl)
          return (
            <div class="service-video-tile">
              <div class="service-video-media">
                {vid && (
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${vid}?autoplay=1&mute=1&loop=1&playlist=${vid}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0`}
                    title={tile.label}
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                    allowfullscreen="false"
                    tabindex="-1"
                    inert
                    loading="lazy"
                  ></iframe>
                )}
                <div class="service-video-block" aria-hidden="true"></div>
              </div>
              {tile.label && <div class="service-video-label">{tile.label}</div>}
            </div>
          )
        })}
      </div>
    </div>
  </section>

  <!-- This week in the workshop -->
  {workshopWeekly?.youtubeUrl && (
    <section class="section" style="padding-top:24px; padding-bottom:32px;">
      <div class="container" style="max-width:920px;">
        <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; gap:4px; margin-bottom:18px;">
          <div class="page-eyebrow" style="color:var(--rust);">This week in the workshop</div>
          <h2 class="section-title">What we're working on right now</h2>
        </div>
        <div class="workshop-weekly-tile">
          <div class="workshop-weekly-media">
            {(() => {
              const vid = youtubeId(workshopWeekly.youtubeUrl)
              return vid ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${vid}?autoplay=1&mute=1&loop=1&playlist=${vid}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&showinfo=0`}
                  title="This week in the workshop"
                  frameborder="0"
                  allow="autoplay; encrypted-media"
                  allowfullscreen="false"
                  tabindex="-1"
                  inert
                  loading="lazy"
                ></iframe>
              ) : null
            })()}
            <div class="workshop-weekly-block" aria-hidden="true"></div>
          </div>
          {workshopWeekly.caption && (
            <p class="workshop-weekly-caption">{workshopWeekly.caption}</p>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:24px; padding-bottom:24px;">
    <div class="container">
      <div class="services-grid">
        {services.map((s) => (
          <div class="service-card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Booking form (Netlify Forms) -->
  <section class="section" style="background:var(--sand-deep);">
    <div class="container" style="max-width:680px;">
      <div class="section-header" style="text-align:center; display:block;">
        <div class="page-eyebrow" style="color:var(--rust);">Book it in</div>
        <h2 class="section-title" style="margin-top:6px;">Get your rig booked into the workshop</h2>
      </div>

      <form
        class="enquiry-form"
        name="workshop-booking"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
        style="margin-top:24px;"
      >
        <input type="hidden" name="form-name" value="workshop-booking" />
        <p class="hp" style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <label>
            Your name
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" required autocomplete="tel" placeholder="04xx xxx xxx" />
          </label>
        </div>

        <label>
          Email
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <div class="form-row">
          <label>
            Make / model
            <input type="text" name="caravan_model" placeholder="e.g. Kimberley Karavan 2022" />
          </label>
          <label>
            What's needed?
            <select name="service_type" required>
              <option value="">-- Pick one --</option>
              <option value="scheduled-service">Scheduled service</option>
              <option value="pre-trip-check">Pre-trip check</option>
              <option value="warranty-work">Warranty work</option>
              <option value="custom-mod">Custom modification</option>
              <option value="repair">Repair / fault</option>
              <option value="other">Other</option>
            </select>
          </label>
        </div>

        <label>
          Anything specific we should know?
          <textarea name="message" placeholder="Recent symptoms, upcoming trip dates, parts already sourced..."></textarea>
        </label>

        <button type="submit">Send booking request</button>
      </form>
    </div>
  </section>

  <style>
    .service-video-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    @media (max-width: 880px) { .service-video-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 540px) { .service-video-grid { grid-template-columns: 1fr; } }
    .service-video-tile {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .service-video-media {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #1a1a1c;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--tan-border, #DCCBA8);
    }
    .service-video-media iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .service-video-block {
      position: absolute;
      inset: 0;
      z-index: 5;
      background: transparent;
      pointer-events: auto;
    }
    .service-video-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      color: var(--ink, #2A1608);
      font-size: 0.98rem;
      line-height: 1.3;
    }

    .workshop-weekly-tile {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .workshop-weekly-media {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #1a1a1c;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--tan-border, #DCCBA8);
    }
    .workshop-weekly-media iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .workshop-weekly-block {
      position: absolute;
      inset: 0;
      z-index: 5;
      background: transparent;
      pointer-events: auto;
    }
    .workshop-weekly-caption {
      color: var(--muted, #8B6A40);
      font-size: 0.95rem;
      text-align: center;
    }
  </style>

  <YoutubeSubscribeBar variant="bar" headline="Watch the workshop in action" sub="Weekly clips from Marcoola. Subscribe to see what's on the bench right now." />
  <ReserveCta variant="band" />
</Site>
