---
import Site from '../../layouts/Site.astro'
import { getAllBlogSlugs, getBlogPostBySlug } from '../../lib/sanity.js'

export async function getStaticPaths() {
  let slugs = []
  try { slugs = await getAllBlogSlugs() } catch (err) { /* ignore */ }
  // Only real, published Sanity posts get a page. A force-built
  // 'placeholder-lorem-ipsum' route used to live here and was being crawled by
  // AI search engines, which dragged down the site's AEO freshness signals.
  return slugs.filter((s) => s.slug).map((s) => ({ params: { slug: s.slug } }))
}

const { slug } = Astro.params
let post = null
try { post = await getBlogPostBySlug(slug) } catch (err) { /* ignore */ }

if (!post) return Astro.redirect('/blog')

const fmtDate = (iso) => {
  if (!iso) return ''
  try { return new Date(iso).toLocaleDateString('en-AU', { day: '2-digit', month: 'long', year: 'numeric' }) }
  catch { return '' }
}

// Show an "Updated" date only when it is genuinely a different day to the
// published date - keeps the freshness signal honest, never a fake bump.
const showUpdated = post.updatedAt && fmtDate(post.updatedAt) !== fmtDate(post.publishedAt)

// BlogPosting structured data for AI search + rich results. Every field is
// driven from the real Sanity document: datePublished from publishedAt,
// dateModified from the document's own _updatedAt - so the freshness signal
// AI engines read is accurate, never invented.
const siteBase = Astro.site ?? new URL('https://seqcampers.com.au')
const postUrl = new URL(`/blog/${slug}/`, siteBase).href
const absImage = post.coverImage
  ? (String(post.coverImage).startsWith('http') ? post.coverImage : new URL(post.coverImage, siteBase).href)
  : undefined
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt || post.publishedAt,
  author: { '@type': 'Organization', name: post.author || 'SEQ Campers' },
  publisher: {
    '@type': 'Organization',
    name: 'SEQ Campers',
    logo: { '@type': 'ImageObject', url: new URL('/seq-logo-new.png', siteBase).href },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  ...(absImage ? { image: absImage } : {}),
}
---

<Site
  title={`${post.title} - SEQ Campers blog`}
  description={post.excerpt}
  ogImage={post.coverImage}
  ogType="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogSchema)} />

  <article class="blog-post">
    <header class="blog-post-header">
      <div class="container" style="max-width:780px;">
        <div class="blog-post-meta">{fmtDate(post.publishedAt)}{post.author && ` · ${post.author}`}{showUpdated && ` · Updated ${fmtDate(post.updatedAt)}`}</div>
        <h1 class="blog-post-title">{post.title}</h1>
        <p class="blog-post-excerpt">{post.excerpt}</p>
      </div>
    </header>

    {post.coverImage && (
      <div class="container" style="max-width:980px;">
        <div class="blog-post-cover">
          <img src={post.coverImage} alt={post.title} loading="eager" />
        </div>
      </div>
    )}

    <div class="container" style="max-width:780px;">
      <div class="blog-post-body">
        {Array.isArray(post.body) ? (
          post.body
            .filter((b) => b._type === 'block' && Array.isArray(b.children))
            .map((b) => <p>{b.children.map((c) => c.text).join('')}</p>)
        ) : (
          <p>This post is being written. Check back soon.</p>
        )}
      </div>

      <div class="blog-post-foot">
        <a href="/blog" class="btn-ghost">← Back to all posts</a>
      </div>
    </div>
  </article>

  <style>
    .blog-post-header { padding: 32px 0 16px; }
    .blog-post-meta {
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.85rem;
      color: var(--muted, #8B6A40);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 10px;
    }
    .blog-post-title {
      font-family: 'Inter Tight', sans-serif;
      font-size: 2.4rem;
      font-weight: 800;
      color: var(--ink, #2A1608);
      line-height: 1.15;
      margin: 0 0 14px;
      letter-spacing: -0.01em;
    }
    @media (max-width: 600px) {
      .blog-post-title { font-size: 1.9rem; }
    }
    .blog-post-excerpt {
      font-size: 1.15rem;
      color: var(--muted, #8B6A40);
      line-height: 1.55;
      margin: 0;
    }
    .blog-post-cover {
      margin: 24px 0;
      border-radius: 14px;
      overflow: hidden;
      aspect-ratio: 16 / 9;
      background: var(--sand-deep, #EBE0CD);
    }
    .blog-post-cover img { width: 100%; height: 100%; object-fit: cover; }
    .blog-post-body {
      font-size: 1.08rem;
      line-height: 1.75;
      color: var(--ink, #2A1608);
      padding-bottom: 32px;
    }
    .blog-post-body p { margin: 0 0 18px; }
    .blog-post-foot {
      border-top: 1px solid var(--tan-border, #DCCBA8);
      padding: 24px 0 48px;
    }
  </style>
</Site>
