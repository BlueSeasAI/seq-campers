---
import '../styles/global.css'

const {
  title = 'Premium Off-Road Caravans',
  description = "Queensland's home for premium off-road caravans. Kimberley Kampers, Stockman, and more.",
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props

const pathname = Astro.url.pathname
const isActive = (path) => {
  if (path === '/') return pathname === '/'
  return pathname === path || pathname.startsWith(path + '/')
}
// Home page gets a transparent header that overlays the hero video, like
// skyerv.com. All other pages get the standard solid sticky header.
const isHome = pathname === '/'

// Build canonical + absolute OG image URLs from site base
const siteBase = Astro.site ?? new URL('https://seqcampers.com.au')
const canonicalUrl = new URL(pathname, siteBase).href
const absoluteOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBase).href)
  : null

const fullTitle = title.includes('SEQ Campers') ? title : `${title} | SEQ Campers`
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SEQ Campers" />
  <meta property="og:locale" content="en_AU" />
  {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

  <!-- Theme + favicon hooks -->
  <meta name="theme-color" content="#2A1608" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <slot name="head" />
</head>
<body data-home={isHome ? 'true' : 'false'}>
  <header class={`site-header ${isHome ? 'site-header-overlay' : ''}`}>
    <div class="container">
      <a href="/" class="logo" aria-label="SEQ Campers home">
        <img src="/seq-logo-new.png" alt="SEQ Campers - Campers There & Back" width="600" height="338" />
      </a>

      <button
        class="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="primary-nav"
        type="button"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <nav id="primary-nav">
        <a href="/new" class={isActive('/new') ? 'is-active' : ''}>New</a>
        <a href="/stock" class={isActive('/stock') ? 'is-active' : ''}>Stock</a>
        <a href="/videos" class={isActive('/videos') ? 'is-active' : ''}>Videos</a>
        <a href="/service" class={isActive('/service') ? 'is-active' : ''}>Service</a>
        <a href="/brisbane-show-2026" class={isActive('/brisbane-show-2026') ? 'is-active' : ''}>Brisbane Show</a>
        <a href="/brisbane-show-2026" class="nav-cta">Reserve a show slot</a>
      </nav>
    </div>
  </header>

  <script is:inline>
    (function () {
      const btn = document.querySelector('.nav-toggle')
      const nav = document.getElementById('primary-nav')
      if (!btn || !nav) return
      btn.addEventListener('click', function () {
        const open = nav.classList.toggle('is-open')
        btn.setAttribute('aria-expanded', open ? 'true' : 'false')
        document.body.style.overflow = open ? 'hidden' : ''
      })
      // Close nav when any link is clicked (mobile flow)
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav.classList.remove('is-open')
          btn.setAttribute('aria-expanded', 'false')
          document.body.style.overflow = ''
        })
      })

      // Home page only: toggle .is-scrolled on the header once past the hero
      const header = document.querySelector('.site-header-overlay')
      if (header) {
        const threshold = 80
        const onScroll = () => {
          if (window.scrollY > threshold) header.classList.add('is-scrolled')
          else header.classList.remove('is-scrolled')
        }
        onScroll()
        window.addEventListener('scroll', onScroll, { passive: true })
      }
    })()
  </script>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>SEQ Campers</h4>
          <p class="footer-brand">Premium off-road caravans on the Sunshine Coast. Kimberley Kampers and Stockman, hand-picked and inspected by the SEQ team.</p>
          <address class="footer-address">
            3B/6 Bonanza Court<br />
            Marcoola QLD 4564<br />
            <a href="tel:0753707933">(07) 5370 7933</a><br />
            <a href="mailto:office@seqcampers.com.au">office@seqcampers.com.au</a>
          </address>
        </div>

        <div class="footer-col">
          <h4>Showroom hours</h4>
          <div class="footer-hours-compact">
            <strong>Mon - Wed</strong> 7:30am - 3pm<br />
            <strong>Thu - Fri</strong> 8:30am - 3pm<br />
            <strong>Saturday</strong> 8:30am - 12:30pm<br />
            <strong>Sunday</strong> Closed
          </div>
          <p style="margin-top:12px; font-size:0.78rem; color:rgba(244,237,224,0.5);">
            Visits by appointment recommended.
          </p>
        </div>

        <div class="footer-col">
          <h4>Browse</h4>
          <ul>
            <li><a href="/stock">Stock</a></li>
            <li><a href="/videos">Videos</a></li>
            <li><a href="/service">Service & workshop</a></li>
            <li><a href="/whats-happening">What's happening</a></li>
            <li><a href="/brisbane-show-2026">Brisbane Show 2026</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>About SEQ</h4>
          <ul>
            <li><a href="/about">About us</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="https://www.youtube.com/channel/UCOeiI-wxOLUCX1UzMiE6XVg" target="_blank" rel="noopener">YouTube channel</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>&copy; {new Date().getFullYear()} SEQ Campers. Queensland, Australia.</div>
        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
