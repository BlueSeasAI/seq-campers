---
import '../styles/global.css'
import { getSiteSettings, getBusinessDetails } from '../lib/sanity.js'
import TrustStrip from '../components/TrustStrip.astro'

const {
  title = 'Premium Off-Road Caravans',
  description = "The Sunshine Coast's home for premium off-road caravans. Authorised Kimberley Kampers and Stockman Products dealer. Hand-picked, hand-inspected, ready to tow.",
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props

const pathname = Astro.url.pathname
const isActive = (path) => {
  if (path === '/') return pathname === '/'
  return pathname === path || pathname.startsWith(path + '/')
}
// Home page gets a transparent header that overlays the hero video, like
// skyerv.com. All other pages get the standard solid sticky header.
const isHome = pathname === '/'

// Site-wide "Get it before [date]" banner. Maud sets the headline in
// Sanity Site Settings; if blank or the end date has passed the banner
// is null and we render nothing.
let showSpecial = null
try {
  const settings = await getSiteSettings()
  if (settings?.showSpecial?.headline) showSpecial = settings.showSpecial
} catch (err) {
  console.warn('Sanity unreachable for show-special banner:', err.message)
}

// Sitewide contact details (contact bar + footer). Editable by Maud in one
// spot (Studio -> Business details); every value keeps the current hardcoded
// literal as a fallback so nothing changes until the record exists and nothing
// breaks if Sanity is unreachable.
const biz = await getBusinessDetails()
const phoneDisplay = biz?.phoneDisplay || '(07) 5370 7933'
const phoneHref = biz?.phoneHref || '+61753707933'
const textDisplay = biz?.textDisplay || '0422 624 920'
const textHref = biz?.textHref || '0422624920'
const emailOffice = biz?.emailOffice || 'sales@seqcampers.com.au'
const addressStreet = biz?.addressStreet || '3B/6 Bonanza Court'
const addressSuburb = biz?.addressSuburb || 'Marcoola'
const addressState = biz?.addressState || 'QLD'
const addressPostcode = biz?.addressPostcode || '4564'
const showroomHours = biz?.showroomHours || 'Mon - Fri: 8:30am - 3pm\nSaturday: 8:30am - 12:30pm\nSunday: Closed'
const youtubeUrl = biz?.youtubeUrl || 'https://www.youtube.com/@seqcampers9450?sub_confirmation=1'
// Contact-bar map link + short location label (kept as literals - they are
// display sugar, not the canonical address which lives in the fields above).
const cbMapQuery = biz?.mapQuery || '6 Bonanza Court Marcoola QLD 4564'
const cbMapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(cbMapQuery)}`
// Showroom hours as {label, value} rows for the footer. Splits each non-empty
// line on the first colon; lines without a colon render as a single value.
const showroomHoursRows = String(showroomHours)
  .split('\n')
  .map((l) => l.trim())
  .filter(Boolean)
  .map((line) => {
    const idx = line.indexOf(':')
    if (idx === -1) return { label: '', value: line }
    return { label: line.slice(0, idx).trim(), value: line.slice(idx + 1).trim() }
  })

// Build canonical + absolute OG image URLs from site base
const siteBase = Astro.site ?? new URL('https://seqcampers.com.au')
const canonicalUrl = new URL(pathname, siteBase).href
const absoluteOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBase).href)
  : null

const fullTitle = title.includes('SEQ Campers') ? title : `${title} | SEQ Campers`
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SEQ Campers" />
  <meta property="og:locale" content="en_AU" />
  {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

  <!-- Theme + favicon hooks -->
  <meta name="theme-color" content="#2A1608" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <!-- Google Analytics 4 - tracks page views, events, sessions across every
       page on the site. Per Bart 18 Jun: GA4 property "SEQ Campers Website".
       Measurement ID G-E9QKQRP1X4. Loaded async so it never blocks rendering. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-E9QKQRP1X4"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-E9QKQRP1X4', { anonymize_ip: true });
  </script>

  <slot name="head" />
  <style>
    /* Form thanks panel - HIGH CONTRAST against cream page background so
       users can't miss it. Solid green confirmation block, big tick icon,
       prominent CTA fallbacks. */
    .inline-form-thanks {
      background: linear-gradient(135deg, #2BA85F 0%, #1F8049 100%);
      color: #fff;
      border-radius: 14px;
      padding: 32px 36px;
      margin: 28px 0;
      box-shadow: 0 10px 30px rgba(43, 168, 95, 0.30);
      text-align: center;
      animation: thanks-pop-in 0.4s ease-out;
    }
    @keyframes thanks-pop-in {
      from { opacity: 0; transform: translateY(8px) scale(0.98); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .inline-form-thanks-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      color: #fff;
      margin: 0 auto 14px;
    }
    .inline-form-thanks-title {
      font-family: 'Inter Tight', sans-serif;
      font-size: 1.5rem;
      font-weight: 800;
      color: #fff;
      margin: 0 0 8px;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
    .inline-form-thanks-body {
      color: rgba(255, 255, 255, 0.94);
      font-size: 1.02rem;
      line-height: 1.55;
      max-width: 520px;
      margin: 0 auto 18px;
    }
    .inline-form-thanks-cta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 14px 28px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.22);
    }
    .inline-form-thanks-label {
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.95rem;
      width: 100%;
      margin-bottom: 12px;
      text-align: center;
    }
    .inline-form-thanks-cta a {
      display: inline-block;
      padding: 10px 18px;
      background: #fff;
      color: #1F8049;
      font-weight: 700;
      font-family: 'Inter Tight', sans-serif;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .inline-form-thanks-cta a:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);
    }
    .inline-form-error {
      background: #FDECEA;
      border: 1px solid #E5A6A1;
      border-left: 4px solid #C0341A;
      border-radius: 6px;
      padding: 10px 14px;
      margin-bottom: 14px;
      color: #6F1A0E;
      font-size: 0.92rem;
    }

    /* Show Special banner - thin coloured strip across the very top of every
       page, controlled by Sanity Site Settings. Stays in normal document flow
       so it does not cover the header. Auto-hides when the end date passes. */
    .show-special-banner {
      background: linear-gradient(90deg, #C0341A 0%, #8B2410 100%);
      color: #fff;
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.92rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      padding: 9px 0;
      text-align: center;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
    }
    .show-special-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 14px;
    }
    .show-special-headline { line-height: 1.35; }
    .show-special-cta {
      color: #fff;
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 700;
    }
    .show-special-cta:hover { text-decoration: none; }
    @media (max-width: 560px) {
      .show-special-banner { font-size: 0.85rem; padding: 8px 0; }
      .show-special-inner { gap: 8px; }
    }

    /* Contact utility bar - shown on every page EXCEPT the home page (home
       header overlays the hero, so no bar there). Inner pages use a normal
       sticky header, so this thin strip sits cleanly above it. Items sit on
       the RIGHT, clear of the large left-aligned logo. */
    .contact-bar {
      background: var(--sand-deep, #EBE0CD);
      border-bottom: 1px solid var(--tan-border, #DCCBA8);
      font-family: 'Inter Tight', sans-serif;
      font-size: 0.85rem;
    }
    .contact-bar-inner {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 22px;
      padding: 7px 0;
      flex-wrap: wrap;
    }
    .contact-bar .cb-item {
      color: var(--ink, #2A1608);
      text-decoration: none;
      font-weight: 600;
      white-space: nowrap;
    }
    .contact-bar .cb-item b { color: var(--rust, #C0341A); font-weight: 800; }
    .contact-bar .cb-item:hover b { text-decoration: underline; }
    .contact-bar .cb-loc { color: var(--muted, #8B6A40); }
    @media (max-width: 600px) {
      .contact-bar { font-size: 0.8rem; }
      .contact-bar-inner { justify-content: center; gap: 4px 16px; padding: 6px 12px; }
    }
    /* Site-wide kill switch for browser-native media controls on every
       autoplay video (hero, pathway tiles, broll cards, /quote intro, /service
       team grid, workshop weekly, /new tiles). Per Bart 16 Jun - "remove the
       on-screen play controls" on every preloaded video site-wide. */
    video::-webkit-media-controls,
    video::-webkit-media-controls-panel,
    video::-webkit-media-controls-play-button,
    video::-webkit-media-controls-start-playback-button,
    video::-webkit-media-controls-overlay-play-button,
    video::-webkit-media-controls-enclosure,
    video::-webkit-media-controls-current-time-display,
    video::-webkit-media-controls-time-remaining-display,
    video::-webkit-media-controls-timeline,
    video::-webkit-media-controls-volume-slider,
    video::-webkit-media-controls-mute-button,
    video::-webkit-media-controls-fullscreen-button {
      display: none !important;
      -webkit-appearance: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    /* CROP every autoplay-loop iframe so YouTube's title bar (top ~50px)
       and controls bar (bottom ~50px) are PHYSICALLY OFF-SCREEN inside
       the container. The container clips them via overflow:hidden. The
       iframe is sized 150% taller than the container and offset by -25%
       so only the middle 50% of the iframe shows. The video centre stays
       visible; YouTube's UI is permanently outside the visible window.
       Works regardless of YouTube's controls state. Per Bart 18 Jun -
       "still visible on every fucking page" - 5th iteration. */
    .hero-video-bg,
    .pathway-tile-media,
    .broll-media,
    .new-tile-media,
    .service-video-media,
    .workshop-weekly-media,
    .quote-intro-media,
    .shows-compilation-media {
      overflow: hidden !important;
    }
    .pathway-tile-media iframe,
    .broll-media iframe,
    .new-tile-media iframe,
    .service-video-media iframe,
    .workshop-weekly-media iframe,
    .quote-intro-media iframe {
      position: absolute !important;
      top: -25% !important;
      left: 0 !important;
      width: 100% !important;
      height: 150% !important;
      pointer-events: none !important;
    }

    /* SITE-WIDE VIDEO LOAD-FLASH COVER (4th iteration per Bart 18 Jun).
       The YouTube iframe shows a 1-3s buffer state with its play button +
       title bar before autoplay engages. The pointer-event blocker divs
       (.hero-video-block, .pathway-tile-block, etc) already sit ON TOP of
       every iframe at high z-index. So we just make those blocks START
       opaque and fade their background to transparent over ~3s. They keep
       blocking clicks forever; the visitor only sees the iframe after the
       fade completes.

       Earlier iterations used a ::before pseudo-element layered separately.
       Hit z-index quirks. This is simpler: the block IS the cover.

       Bumped durations conservatively for slow connections:
         - HERO:   poster image, 4s visible (1.5s delay + 2.5s fade)
         - TILES:  sand colour, 3.5s visible (0.5s delay + 3.0s fade) */
    .hero-video-block,
    .pathway-tile-block,
    .broll-block,
    .new-tile-block,
    .service-video-block,
    .workshop-weekly-block {
      background-color: var(--sand, #F4EDE0) !important;
      animation: video-cover-bg-fade-out 3.0s 0.5s ease-out forwards;
    }
    /* Hero - poster image instead of flat colour, longer delay (biggest file). */
    .hero-video-block {
      background: #1a1a1c url('/hero-poster.jpg') center/cover no-repeat !important;
      animation: video-cover-bg-fade-out 2.5s 1.5s ease-out forwards;
    }
    /* /quote intro and /shows compilation video containers don't have a
       block element child. We use ::after on the media container itself. */
    .quote-intro-media,
    .shows-compilation-media {
      position: relative;
    }
    .quote-intro-media::after,
    .shows-compilation-media::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 6;
      background: var(--sand, #F4EDE0);
      pointer-events: none;
      animation: video-cover-fade-out 3.0s 0.5s ease-out forwards;
    }
    @keyframes video-cover-bg-fade-out {
      0%   { background-color: var(--sand, #F4EDE0); }
      99%  { background-color: rgba(244, 237, 224, 0); }
      100% { background: transparent !important; }
    }
    @keyframes video-cover-fade-out {
      0%   { opacity: 1; visibility: visible; }
      99%  { opacity: 0; visibility: visible; }
      100% { opacity: 0; visibility: hidden; }
    }
  </style>

  <!-- Site-wide media-session blockade. Chrome's "Global Media Controls"
       attach Media Session handlers WHEN a video starts playing (not before),
       so a one-shot clear races and loses. We clear repeatedly for the first
       30 seconds + on every play/playing event + on tab focus/visibility
       change. Applies to every page via the layout. -->
  <script is:inline>
    (function () {
      function nuke() {
        try {
          if ('mediaSession' in navigator) {
            ['play', 'pause', 'seekbackward', 'seekforward', 'previoustrack', 'nexttrack', 'stop', 'seekto', 'skipad'].forEach(function (action) {
              try { navigator.mediaSession.setActionHandler(action, null) } catch (e) {}
            })
            try { navigator.mediaSession.metadata = null } catch (e) {}
            try { navigator.mediaSession.playbackState = 'none' } catch (e) {}
          }
        } catch (e) { /* no-op */ }
      }
      nuke()
      document.addEventListener('DOMContentLoaded', nuke)
      window.addEventListener('load', nuke)

      var ticks = 0
      var iv = setInterval(function () {
        nuke()
        ticks++
        if (ticks > 60) clearInterval(iv) // 30 seconds
      }, 500)

      function bindAllVideos() {
        Array.prototype.forEach.call(document.querySelectorAll('video'), function (v) {
          if (v.dataset.nukeBound === '1') return
          v.dataset.nukeBound = '1'
          v.removeAttribute('controls')
          v.controls = false
          try { v.disablePictureInPicture = true } catch (e) {}
          ;['play', 'playing', 'pause', 'loadedmetadata', 'loadeddata', 'canplay'].forEach(function (ev) {
            v.addEventListener(ev, function () { v.controls = false; nuke() })
          })
        })
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindAllVideos)
      } else {
        bindAllVideos()
      }
      // Re-scan after dynamic content (e.g. lazy-loaded sections) injects new <video>
      function attachObserver() {
        try {
          if (!document.body) return
          new MutationObserver(function () { bindAllVideos() }).observe(document.body, { childList: true, subtree: true })
        } catch (e) { /* no-op */ }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachObserver)
      } else {
        attachObserver()
      }

      document.addEventListener('visibilitychange', nuke)
      window.addEventListener('focus', nuke)
    })()
  </script>

  <!-- Site-wide form page-tracker. Every Netlify form on the site gets two
       hidden fields appended at runtime: source_page_url + source_page_title.
       Means the Netlify Forms dashboard (and the email notifications) show
       EXACTLY which page each submission came from - essential for forms
       like used-caravan-enquiry (10+ caravan pages share one form name) and
       build-page-lead-capture/quote-request (7 model pages share). Per
       Bart 18 Jun. -->
  <script is:inline>
    (function () {
      function attachPageTracking() {
        document.querySelectorAll('form[data-netlify="true"]').forEach(function (form) {
          if (form.dataset.pageTrackingBound === '1') return
          form.dataset.pageTrackingBound = '1'
          // source_page_url - the live URL the visitor is on
          if (!form.querySelector('input[name="source_page_url"]')) {
            var urlField = document.createElement('input')
            urlField.type = 'hidden'
            urlField.name = 'source_page_url'
            urlField.value = window.location.href
            form.appendChild(urlField)
          }
          // source_page_title - the document title (helps Maud match in the dashboard)
          if (!form.querySelector('input[name="source_page_title"]')) {
            var titleField = document.createElement('input')
            titleField.type = 'hidden'
            titleField.name = 'source_page_title'
            titleField.value = document.title || ''
            form.appendChild(titleField)
          }
        })
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachPageTracking)
      } else {
        attachPageTracking()
      }
    })()
  </script>
</head>
<body data-home={isHome ? 'true' : 'false'}>
  {!isHome && (
    <div class="contact-bar">
      <div class="container contact-bar-inner">
        <a class="cb-item cb-loc" href={cbMapHref} target="_blank" rel="noopener">Campers @ {addressSuburb} &middot; {addressStreet}</a>
        <a class="cb-item" href={`tel:${phoneHref}`}>Call <b>{phoneDisplay}</b></a>
        <a class="cb-item" href={`sms:${textHref}`}>Text <b>{textDisplay}</b></a>
      </div>
    </div>
  )}
  {showSpecial && (
    <div class="show-special-banner" role="region" aria-label="Show special">
      <div class="container show-special-inner">
        <span class="show-special-headline">{showSpecial.headline}</span>
        {showSpecial.ctaUrl && showSpecial.ctaText && (
          <a href={showSpecial.ctaUrl} class="show-special-cta">{showSpecial.ctaText} →</a>
        )}
      </div>
    </div>
  )}

  <header class={`site-header ${isHome ? 'site-header-overlay' : ''} ${showSpecial ? 'site-header-has-banner' : ''}`}>
    <div class="container">
      <a href="/" class="logo" aria-label="SEQ Campers home">
        <img src="/seq-logo-new.png" alt="SEQ Campers - Campers There & Back" width="600" height="338" />
      </a>

      <button
        class="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="primary-nav"
        type="button"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <nav id="primary-nav">
        <a href="/new" class={isActive('/new') ? 'is-active' : ''}>New</a>
        <a href="/stock" class={isActive('/stock') ? 'is-active' : ''}>Stock</a>
        <a href="/accessories" class={isActive('/accessories') ? 'is-active' : ''}>Accessories</a>
        <a href="/videos" class={isActive('/videos') ? 'is-active' : ''}>Videos</a>
        <a href="/service" class={isActive('/service') ? 'is-active' : ''}>Service</a>
        <a href="/shows" class={isActive('/shows') || isActive('/brisbane-show-2026') ? 'is-active' : ''}>Shows</a>
        <a href="/reserve" class={`nav-cta ${isActive('/reserve') ? 'is-active' : ''}`}>Reserve your slot</a>
      </nav>
    </div>
  </header>

  <script is:inline>
    /* Inline form submission for every Netlify form on the site. Stops the
       browser navigating away to the ugly default Netlify thanks page.
       POSTs via fetch + shows an in-place success message.

       CRITICAL: target forms by their hidden form-name input, NOT by the
       data-netlify attribute. Netlify's HTML post-processor STRIPS the
       data-netlify and netlify-honeypot attributes from deployed HTML
       after detecting forms at build time. Selecting on data-netlify
       works in `npm run dev` but matches NOTHING in production. */
    function bindNetlifyAjaxForms() {
      const formNameInputs = document.querySelectorAll('input[name="form-name"]')
      const forms = []
      formNameInputs.forEach(function (input) {
        const f = input.closest('form')
        if (f && forms.indexOf(f) === -1) forms.push(f)
      })
      forms.forEach(function (form) {
        if (form.dataset.ajaxBound) return
        form.dataset.ajaxBound = '1'
        form.addEventListener('submit', async function (e) {
          e.preventDefault()
          const submitBtn = form.querySelector('button[type="submit"], input[type="submit"]')
          if (submitBtn) {
            submitBtn.disabled = true
            submitBtn.dataset.originalText = submitBtn.textContent
            submitBtn.textContent = 'Sending...'
          }
          try {
            const data = new FormData(form)
            // Force-set source_page tracking AT SUBMIT TIME so timing issues
            // (cache, DOMContentLoaded race) can't leave these blank. Per
            // Bart 18 Jun - previous JS-only approach left fields empty
            // on his test. FormData.set replaces if present, adds if not.
            data.set('source_page_url', window.location.href)
            data.set('source_page_title', document.title || '')
            const body = new URLSearchParams()
            for (const [k, v] of data.entries()) body.append(k, String(v))
            const res = await fetch('/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: body.toString(),
            })
            if (!res.ok && res.status !== 0) throw new Error('Submit failed ' + res.status)
            const thanks = document.createElement('div')
            thanks.className = 'inline-form-thanks'
            thanks.setAttribute('role', 'status')
            thanks.innerHTML =
              '<div class="inline-form-thanks-icon" aria-hidden="true">' +
              '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>' +
              '</div>' +
              '<h2 class="inline-form-thanks-title">Thanks! Your message is on its way.</h2>' +
              '<p class="inline-form-thanks-body">We\'ll come back to you shortly with the next step. Most enquiries get a reply same day.</p>' +
              '<div class="inline-form-thanks-cta" style="flex-direction:column; gap:14px;">' +
              '<span class="inline-form-thanks-label" style="margin-bottom:0; font-size:1rem;">Need us sooner?</span>' +
              '<div style="display:flex; flex-wrap:wrap; justify-content:center; gap:14px 32px;">' +
              '<a href="tel:0753707933">Call (07) 5370 7933</a>' +
              '<a href="sms:0422624920">Text 0422 624 920</a>' +
              '</div>' +
              '</div>'
            /* Replace the WHOLE enquiry section so the "Let\'s make sure
               this van is right for you" heading + subheading + form all
               disappear together. Walk up to the nearest enquiry wrapper,
               fall back to the form\'s direct parent. */
            const container = form.closest('.listing-enquiry-inner, .enquiry-form-wrap') || form.parentNode
            Array.from(container.children).forEach(function (child) {
              child.style.display = 'none'
            })
            container.appendChild(thanks)
            thanks.scrollIntoView({ behavior: 'smooth', block: 'center' })
          } catch (err) {
            console.error('Form submission error:', err)
            if (submitBtn) {
              submitBtn.disabled = false
              submitBtn.textContent = submitBtn.dataset.originalText || 'Send'
            }
            const errBox = form.querySelector('.inline-form-error') || (function () {
              const el = document.createElement('div')
              el.className = 'inline-form-error'
              form.insertBefore(el, form.firstChild)
              return el
            })()
            errBox.textContent = 'Something went wrong - please try again, or call (07) 5370 7933.'
          }
        })
      })
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindNetlifyAjaxForms)
    } else {
      bindNetlifyAjaxForms()
    }

    (function () {
      const btn = document.querySelector('.nav-toggle')
      const nav = document.getElementById('primary-nav')
      if (!btn || !nav) return
      btn.addEventListener('click', function () {
        const open = nav.classList.toggle('is-open')
        btn.setAttribute('aria-expanded', open ? 'true' : 'false')
        document.body.style.overflow = open ? 'hidden' : ''
      })
      // Close nav when any link is clicked (mobile flow)
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav.classList.remove('is-open')
          btn.setAttribute('aria-expanded', 'false')
          document.body.style.overflow = ''
        })
      })

      // Home page only: toggle .is-scrolled on the header once past the hero
      const header = document.querySelector('.site-header-overlay')
      if (header) {
        const threshold = 80
        const onScroll = () => {
          if (window.scrollY > threshold) header.classList.add('is-scrolled')
          else header.classList.remove('is-scrolled')
        }
        onScroll()
        window.addEventListener('scroll', onScroll, { passive: true })
      }
    })()
  </script>

  <main>
    <slot />
  </main>

  {!isHome && (
    <TrustStrip variant="bottom" />
  )}

